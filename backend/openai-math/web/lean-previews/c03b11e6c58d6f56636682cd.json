ComparisonClass (U M w) (fun _ _ => 0) ∧\n        IsMaterialFlow (U M w) (X M w) ∧\n        ((∃ t : ℝ, 0 ≤ t ∧ X M w t fixedLabel ∈ observer) ↔ Halts M w) ∧\n        ∀ ν : ℝ, 0 < ν →\n          let f := affineForce (f₀ M w) (f₁ M w) ν\n          ZeroDataSolution ν f (U M w) (fun _ _ => 0) ∧\n          Smooth f ∧ BoundedMixed f ∧ PeriodicAfterOne f ∧\n          UniqueInComparison ν f (U M w) ∧\n          (ComputableReal ν → EffectiveFieldIn ∅ f) ∧\n          (∀ name : ℕ → ℚ, RealName name ν → EffectiveFieldIn {nameOracle name} f)"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:fda4c3462963b650c538e2177794811eb1c221b267efea4b091fd6e397533f81","id":"l:BalancedThreeStack","kind":"lean-preview","omissions":[],"pairings":{"f:376":{"alternatives":["pair:3cdbd27a9023c36df0be8358","pair:beb9361fe7714c86e907dba3","pair:09d2e23e7a8cb27544bb7b49","pair:19fae05fd22ad85c5177990a","pair:93ad75407dee87b2c786cd89"],"evidence":["pair:8462bf5232776a297405bad8"],"method":"source-aware-lean-words","reason":"Source-text navigation candidate; correspondence is unreviewed.","review_state":"unreviewed","source_associations":[],"source_text_candidate":{"adapted_from":"scripts/build_site.py::lean_pairing@f047bac96ee80ebef0b4f5a403831b84de6e32c1","alternatives":[{"headline":true,"lean_score":32.771,"lean_terms":["balanced","stack","coefficients","three","field","comparison","repeated","real","data","compact","realization","support","computable","periodic","spatial","input","solution","machine","effective","pressure","velocity","finite","mixed","one","halts","bounded","force","zero"],"main":false,"matched_terms":["balanced","stack","coefficients","three","field","comparison","repeated","real","data","compact","realization","support","computable","periodic","spatial","input","solution","machine","effective","pressure","velocity","finite","mixed","one","halts","bounded","force","zero","nu","derivatives"],"note_terms":["nu","derivatives"],"paper":"Incompressible-Box-Transport