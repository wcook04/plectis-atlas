oOutput hn (Sum.inl i)) =\n        pderiv (blocksToAmbient hn (Sum.inl i)))"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:fda4c3462963b650c538e2177794811eb1c221b267efea4b091fd6e397533f81","id":"l:CommutingDerivations","kind":"lean-preview","omissions":[],"pairings":{"f:049":{"alternatives":["pair:c30d1ce97e7804af697ac596","pair:043a126fb9c89a566a88457a","pair:7ff1084f9672b1efa0987606"],"evidence":["pair:ecf36c25e6141d0996fe38c3"],"method":"source-aware-lean-words","reason":"Source-text navigation candidate; correspondence is unreviewed.","review_state":"unreviewed","source_associations":[],"source_text_candidate":{"adapted_from":"scripts/build_site.py::lean_pairing@f047bac96ee80ebef0b4f5a403831b84de6e32c1","alternatives":[{"headline":true,"lean_score":3.255,"lean_terms":["integer","polynomial"],"main":false,"matched_terms":["integer","polynomial","coordinate"],"note_terms":["coordinate"],"paper":"An-explicit-noncoordinate-polynomial-with-affine-three-space-zero-fibre-September-24-2026","score":5.599,"shared_words":3,"target":"r:An-explicit-noncoordinate-polynomial-with-affine-three-space-zero-fibre-September-24-2026:cor:dimension","title_terms":[]},{"headline":false,"lean_score":4.763,"lean_terms":["extends","derivation","locally","nilpotent"],"main":false,"matched_terms":["extends","derivation","locally","nilpotent"],"note_terms":[],"paper":"A-stable-coordinate-that-is-not-a-coordinate-in-four-variables-October-5-2026","score":4.763,"shared_words":4,"target":"r:A-stable-coordinate-that-is-not-a-coordinate-in-four-variables-October-5-2026:prop:lift","title_terms":[]},{"headline":true,"lean_score":3.892,"lean_terms":["algebra"],"main":true,"matched_terms":["algebra","four"],"note_terms":[],"paper":"A-stable-coordinate-that-is-not-a-coordinate-in-four-variables-October-5-2026","score":4.476,"shared_words":2,"target":"r:A-stable-coordinate-that-is-not-a-coordinate-in-four-variables-October-5-2026:thm:main","title_terms":["four"]},{"headline":fal