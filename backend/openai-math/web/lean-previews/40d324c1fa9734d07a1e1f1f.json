orderDeterminant n g →\n        ((r - 1 : ℕ) : ℝ) * ((d - 1 : ℕ) : ℝ) / (4 * Real.exp 1) ≤ (n : ℝ)) ∧\n      (HasExactDeterminant n g →\n        ((r - 1 : ℕ) : ℝ) * ((d - 1 : ℕ) : ℝ) / (4 * Real.exp 1) ≤ (n : ℝ))"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:eb85d3603ec7254e8723f8292d2014fbb295087c537d4a9a7c22689061a82822","id":"l:SmoothInitialForm","kind":"lean-preview","omissions":[],"pairings":{"f:108":{"alternatives":["pair:f076bffe4a6bc78759e69f0e"],"evidence":[],"method":"weighted-lexical-overlap","reason":"Fewer than three distinct source words overlap.","review_state":"unreviewed","source_associations":[],"state":"unavailable","target":null,"targets":[]}},"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","release_id":"openai-math","schema":"statement-map-web/2","source_roles":{"boundary":"The challenge states the task. Solution sources and reported checks are separate; a challenge placeholder is not a proof verdict.","configuration":{"detail":{"path":"lean/40d324c1fa9734d07a1e1f1f.json","pointer":"/row/comparator"},"source":{"file":"lean/ComparatorChallenges/SmoothInitialForm.json","line":null,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"sha256:6c77589c824208da30cb8d8c11416c40df07b39759dc2941c4d318bca7434d7b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/SmoothInitialForm.json"},"state":"available"},"reported_runs":{"path":"lean/40d324c1fa9734d07a1e1f1f.json","pointer":"/reader/runs"},"solution_entry":{"detail":{"path":"lean/40d324c1fa9734d07a1e1f1f.json","pointer":"/row/comparator"},"source":{"file":"lean/OAI/Algebra/Determinantal/InitialForm.lean","line":null,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"sha256:bf5644f526fa5a9338ccc639eed5a1e3ca8d426e12d029e56c71930380ad440b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/OAI/Algebra/Determinantal/InitialForm.lean"},"state":"available"},"solutions":[{"d