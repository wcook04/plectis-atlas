fd0529eeeb/lean/ComparatorChallenges/PolycyclicRecognition.lean#L219"},"text":"theorem main_uniform_bounded_height\n    (R : SimplyConnectedSolvableLieModel) (d : ProperChainMetric R.carrier)\n    {a : ℕ} (T : TriangularAdjoint (GroupLieAlgebra (𝓘(ℝ, R.modelSpace)) R.carrier) a)\n    (huni : ModelIsUnimodular R)\n    {W : Type} [NormedAddCommGroup W] [NormedSpace ℝ W] [FiniteDimensional ℝ W]\n    (q : HeightSpace T.character ≃ₗ[ℝ] W)\n    (Exp : GroupLieAlgebra (𝓘(ℝ, R.modelSpace)) R.carrier → R.carrier)\n    (hExp : IsGroupExponential Exp) (π : R.carrier →* Multiplicative W)\n    (hπExp : ∀ x, (π (Exp x)).toAdd = q (heightProjection T.character x)) :\n    letI := d.compatibleMetric\n    ∃ A : Subgroup (W ≃ₗ[ℝ] W), Set.Finite (A : Set (W ≃ₗ[ℝ] W)) ∧\n      ∀ K C : ℝ, 1 ≤ K → 0 ≤ C → ∃ B : ℝ, 0 ≤ B ∧\n        ∀ F : SelfQuasiIsometry R.carrier K C, ∃ AF : A, ∀ g,\n          ‖(π (F.toFun g)).toAdd - ((π (F.toFun 1)).toAdd + AF.val (π g).toAdd)‖ ≤ B"},{"complete":true,"detail":{"path":"lean/31ad5d09e1937eb35bb256bf.json","pointer":"/reader/selected_statements/2"},"full_source":{"path":"lean/31ad5d09e1937eb35bb256bf.json","pointer":"/challenge/lean"},"name":"OAI.PolycyclicRecognition.lattice_recognition","source":{"file":"lean/ComparatorChallenges/PolycyclicRecognition.lean","line":236,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"c3088158fa7dc55ad4c265ae58a75c2ef61dd04741e18bd0ba2045494e4fa965","statement_sha256":"sha256:dbdb185eb19253cb338ef9ba26107bfcc78e782cf82674574397c524897788f2","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/PolycyclicRecognition.lean#L236"},"text":"theorem lattice_recognition\n    (S : SimplyConnectedSolvableLieModel) (Λ : Subgroup S.carrier)\n    (hΛ : IsFiniteCovolumeLattice Λ)\n    {J : Type} [Group J] [Group.FG J] (e : GroupCoarseEquivalence Λ J) :\n    ∃ Γ : Subgroup J, Γ.FiniteIndex ∧\n      ∃ (R : SimplyConnectedSolvableLieModel) (Δ : Subgroup R.carrier),\n        IsUniformLattice Δ ∧ Nonempty (Γ ≃* Δ)"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:c701139844a2d825c371ded7486924e7dae7de0af77a69dc9c1abaf1129191a1","id":"l:PolycyclicRecognition","kind":"lean-preview","omissions":[],"pairings":{"f:255":{"alternatives":["pair:8ccd95d3ef2f3483eec21b2f"],"contributed_readings":[{"author":{"kind":"agent","name":"Codex source review 2"},"content_sha256":"sha256:4581a6b5ae587f2477ec0e39e329c4fa4e327b6675d670db243fbe31c955ed9e","decision":"linked","detail":{"path":"lean-previews/31ad5d09e1937eb35bb256bf.json","pointer":"/contributions/0"},"provenance":{"identity_assurance":"named local attestation; identity not independently authenticated","kind":"agent-drafted-unreviewed"},"review_state":"unreviewed","targets":[{"declarations":["OAI.PolycyclicRecognition.group_recognition"],"limitations":"The extra lattice realization is not asserted by this anchor alone.","relation":"paper-is-part","target":"r:quasi-isometric-recognition-of-virtually-polycyclic-groups-September-24-2026:thm:recognition"},{"declarations":["OAI.PolycyclicRecognition.lattice_recognition"],"limitations":"The separately configured bounded-height theorem uses an explicit compatible proper chain metric rather than the displayed Riemannian-metric hypothesis; that metric bridge is not certified here.","relation":"same-claim","target":"r:quasi-isometric-recognition-of-virtually-polycyclic-groups-September-24-2026:cor:lattice-recognition"}]}],"evidence":["pair:e602ba47eb8f8f75e7f6a171","pair:83e547bc5a7b834341f744a7"],"method":"contributed-source-reading","reason":"Attributed source reading; inspect each target relation and limitation. No mathematical verification is inferred.","review_state":"unreviewed","source_associations":[],"source_text_candidate":{"adapted_from":"scripts/build_site.py::lean_pairing@f047bac96ee80ebef0b4f5a403831b84de6e32c1","alternatives":[{"headline":true,"lean_score":25.871,"lean_terms":["exponential","metric","norm","real","self"