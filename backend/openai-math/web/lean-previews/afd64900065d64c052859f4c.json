} p n 1 (dimension.{u} p n 1) ∧\n      ((n - 1) / 4) ^ 2 ≤ dimension.{u} p n 1 ∧\n      dimension.{u} p n 1 ≤ n.choose 2) ∧\n    (∀ D : ℝ, 1 ≤ D →\n      Tendsto (fun n : ℕ => Real.log (dimension.{u} p n D : ℝ) / Real.log (n : ℝ))\n        atTop (𝓝 (if 1 < D then 0 else 2)))"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:c701139844a2d825c371ded7486924e7dae7de0af77a69dc9c1abaf1129191a1","id":"l:SubpolynomialLp","kind":"lean-preview","omissions":[],"pairings":{"f:094":{"alternatives":[],"contributed_readings":[{"author":{"kind":"agent","name":"Codex source review 3"},"content_sha256":"sha256:3f7a3c09653f37fd0732fbd611d4aade188c46b79a03e95206749436399bd571","decision":"linked","detail":{"path":"lean-previews/afd64900065d64c052859f4c.json","pointer":"/contributions/0"},"provenance":{"identity_assurance":"named local attestation; identity not independently authenticated","kind":"agent-drafted-unreviewed"},"review_state":"unreviewed","targets":[{"declarations":["OAI.SubpolynomialLp.source_main"],"limitations":"The formal theorem additionally asserts the least dimension has GoodDimension; faithfulness of the universal-space representation is not independently certified.","relation":"same-claim","target":"r:Subpolynomial-dimension-reduction-in-Lp-September-23-2026:thm:main"}]}],"evidence":["pair:0c7ca4c1ef47e45b50f71630"],"method":"contributed-source-reading","reason":"Attributed source reading; inspect each target relation and limitation. No mathematical verification is inferred.","review_state":"unreviewed","source_associations":[],"source_text_candidate":{"adapted_from":"scripts/build_site.py::lean_pairing@f047bac96ee80ebef0b4f5a403831b84de6e32c1","alternatives":[{"headline":true,"lean_score":1.366,"lean_terms":["exp","gamma","integer","log"],"main":true,"matched_terms":["exp","gamma","integer","log","lp","dimension","constant"],"note_terms":["constant"],"paper":"Subpolynomial-dimension-reduction-in-Lp-September-23-2026","score":2.7,"shared_words":