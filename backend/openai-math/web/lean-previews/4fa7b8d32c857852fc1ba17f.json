 ^ (d - 3))),\n          ν (g * Block.embedding e (Pi.mulSingle i h)) ≤\n        4 * (Fintype.card (Equiv.Perm (Fin (2 ^ (d - 3)))) : ℝ) /\n          Fintype.card (Equiv.Perm (Position d))),\n    ‖LinearMap.toContinuousLinearMap (Fourier.integrated ρ (fun g => (ν g : ℂ)))‖ ≤\n      Real.sqrt (32 * C1) * (Module.finrank ℂ E : ℝ) ^ (-5 / 16 : ℝ))"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:eb85d3603ec7254e8723f8292d2014fbb295087c537d4a9a7c22689061a82822","id":"l:ThorpFirstReciprocal","kind":"lean-preview","omissions":[],"pairings":{"f:238":{"alternatives":["pair:253dc210b46a2bf4c4bd9ce6","pair:e4f066016bd25b57199d35a3","pair:6de1b8e829f9c6adb1433e6c","pair:e69934e530951ec7e7499ad0","pair:1dab794e5d360bf521c6ae33","pair:598ed2671993647652947df1","pair:5392b10810e3fb311e187e00","pair:92a7c65c14418714a2f16dbf","pair:bd5e57d9bdd5c3e5df4d5a82","pair:a7fd16a1c928d587f83361db","pair:d01fee47c5edeb2e4b70fa2a","pair:57b48be772dcd0129b1c72f6","pair:1d156a2bc32a81f7d53f1f34","pair:9a29d9822abd0aed7432b88a","pair:5495563c1c3e906be2be5834"],"evidence":["pair:ce58d8fa75d4e50a4d46664f"],"method":"weighted-lexical-overlap","reason":"A lexical navigation candidate, not a reviewed correspondence.","review_state":"unreviewed","source_associations":[],"state":"candidate-pairing","target":"r:Compatibility-entropy-and-the-spectrum-of-a-Thorp-sweep-September-26-2026:cor:intro-consequences","targets":["r:Compatibility-entropy-and-the-spectrum-of-a-Thorp-sweep-September-26-2026:cor:intro-consequences"]}},"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","release_id":"openai-math","schema":"statement-map-web/2","source_roles":{"boundary":"The challenge states the task. Solution sources and reported checks are separate; a challenge placeholder is not a proof verdict.","configuration":{"detail":{"path":"lean/4fa7b8d32c857852fc1ba17f.json","pointer":"/row/comparator"},"source":{"file":"lean/ComparatorChallenges/ThorpFirstReciprocal.json","line":null,"pin":"fd4aeeb2ee4fc72