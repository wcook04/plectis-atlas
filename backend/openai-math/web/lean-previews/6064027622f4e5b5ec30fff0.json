aryEncoding.decodeRawInstance input = none →\n      algorithm.run input = none) ∧\n    (∀ items : RawInstance, ¬ items.Valid →\n      algorithm.run (BinaryEncoding.rawInstanceBits items) = none))"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:eb85d3603ec7254e8723f8292d2014fbb295087c537d4a9a7c22689061a82822","id":"l:BinPackingGap","kind":"lean-preview","omissions":[],"pairings":{"f:118":{"alternatives":["pair:6a2150495bf7721701865882","pair:ee6d561e535b516c4ad35ca8"],"evidence":["pair:e35177d0f2a979360f5f4d00"],"method":"weighted-lexical-overlap","reason":"A lexical navigation candidate, not a reviewed correspondence.","review_state":"unreviewed","source_associations":[],"state":"candidate-pairing","target":"r:Additive-hardness-and-unbounded-configuration-gaps-in-bin-packing-September-24-2026:thm:unbounded-gap","targets":["r:Additive-hardness-and-unbounded-configuration-gaps-in-bin-packing-September-24-2026:thm:unbounded-gap"]}},"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","release_id":"openai-math","schema":"statement-map-web/2","source_roles":{"boundary":"The challenge states the task. Solution sources and reported checks are separate; a challenge placeholder is not a proof verdict.","configuration":{"detail":{"path":"lean/6064027622f4e5b5ec30fff0.json","pointer":"/row/comparator"},"source":{"file":"lean/ComparatorChallenges/BinPackingGap.json","line":null,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"sha256:761527acf4ff186a6765baf5b3f30d7542f75b88865168de59e25e7c360ba941","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/BinPackingGap.json"},"state":"available"},"reported_runs":{"path":"lean/6064027622f4e5b5ec30fff0.json","pointer":"/reader/runs"},"solution_entry":{"detail":{"path":"lean/6064027622f4e5b5ec30fff0.json","pointer":"/row/comparator"},"source":{"file":"lean/OAI/Computability/BinPacking/Main.lean","line":null,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eee