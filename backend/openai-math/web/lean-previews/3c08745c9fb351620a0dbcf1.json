 m)\n    (h : Fin n → ℝ) (I J F : Finset (Fin n))\n    (hIJ : Disjoint I J) (hIF : Disjoint I F) (hJF : Disjoint J F)\n    (i j : KeptVertex F) (hi : i.val ∈ I) (hj : j.val ∈ J)\n    (a τ : Spins n) (mix mix' : Spins n → ℝ)\n    (hmix : ∀ b, 0 ≤ mix b) (hmix' : ∀ b, 0 ≤ mix' b)\n    (hmixsum : ∑ b, mix b = 1) (hmix'sum : ∑ b, mix' b = 1) :\n    Real.exp (-4 * Real.artanh (qZero G I J F i j)) ≤\n        mixtureProb G h I J F a τ mix / mixtureProb G h I J F a τ mix' ∧\n      mixtureProb G h I J F a τ mix / mixtureProb G h I J F a τ mix' ≤\n        Real.exp (4 * Real.artanh (qZero G I J F i j))"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:c701139844a2d825c371ded7486924e7dae7de0af77a69dc9c1abaf1129191a1","id":"l:BufferedIsing","kind":"lean-preview","omissions":[],"pairings":{"f:218":{"alternatives":["pair:bf89e8ecdf5ac5489b0dd3fb"],"contributed_readings":[{"author":{"kind":"agent","name":"Codex source review 1"},"content_sha256":"sha256:b796b842069a1bf0e950dbacc54f4ce7b45c5035851a97142c8f695f0d5db78d","decision":"linked","detail":{"path":"lean-previews/3c08745c9fb351620a0dbcf1.json","pointer":"/contributions/0"},"provenance":{"identity_assurance":"named local attestation; identity not independently authenticated","kind":"agent-drafted-unreviewed"},"review_state":"unreviewed","targets":[{"declarations":["OAI.BufferedIsing.finite_graph_comparison"],"limitations":"Only the finite-graph comparison is linked; planar buffer and continuum consequences elsewhere in the paper are not part of this declaration.","relation":"same-claim","target":"r:Buffered-comparison-and-stopping-band-resolution-in-critical-Ising-September-23-2026:in:comparison"}]}],"evidence":["pair:092efd321792c0f04f1d8689"],"method":"contributed-source-reading","reason":"Attributed source reading; inspect each target relation and limitation. No mathematical verification is inferred.","review_state":"unreviewed","source_associations":[],"source_text_candidate":{"adapted_from":"scripts/bu