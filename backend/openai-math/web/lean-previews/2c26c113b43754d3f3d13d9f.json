tion u t x = 0) ∧\n      EffectiveBounds f ∧ EffectiveBounds u ∧\n      (N = 0 → f = 0 ∧ u = 0)"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:eb85d3603ec7254e8723f8292d2014fbb295087c537d4a9a7c22689061a82822","id":"l:SolenoidalSheetPrograms","kind":"lean-preview","omissions":[],"pairings":{"f:376":{"alternatives":["pair:0d45655098f6d8be81a78679","pair:3cf7839c4aa7509f301d4122","pair:7d69002525b43d13b91dbf5e","pair:db5894fd3300272b56d23aed","pair:4c257b6733f5e4d5961a48e0"],"evidence":["pair:cef86d51ebc3a53dce2a7ec4"],"method":"weighted-lexical-overlap","reason":"A lexical navigation candidate, not a reviewed correspondence.","review_state":"unreviewed","source_associations":[],"state":"candidate-pairing","target":"r:Computation-under-Rapidly-Vanishing-Navier-Stokes-Forcing-September-27-2026:thm:lattice","targets":["r:Computation-under-Rapidly-Vanishing-Navier-Stokes-Forcing-September-27-2026:thm:lattice"]}},"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","release_id":"openai-math","schema":"statement-map-web/2","source_roles":{"boundary":"The challenge states the task. Solution sources and reported checks are separate; a challenge placeholder is not a proof verdict.","configuration":{"detail":{"path":"lean/2c26c113b43754d3f3d13d9f.json","pointer":"/row/comparator"},"source":{"file":"lean/ComparatorChallenges/SolenoidalSheetPrograms.json","line":null,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"sha256:958c716c91919d8d78584e7512bae243d6f304d732a2004ebc49380caf8d883a","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/SolenoidalSheetPrograms.json"},"state":"available"},"reported_runs":{"path":"lean/2c26c113b43754d3f3d13d9f.json","pointer":"/reader/runs"},"solution_entry":{"detail":{"path":"lean/2c26c113b43754d3f3d13d9f.json","pointer":"/row/comparator"},"source":{"file":"lean/OAI/MathematicalPhysics/SheetFlows/SheetProgram.lean","line":null,"pin":"fd4aeeb2ee4fc729c18d98444fe