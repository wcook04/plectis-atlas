c9a5fcc424cd421c0f6","statement_sha256":"sha256:760219529fb18112f8a47776f1d7d6c2bce8b60d0d921ab69c21f16a0708b65f","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/EgyptianFractions.lean#L57"},"text":"theorem main_double_log_order :\n    ∃ c1 c2 : ℝ, 0 < c1 ∧ 0 < c2 ∧ ∃ b0 : ℕ,\n  ∀ b : ℕ, b0 ≤ b →\n    c1 * Real.log (Real.log (b : ℝ)) ≤ (maxEgyptianLength b : ℝ) ∧\n    (maxEgyptianLength b : ℝ) ≤ c2 * Real.log (Real.log (b : ℝ))"},{"complete":true,"detail":{"path":"lean/a0c752e3bea6a77e7e4169ab.json","pointer":"/reader/selected_statements/2"},"full_source":{"path":"lean/a0c752e3bea6a77e7e4169ab.json","pointer":"/challenge/lean"},"name":"OAI.Problem337.one_expansions_finite_and_bounded","source":{"file":"lean/ComparatorChallenges/EgyptianFractions.lean","line":64,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"e96f5967735c7f7af64fc306601a5280d20f5752799e8c9a5fcc424cd421c0f6","statement_sha256":"sha256:2f53ddd7943316579c454815af11cb5ad4c3e6f9c291ac537e31a2ab7c19be42","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/EgyptianFractions.lean#L64"},"text":"theorem one_expansions_finite_and_bounded :\n    (∀ k : ℕ, Set.Finite (OneExpansions k) ∧\n    F k ≤ k ^ (2 ^ k - 1)) ∧\n  (∀ k : ℕ, ∀ n : Fin k → ℕ, IsOneExpansion n →\n    ∀ i : Fin k, n i ≤ k ^ (2 ^ i.val))"},{"complete":true,"detail":{"path":"lean/a0c752e3bea6a77e7e4169ab.json","pointer":"/reader/selected_statements/3"},"full_source":{"path":"lean/a0c752e3bea6a77e7e4169ab.json","pointer":"/challenge/lean"},"name":"OAI.Problem337.counting_double_log_order","source":{"file":"lean/ComparatorChallenges/EgyptianFractions.lean","line":71,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"e96f5967735c7f7af64fc306601a5280d20f5752799e8c9a5fcc424cd421c0f6","statement_sha256":"sha256:d9257166c77ae4f195b890bebe484c219c4fa2ada12352bcbb2b80621288482b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/EgyptianFractions.lean#L71"},"text":"theorem counting_double_log_order :\n    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∃ k0 : ℕ,\n  ∀ k : ℕ, k0 ≤ k →\n    c * (k : ℝ) ≤ Real.log (Real.log (F k : ℝ)) ∧\n    Real.log (Real.log (F k : ℝ)) ≤ C * (k : ℝ)"},{"complete":true,"detail":{"path":"lean/a0c752e3bea6a77e7e4169ab.json","pointer":"/reader/selected_statements/4"},"full_source":{"path":"lean/a0c752e3bea6a77e7e4169ab.json","pointer":"/challenge/lean"},"name":"OAI.Problem337.exact_marker_padding","source":{"file":"lean/ComparatorChallenges/EgyptianFractions.lean","line":78,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"e96f5967735c7f7af64fc306601a5280d20f5752799e8c9a5fcc424cd421c0f6","statement_sha256":"sha256:d74b9f6411d25021059e8ec239904fc071ef58b01624bd1aabd4f851800a1e0e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/EgyptianFractions.lean#L78"},"text":"theorem exact_marker_padding :\n    ∀ r : ℕ, 3 ≤ r → ∀ n : Fin r → ℕ, IsOneExpansion n →\n  ∀ m : ℕ, (∃ i : Fin r, n i = m) →\n    ∃ n' : Fin (r + 1) → ℕ,\n      IsOneExpansion n' ∧ ∃ i : Fin (r + 1), n' i = m"},{"complete":true,"detail":{"path":"lean/a0c752e3bea6a77e7e4169ab.json","pointer":"/reader/selected_statements/5"},"full_source":{"path":"lean/a0c752e3bea6a77e7e4169ab.json","pointer":"/challenge/lean"},"name":"OAI.Problem337.every_exact_marker_occurs","source":{"file":"lean/ComparatorChallenges/EgyptianFractions.lean","line":85,"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","sha256":"e96f5967735c7f7af64fc306601a5280d20f5752799e8c9a5fcc424cd421c0f6","statement_sha256":"sha256:e7f1777bb7f921e44fab99a8b9fa049dde7353d74a95dc2d581abccc2812cbdd","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/EgyptianFractions.lean#L85"},"text":"theorem every_exact_marker_occurs :\n    ∀ m : ℕ, 2 ≤ m → ∃ k : ℕ, m ∈ D k"},{"complete":true,"d