 is matched to the acceptance convention, including whether the initial configuration counts as accepting.","fingerprint":"sha256:1caa7dd034a99e59f901ab7f56f7665965f029c91a82187b8ca0d3d5bbc069a2","general_disclaimer":true,"limitations":"Source-level formulation comparison only; this is not independent verification of the definitions, Lean proof, or manuscript proof.","relation":"same-claim","row_id":"An-exponential-two-way-deterministic-state-lower-bound-for-one-way-liveness-September-25-2026#thm:main","statement_sha256":"sha256:eb64e00eb5b64a862caaf299e568f76ae0348a6a37dea34a2bad550d78edb3f2"}]},"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","provenance":{"identity_assurance":"named local attestation; identity not independently authenticated","kind":"agent-drafted-unreviewed"},"references":["https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/ComparatorChallenges/OneWayLiveness.lean","https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/An-exponential-two-way-deterministic-state-lower-bound-for-one-way-liveness-September-25-2026/build/sections/introduction.tex#L99"],"release_id":"openai-math","review_state":"unreviewed","row_id":"challenge:OneWayLiveness","schema":"statement-map-contribution/1"}],"detail":{"path":"lean/2abc7ca33f5540714e772f2b.json","pointer":""},"formal_statement":{"detail":{"path":"lean/2abc7ca33f5540714e772f2b.json","pointer":"/reader/formal_statement"},"full_source":{"path":"lean/2abc7ca33f5540714e772f2b.json","pointer":"/reader/formal_statement"},"kind":"declaration-signatures","method":"configured-challenge-declaration-signatures","name_resolution":"source-text","snippets":[{"complete":true,"detail":{"path":"lean/2abc7ca33f5540714e772f2b.json","pointer":"/reader/selected_statements/0"},"full_source":{"path":"lean/2abc7ca33f5540714e772f2b.json","pointer":"/challenge/lean"},"name":"OAI.OneWayLiveness.main_theorem","source":{"file":"lean/ComparatorChallenges/OneWayLiveness.lean","