j) (hk : ∀ i j, 0 < k i j)\n    (ha : Pairwise fun i j => Disjoint (solidBox (a i) (h i)) (solidBox (a j) (h j)))\n    (hb : Pairwise fun i j => Disjoint (solidBox (b i) (k i)) (solidBox (b j) (k j)))\n    (hvol : ∀ i, ∏ j : Fin 3, k i j / h i j = 1) :\n    ∃ U : Field, ∃ Φ : ℝ → Space → Space,\n      AdmissibleField U ∧ IsGlobalFlow U Φ ∧ Delivers a b h k Φ"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:c701139844a2d825c371ded7486924e7dae7de0af77a69dc9c1abaf1129191a1","id":"l:BalancedBoxRouting","kind":"lean-preview","omissions":[],"pairings":{"f:376":{"alternatives":["pair:9afe0d4eb670c8ed36963825","pair:5c530ed6bddab9eaf1057557","pair:0b775897d4d91f6b8fddfa62","pair:8baee459c5f39a6068e7b917","pair:5d93ad4e469941edc9e85d92","pair:c38c48447c900bfc3ee08b1a"],"contributed_readings":[{"author":{"kind":"agent","name":"Codex source review 2"},"content_sha256":"sha256:1b6503dec5f6ac4f684b5b4c63a1700c6970b9621a05fc9c5377b01adbda546e","decision":"linked","detail":{"path":"lean-previews/af9ae4e00b41f3ddd97f3d23.json","pointer":"/contributions/0"},"provenance":{"identity_assurance":"named local attestation; identity not independently authenticated","kind":"agent-drafted-unreviewed"},"review_state":"unreviewed","targets":[{"declarations":["OAI.BoxTransport.Routing.balanced_box_routing"],"limitations":"No source-target disjointness is assumed, and no computation or Navier-Stokes force is asserted at this routing stage.","relation":"same-claim","target":"r:Incompressible-Box-Transport-and-Finite-Computation-October-6-2026:lem:bb-balanced-box-routing"}]}],"evidence":["pair:7c0ad6609e6772d35e8e8d90"],"method":"contributed-source-reading","reason":"Attributed source reading; inspect each target relation and limitation. No mathematical verification is inferred.","review_state":"unreviewed","source_associations":[],"source_text_candidate":{"adapted_from":"scripts/build_site.py::lean_pairing@f047bac96ee80ebef0b4f5a403831b84de6e32c1","alternatives":[{"headline":