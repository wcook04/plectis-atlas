jective (ell : ℕ) [Fact ell.Prime]\n    (k K l L : Type*) [Field k] [Field K] [Field l] [Field L]\n    [IsAlgClosed k] [IsAlgClosed l] [Algebra k K] [Algebra l L]\n    [Algebra.EssFiniteType k K] [Algebra.EssFiniteType l L]\n    (hk : (ell : k) ≠ 0) (hl : (ell : l) ≠ 0)\n    (hK : 2 ≤ Algebra.trdeg k K) (hL : 2 ≤ Algebra.trdeg l L) :\n    ∀ (a a' : IsomF k K l L) (b : IsomCUnits ell K L),\n      PhiGraph a b → PhiGraph a' b → a = a'"}],"state":"available","unresolved_names":[]},"generation_id":"sha256:c701139844a2d825c371ded7486924e7dae7de0af77a69dc9c1abaf1129191a1","id":"l:BogomolovPopInjectivity","kind":"lean-preview","omissions":[],"pairings":{"f:009":{"alternatives":[],"contributed_readings":[{"author":{"kind":"agent","name":"Codex source review 1"},"content_sha256":"sha256:18590d993a8764ada93fb7ef511ecc42fe0027dee444aa2148df079937943a5f","decision":"linked","detail":{"path":"lean-previews/f5b61b82c3fc5ede25e5d591.json","pointer":"/contributions/0"},"provenance":{"identity_assurance":"named local attestation; identity not independently authenticated","kind":"agent-drafted-unreviewed"},"review_state":"unreviewed","targets":[{"declarations":["OAI.BogomolovPop.main_graph_injective"],"limitations":"No surjectivity or existence of a related group isomorphism is supplied by this configured theorem; no proof certification is inferred.","relation":"formal-is-part","target":"r:The-Bogomolov-Pop-reconstruction-theorem-September-23-2026:thm:main"}]}],"evidence":["pair:fcd1816f0245e811a3125c2a"],"method":"contributed-source-reading","reason":"Attributed source reading; inspect each target relation and limitation. No mathematical verification is inferred.","review_state":"unreviewed","source_associations":[],"source_text_candidate":{"adapted_from":"scripts/build_site.py::lean_pairing@f047bac96ee80ebef0b4f5a403831b84de6e32c1","alternatives":[{"headline":true,"lean_score":11.777,"lean_terms":["isom","pi","phi","trdeg","ell","closed","fields"],"main":true,"matched_terms":["isom