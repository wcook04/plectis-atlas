e supremum over those strategies."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:05a6d8a960a550dfb3c29cf5ccddaf9062aa6f4d09131446271802335f1bb89b","grain":"paper-statement","id":"Threshold-parallel-repetition-for-finite-dimensional-entangled-games-September-25-2026#prop:conditioning-to-tail","title":"Conditioning-to-threshold transfer"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/2f90f0d6201b457c8fc4cca2.json","pointer":"/row"},"display":"Proposition","id":"r:Threshold-parallel-repetition-for-finite-dimensional-entangled-games-September-25-2026:prop:conditioning-to-tail","manuscript_id":"p:Threshold-parallel-repetition-for-finite-dimensional-entangled-games-September-25-2026","name":"Conditioning-to-threshold transfer","printed_number":"2.3","printed_number_provenance":{"atlas_pin":"8056826bbd00caea871ad036bd295182e2bef3e2","binding":{"file":"build/sections/04-threshold.tex","label":"prop:conditioning-to-tail","line":82,"manuscript":"Threshold-parallel-repetition-for-finite-dimensional-entangled-games-September-25-2026","statement_sha256":"c5d42b70d620611654bc9156c845a0ef2e7d35dbc1bccc61a798319640783db5"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"8056826bbd00caea871ad036bd295182e2bef3e2","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Threshold-parallel-repetition-for-finite-dimensional-entangled-games-September-25-2026.html#prop:conditioning-to-tail","section":2,"section_title":"From conditioning to a threshold bound","source":{"current_hash_method":"tex-enviro