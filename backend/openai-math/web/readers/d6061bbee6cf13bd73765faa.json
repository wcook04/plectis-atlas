tice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"papers/b832cc3928aa66d9688181ec.json","pointer":"/manuscript"},"id":"p:The-Sharp-Terminal-Leave-in-Random-Triangle-Removal-September-25-2026","name":"The sharp terminal leave in random triangle removal","status":"current"}],"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","producer_scope":{"credit":{"kind":"attributed-catalogue-extraction","license":"Apache-2.0","name":"Will Cook, OpenAI Math Atlas; source manuscripts and Lean quotations credited to OpenAI.","pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","producer_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","producer_repository":"https://github.com/openai/math","sha256":"sha256:2e3a4906ab7653c99a46c607859def831d9e3969ef851f7776724059fc61e4d0","source":"data/families.json"},"state":"producer-declared","value":{"rows":[{"label":"Sharp terminal edge count in random triangle removal","statements":["TriangleRemoval"]}],"scope":"Start with the complete graph on $n$ vertices and repeatedly delete the three edges of a uniformly chosen remaining triangle. The formalization proves that the number of edges at termination, divided by $n^{3/2}$, converges in $L^2$ to $1/(2\\sqrt2)$. It also states convergence in probability and convergence of the normalized expectation to the same constant. This is the triangle case of the sharp terminal-leave conjecture of Joos and Kühn.","title":"The sharp terminal leave in random triangle removal","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/docs/188.md"}},"provenance":{"kind":"computed-navigation","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","rule":"Projection of the pinned ledger; no new mathematical assessment."},"reader_comparison":{"headline_coverage":"agree","method":"Compare reported scope catego