-pairing","scope_context":"family-readings"},"source_associations":[],"statements":[{"appendix":false,"contribution_target":{"fingerprint":"sha256:89d138698ae82d14a5c82a65ca935b76e0ba98e4bd8364ca5e9cae4a948f3e69","grain":"paper-statement","id":"Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026#thm:main","title":"thm:main"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/975fda9d23f1fcf75693d51a.json","pointer":"/row"},"display":"Theorem","id":"r:Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026:thm:main","manuscript_id":"p:Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026","name":"thm:main","printed_number":"1.1","printed_number_provenance":{"atlas_pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","binding":{"file":"build/sections/introduction.tex","label":"thm:main","line":31,"manuscript":"Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026","statement_sha256":"df86ad93518557be74e01ac05a91d250f6b8a7af08dff03fa8cf8f1ac9f01d6a"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:3c8fca99528c73db4edee971c071cb0d8c4e598950f21b88d1a423eda6c2c5de","file":"preprints/Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026/build/sections/introduction.tex","line":31,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"df86ad93518557be74e01ac05a91d250f6b8a7af08dff03fa8cf8f1ac9f01d6a","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:3c8fca99528c73db4edee971c071cb0d8c4e598950f21b88d1a423eda6c2c5de","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026/build/sections/introduction.tex#L31"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $\\Omega\\subset\\R^3$ be any bounded connected domain with\n$C^\\infty$ boundary. For $j=1,2$, let\n$\\lambda_j,\\mu_j\\in C^\\infty(\\overline\\Omega;\\R)$ satisfy\n$\\mu_j>0$ and $3\\lambda_j+2\\mu_j>0$ on $\\overline\\Omega$.\nIf\n\\[\n \\Lambda_{\\lambda_1,\\mu_1}\n =\\Lambda_{\\lambda_2,\\mu_2}\n \\colon H^{1/2}(\\partial\\Omega;\\R^3)\n       \\longrightarrow H^{-1/2}(\\partial\\Omega;\\R^3),\n\\]\nthen $\\lambda_1=\\lambda_2$ and $\\mu_1=\\mu_2$ throughout $\\Omega$."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:f17c2ff00a9174c8c01169a98d02d4908d3b546d8eda1fb90ed375f05b4eb22e","grain":"paper-statement","id":"Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026#prop:physical-transfer","title":"Transfer of physical solutions"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"..