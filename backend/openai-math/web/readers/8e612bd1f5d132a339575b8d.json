x.json#/sources"},"detail":{"path":"papers/ee18bda66515cf5c20fd1f2e.json","pointer":"/manuscript"},"id":"p:A-C1-Counterexample-to-the-Entropy-Conjecture-September-25-2026","name":"A C^1 Counterexample to the Entropy Conjecture","status":"current"}],"pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","producer_scope":{"credit":{"kind":"attributed-catalogue-extraction","license":"Apache-2.0","name":"Will Cook, OpenAI Math Atlas; source manuscripts and Lean quotations credited to OpenAI.","pin":"8056826bbd00caea871ad036bd295182e2bef3e2","producer_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","producer_repository":"https://github.com/openai/math","sha256":"sha256:2c90a33675d6e8a37b8ab7c2e2107f358dd73fbc4c74dc1e183c17efa0e16267","source":"data/families.json"},"state":"producer-declared","value":{"rows":[{"label":"A $C^1$ counterexample to the entropy conjecture","statements":["C1EntropyCounterexample"]}],"scope":"Shub's entropy conjecture predicts that a smooth self-map's topological entropy is at least the logarithm of the spectral radius of its action on real homology. The formalization gives a counterexample to the general $C^1$ self-map version: a noninvertible $C^1$ map on a compact smooth manifold without boundary has topological entropy zero, while its action on second real homology has a nonzero eigenvector with eigenvalue $2$. Thus the homological lower bound is strictly positive and fails for this map.","title":"A <i>C</i><sup>1</sup> counterexample to the entropy conjecture","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/lean/docs/151.md"}},"provenance":{"kind":"computed-navigation","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","rule":"Projection of the pinned ledger; no new mathematical assessment."},"reader_comparison":{"headline_coverage":"agree","method":"Compare reported scope categories; notes remain attributed and are not adjudicated.","points":[{"definitions_to_check":