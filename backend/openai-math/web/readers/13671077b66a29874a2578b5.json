67","kind":"reading-page-computed","pdf_verified":false,"pin":"c0851ae4ba3e12b1170cd4cdae33b48fae15d9a0","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026.html#cor:characteristic-zero","section":6,"section_title":"Completion and consequences","source":{"current_hash_method":"tex-environment-body-comments-removed","file":"preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex","line":35,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"40782f5a35c8cf96a13991b8e2eb033f44ddaa858ca1c2465260c8818ac62d41","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex"},"sha256":"sha256:46c8b058864340c20912c67532f441dd6d05c0255a7e17c70567b55a43b735cf","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex#L35"},"statement_kind":"corollary","text":"\\label{cor:characteristic-zero}\nThere is an absolute integer $n_0$ such that, for every field $K$ of\ncharacteristic zero and every $n\\ge n_0$, every syntactically homogeneous\n$\\Sigma\\Pi\\Sigma\\Pi\\Sigma$ circuit over $K$ computing $\\IMM_{n,n}$\nhas at least $n^{\\sqrt n/400}$ gates.  Bottom fan-in and bottom support\nare unrestricted."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:09f49941f70e80d046423373d36553a11bbcbc8a804a19088faa02cd72145a66","grain":"paper-statement","id":"Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026#prop:upper"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/28bbb9533fbca0ce119e0afb.json","pointer":"/row"},"display":"Proposition","id":"r:Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026:prop:upper","manuscript_id":"p:Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026","name":"prop:upper","printed_number":"6.2","printed_number_provenance":{"atlas_pin":"c0851ae4ba3e12b1170cd4cdae33b48fae15d9a0","binding":{"file":"build/sections/06-completion.tex","label":"prop:upper","line":69,"manuscript":"Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026","statement_sha256":"bd572b65b9d1b3c3d578b6ff54204aa1d1ec4d540b45ec9e9a94e62a05c6584e"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"c0851ae4ba3e12b1170cd4cdae33b48fae15d9a0","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026.html#prop:upper","section":6,"section_title":"Completion and consequences","source":{"current_hash_method":"tex-environment-body-comments-removed","file":"preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex","line":69,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"bd572b65b9d1b3c3d578b6ff54204aa1d1ec4d540b45ec9e9a94e62a05c6584e","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex"},"sha256":"sha256:6195a0bdcd4f774dbf24c0ef4be8a05715a9c940c8fd0937bc828cd15bd4db78","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex#L69"},"statement_kind":"proposition","text":"\\label{prop:upper}\nLet $K$ be any field and $n\\ge2$.  Put\n\\[\n t=\\lceil\\sqrt n\\rceil,\n \\qquad r=\\left\\lceil\\frac nt\\right\\rceil.\n\\]\nThere is a syntactically homogeneous\n$\\Sigma\\Pi\\Sigma\\Pi\\Sigma$ circuit over $K$ computing $\\IMM_{n,n}$\nwhose number of gates, including leaves, is at most\n\\begin{equation}\n\\label{eq:upper-gate-bound}\n 2n^3+rn^2+rn^{t+1}+n^{r-1}+1\n \\le n^{\\sqrt n+4}.\n\\end{equation}"}],"unavailable_check_reports":[]}
