producer_statement_sha256":"d9221ea648ec6dbcd4abbc67daddecafb4f95958e24b0847e5fbe33e5aff039b","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-cotype-cotype-conjecture-under-the-approximation-property-September-23-2026/build/introduction.tex"},"sha256":"sha256:d65cd788fce582e67ab8fdb449fc5102215869632dbc1d6f3bf6ff2437d26566","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-cotype-cotype-conjecture-under-the-approximation-property-September-23-2026/build/introduction.tex#L43"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet \\(X\\) be a nonzero real Banach space with the ordinary approximation\nproperty. Then \\(X\\) is \\(K\\)-convex if and only if\n\\[\nC_q(X)<\\infty\n\\quad\\hbox{and}\\quad\nC_r(X^*)<\\infty\n\\qquad\\text{for some }q,r\\in[2,\\infty).\n\\]\nThe exponents \\(q\\) and \\(r\\) may differ. The forward implication holds\nfor every real Banach space, without an approximation hypothesis."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:21862082cb06a4b9e5e5978fa6dd89c9baf1535d4bfd8495b8d54356934352bd","grain":"paper-statement","id":"The-cotype-cotype-conjecture-under-the-approximation-property-September-23-2026#cor:uniform-cotype-entropy","title":"Uniform cotype bounds and entropy duality"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/a964d60c83b253c1ba04f503.json","pointer":"/row"},"display":"Corollary","id":"r:The-cotype-cotype-conjecture-under-the-approximation-property-September-23-2026:cor:uniform-cotype-entropy","manuscript_id":"p:The-cotype-cotype-conjecture-under-the-approximation-property-September-23-2026","name":"Uniform cotype bounds and entropy duality","printed_number":"