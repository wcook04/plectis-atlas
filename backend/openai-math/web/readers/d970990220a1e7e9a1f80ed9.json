label{thm:main}\nLet $\\gamma\\in\\mathbb R$ be fixed, and let\n$\\psi:\\mathbb N\\to[0,\\infty)$ be finite-valued. If\n\\begin{equation}\\label{eq:main-divergence}\n  \\sum_{q=1}^{\\infty}\\frac{\\phi(q)}q\\,\\psi(q)=\\infty,\n\\end{equation}\nthen, for Lebesgue-almost every $x\\in\\mathbb R$, the inequality\n\\[\n  \\|qx-\\gamma\\|<\\psi(q)\n\\]\nholds for infinitely many positive integers $q$."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:4da8ebe0f7b6c18865b4871e5c67ac5520c5ee90c242584e91251a3da2ba4506","grain":"paper-statement","id":"The-weak-inhomogeneous-Duffin-Schaeffer-conjecture-September-25-2026#cor:hausdorff","title":"Hausdorff-measure divergence"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/377c8e883ac9a527277261e8.json","pointer":"/row"},"display":"Corollary","id":"r:The-weak-inhomogeneous-Duffin-Schaeffer-conjecture-September-25-2026:cor:hausdorff","manuscript_id":"p:The-weak-inhomogeneous-Duffin-Schaeffer-conjecture-September-25-2026","name":"Hausdorff-measure divergence","printed_number":"1.2","printed_number_provenance":{"atlas_pin":"8056826bbd00caea871ad036bd295182e2bef3e2","binding":{"file":"build/sections/introduction.tex","label":"cor:hausdorff","line":32,"manuscript":"The-weak-inhomogeneous-Duffin-Schaeffer-conjecture-September-25-2026","statement_sha256":"787e14e01a417f85d35ff60b9c3a49fb7e3a265c896e81853081603a666fe123"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"8056826bbd00caea871ad036bd295182e2bef3e2","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_p