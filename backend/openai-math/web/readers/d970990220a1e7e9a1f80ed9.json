{"capabilities":{"clause_scope":"unavailable","lean_elaboration":"unavailable","pair_scope":"unassessed"},"claim":{"alternatives":[{"matched_terms":["almost","divergence","finite","infinitely","many","valued"],"method":"catalogue-text-overlap","review_state":"unreviewed","score":6,"statement_id":"r:The-weak-inhomogeneous-Duffin-Schaeffer-conjecture-September-25-2026:thm:main"},{"matched_terms":["finite","infinitely","many","valued"],"method":"catalogue-text-overlap","review_state":"unreviewed","score":4,"statement_id":"r:The-weak-inhomogeneous-Duffin-Schaeffer-conjecture-September-25-2026:cor:hausdorff"}],"catalogue_claim":{"credit":{"kind":"attributed-catalogue-extraction","license":"Apache-2.0","name":"Will Cook, OpenAI Math Atlas; source manuscripts and Lean quotations credited to OpenAI.","pin":"8056826bbd00caea871ad036bd295182e2bef3e2","producer_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","producer_repository":"https://github.com/openai/math","sha256":"sha256:2c90a33675d6e8a37b8ab7c2e2107f358dd73fbc4c74dc1e183c17efa0e16267","source":"data/families.json"},"state":"producer-declared","text":"Proves that for every real shift <i>γ</i> and finite-valued \\(\\psi:\\mathbb N\\to[0,\\infty)\\), divergence of \\(\\sum_q\\phi(q)\\psi(q)/q\\) implies \\(\\|qx-\\gamma\\|\\lt \\psi(q)\\) for infinitely many <i>q</i>, for almost every <i>x</i>. Here <i>ϕ</i> is Euler's totient and the norm is distance to the nearest integer. Numerators are unrestricted; no monotonicity or Diophantine condition on <i>γ</i> is needed."},"historical_statement_ids":[],"method":"catalogue-text-overlap","primary_candidate":"r:The-weak-inhomogeneous-Duffin-Schaeffer-conjecture-September-25-2026:thm:main","reason":"Lexical navigation candidate; catalogue headline identity requires review.","review_state":"unreviewed","selected_statement_ids":[],"state":"candidate"},"community":{"efforts":[],"findings":[]},"contributions":[],"correspondences":[],"findings":[],"generation_id":"sha256:e44fe048bf34d