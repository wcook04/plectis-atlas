apers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:eac2fd9c4fd895bcd96385bdc1fbfa8b050eba84e34226ba44b05c28f8bc04a3","file":"preprints/A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026/build/sections/01-introduction.tex","line":6,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"88e11b9dff5c80079bee84473e8e0014b0f2e53a56ed1a4e0060eefd50a829f9","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026/build/sections/01-introduction.tex"},"sha256":"sha256:eac2fd9c4fd895bcd96385bdc1fbfa8b050eba84e34226ba44b05c28f8bc04a3","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026/build/sections/01-introduction.tex#L6"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exist a finite connected two-dimensional aspherical simplicial complex $K$ and a constant $C<\\infty$ with the following properties.\n\\begin{enumerate}[label=\\textup{(\\roman*)}]\n\\item Every combinatorial edge loop of length $\\ell$ in the universal cover of $K$ bounds a disk diagram with at most $C\\ell$ triangular faces.\n\\item The group $\\pi_1K$ admits no geometric action on a proper complete $\\CAT(0)$ space.\n\\end{enumerate}\nIn particular, $\\pi_1K$ is word-hyperbolic, and no finite simplicial complex homotopy equivalent to $K$ admits a locally $\\CAT(0)$ geodesic length metric inducing its given topology. Consequently, no such model admits a compatible locally $\\CAT(-1)$ geodesic length metric."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:65e832facdd536baa09453005475025772c42fff301b4a09ceb52b08aabed7db","grain":"paper-statement","id":"A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026#thm:diagram","title":"thm:diagram"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/fff174b7f86b0505fa567a64.json","pointer":"/row"},"display":"Theorem","id":"r:A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026:thm:diagram","manuscript_id":"p:A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026","name":"thm:diagram","printed_number":"3.1","printed_number_provenance":{"atlas_pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","binding":{"file":"build/sections/03-diagrams.tex","label":"thm:diagram","line":10,"manuscript":"A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026","statement_sha256":"3600bc0b71cf805150de9fb063c4127041e2a732052db0abc3dc73270f821ffa"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026.html#thm:diagram","section":3,"section_title":"Diagrams and linear filling","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:dbbe7ac3e232253781cdf0f774a053d0d83f99e4b73f5dc6670b43aa3dfdf6f2","file":"preprints/A-hyperbolic-group-with-no-geometric-CAT0-action-September-25-2026/build/sections/03-diag