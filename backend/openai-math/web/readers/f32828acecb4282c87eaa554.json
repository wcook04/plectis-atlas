ptember-25-2026:cor:regularity","manuscript_id":"p:Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026","name":"Zero mean dimension and crossed-product regularity","printed_number":"1.2","printed_number_provenance":{"atlas_pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","binding":{"file":"build/sections/01-introduction.tex","label":"cor:regularity","line":153,"manuscript":"Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026","statement_sha256":"2b979de2d5bc468d4221d139eacc76ff6e5aeef6b761657a636cf30ea39c32c0"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026.html#cor:regularity","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:df05e702ac6688764eec59babca61f7d47be562361a8e824568fdf31d18c2097","file":"preprints/Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026/build/sections/01-introduction.tex","line":153,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"2b979de2d5bc468d4221d139eacc76ff6e5aeef6b761657a636cf30ea39c32c0","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026/build/sections/01-introduction.tex"},"sha256":"sha256:df05e702ac6688764eec59babca61f7d47be562361a8e824568fdf31d18c2097","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026/build/sections/01-introduction.tex#L153"},"statement_kind":"corollary","text":"\\label{cor:regularity}\nLet \\(h\\) be a minimal homeomorphism of an infinite compact metrizable\nspace \\(X\\), and put \\(A=C(X)\\rtimes_h\\Z\\). The following conditions are\nequivalent:\n\\begin{enumerate}\n\\item \\(\\mdim(X,h)=0\\);\n\\item \\((X,h)\\) has the small boundary property;\n\\item \\(A\\cong A\\otimes\\mathcal Z\\);\n\\item \\(\\dim_{\\mathrm{nuc}}(A)<\\infty\\);\n\\item \\(\\dim_{\\mathrm{nuc}}(A)\\le1\\).\n\\end{enumerate}\nIn particular, if \\(\\mdim(X,h)\\in(0,\\infty]\\), then\n\\(A\\not\\cong A\\otimes\\mathcal Z\\) and\n\\(\\dim_{\\mathrm{nuc}}(A)=\\infty\\)."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:ad4d6d9bd12e151be0ad9c30cbf4bae49f8a0c5c19ff7e36781d3c51e6d11d8c","grain":"paper-statement","id":"Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026#thm:torus-compression","title":"Torus compression {\\cite[Theorem~1.3]{OpenAICompression2026}}"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/7859716afd271cae6e4edd77.json","pointer":"/row"},"display":"Theorem","id":"r:Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026:thm:torus-compression","manuscript_id":"p:Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026","name":"Torus compression {\\cite[Theorem~1.3]{OpenAICompression2026}}","printed_number":"2.1","printed_number_provenance":{"atlas_pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","binding":{"file":"build/sections/02-compression-interface.tex","label":"thm:torus-compression","line":70,"manuscript":"Radius-of-comparison-equals-half-the-mean-dimension-September-25-2026","statement_sha256":"357a737f792fc24c3a23cb40cd523bc6508a5069420ef9ca9d0e612db49bbea4"},"blob_sh