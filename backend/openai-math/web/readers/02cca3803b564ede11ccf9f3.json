t/mathvet/blob/14c7f918cd336d0da03a02aae5a0eed4a429d4db/reviews/openai-math/challenge-status.csv","verdict":"accepted"},"state":"reported-accepted","target":"l:MarkovType","toolchain":null,"used_axioms":null,"wall_seconds":null}],"scope_draft":{"credit":{"kind":"agent-drafted-unreviewed","pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","source":"curated/scope_coverage.json"},"state":"ai-draft","value":{"class":"as_stated","note":"States the main theorem (nontrivial Markov type forces superreflexivity) as an equivalence with having an equivalent uniformly convex norm.","quote":"The formalized result proves that a real Banach space has nontrivial Markov type exactly when it admits an equivalent uniformly convex norm, hence exactly when it is superreflexive. Nontrivial Markov type means a uniform Markov-type bound for some exponent $p>1$ over all finite stationary reversible chains and all positive times. The exponent and equivalent norm may depend on the space, and the zero space is included. Additional formalized consequences concern uniformly smooth renormings and reflexivity of finitely representable spaces.","relation":"unassessed","source_class":"headline"}}}],"metrics":{"community_findings":{"receipt":{"path":"families/02cca3803b564ede11ccf9f3.json","pointer":"/metrics/community_findings"},"rule":"Attributed community findings attached to family 327; independent of backend diagnostics.","sha256":"sha256:fcf4e817ac80cbfd2dc76e03fd6c228b3129634a221908f4cf07d12dbe701845","unit":"community findings","value":1},"exact_certified_reports":{"coverage":"available-records-only","receipt":{"path":"families/02cca3803b564ede11ccf9f3.json","pointer":"/metrics/exact_certified_reports"},"rule":"Available attributed cards matching exact_certified_reports","sha256":"sha256:cedb8e0ce03ee1b86fdb034a3e948889fa4c53b02deb2c8cc516c980c3977e00","unavailable_sources":[],"unit":"reported check cards","value":0},"exact_other_reports":{"coverage":"available-records-only","receipt":{"path":"