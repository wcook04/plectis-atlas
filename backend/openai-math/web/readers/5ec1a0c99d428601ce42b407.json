,\\mu)$ such that\n\\[\n                  \\{f\\circ T^n:n\\in\\Z\\}\n\\]\nis an orthonormal basis of $L^2_0(\\T^3,\\mu)$.\nConsequently $T$ is ergodic, and $U_T$ on this space is unitarily equivalent\nto multiplication by the coordinate $w$ on $L^2(S^1,m)$."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:7466c67f6b34bad20324bad57270709ada2c658eb9f0f6b8e5fbe9b5644274b7","grain":"paper-statement","id":"A-smooth-three-torus-diffeomorphism-with-simple-Lebesgue-spectrum-September-23-2026#prop:prediction","title":"Prediction of a tagged packet sum"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/cdf78a92582f89138a1fcc8e.json","pointer":"/row"},"display":"Proposition","id":"r:A-smooth-three-torus-diffeomorphism-with-simple-Lebesgue-spectrum-September-23-2026:prop:prediction","manuscript_id":"p:A-smooth-three-torus-diffeomorphism-with-simple-Lebesgue-spectrum-September-23-2026","name":"Prediction of a tagged packet sum","printed_number":"4.1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/04-blocks.tex","label":"prop:prediction","line":13,"manuscript":"A-smooth-three-torus-diffeomorphism-with-simple-Lebesgue-spectrum-September-23-2026","statement_sha256":"cf9162d3e0ea273d8de4e8b63586f0b23b1a375725475f26e13141a0b7d08b1c"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-smooth-three-torus-diffeomorphism-with-simple-Lebes