nter":"/row"},"display":"Corollary","id":"r:A-power-saving-for-planar-halving-lines-September-25-2026:cor:k-sensitive","manuscript_id":"p:A-power-saving-for-planar-halving-lines-September-25-2026","name":"Planar $k$-sets and straight-line levels","printed_number":"1.3","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/introduction.tex","label":"cor:k-sensitive","line":96,"manuscript":"A-power-saving-for-planar-halving-lines-September-25-2026","statement_sha256":"bae10a13c495357a641ed17c0a3885b1ccc3a3a56349e497d6b4ed597f237262"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-power-saving-for-planar-halving-lines-September-25-2026.html#cor:k-sensitive","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:4fcbd7e07bdcbf3354875a025bedaa9055edf0cff3d202a4ceac469face79f89","file":"preprints/A-power-saving-for-planar-halving-lines-September-25-2026/build/sections/introduction.tex","line":96,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"bae10a13c495357a641ed17c0a3885b1ccc3a3a56349e497d6b4ed597f237262","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-power-saving-for-planar-halving-lines-September-25-2026/build/sections/introduction.tex"},"sha256":"sha256:4fcbd7e07bdcbf3354875a025bedaa9055edf0cff3d202a4ceac469face79f89","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-power-saving-for-planar-halving-lines-September-25-2026/build/sections/introduction.tex#L96"},"statement_kind":"corollary","text":"\\label{cor:k-sensitive}\nThere are absolute constants $\\varepsilon_0>0$ and $C_0<\\infty$ such\nthat, for every integer $n\\ge2$ and every integer $1\\le k\\le n/2$,\nthe number of $k$-sets of any $n$-point set $Q\\subset\\mathbb R^2$ with\nno three collinear is at most\n\\begin{equation}\\label{eq:k-sensitive}\n C_0 n(k+1)^{1/3-\\varepsilon_0}.\n\\end{equation}\nThe same bound holds for $\\operatorname{comp}(\\Lambda_k(\\mathcal L))$\nfor any arrangement $\\mathcal L$ of $n$ nonvertical straight lines\nwith no parallel pair and no three concurrent."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:62e7feb62905e8ef1c7885ad7f69b804d217226c8f7595c2b869e81f4a4319b2","grain":"paper-statement","id":"A-power-saving-for-planar-halving-lines-September-25-2026#thm:activity-packing","title":"Uniform activity packing"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/3f826dd1b26afa611d4c7150.json","pointer":"/row"},"display":"Theorem","id":"r:A-power-saving-for-planar-halving-lines-September-25-2026:thm:activity-packing","manuscript_id":"p:A-power-saving-for-planar-halving-lines-September-25-2026","name":"Uniform activity packing","printed_number":"2.1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/finite.tex","label":"thm:activity-packing","line":50,"manuscript":"A-power-saving-for-planar-halving-lines-September-25-2026","statement_sha256":"d1d859590c04a474061ffeb8ca6db7f163cf2974fe8df9dc2f8be77cc65d29b4"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","rende