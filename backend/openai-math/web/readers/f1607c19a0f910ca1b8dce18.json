rints/The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026/build/sections/01-introduction.tex","line":44,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"e99c961ecded60ac8efc33addeeff4d5a5eee63c53a3c44a2da8c047897bc986","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026/build/sections/01-introduction.tex"},"sha256":"sha256:aecffa70def3bee37c39d079a603b936c7c22213b808e9c7bdef03193799ab72","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026/build/sections/01-introduction.tex#L44"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet \\(n\\ge2\\) be an integer, let \\(p,q>0\\), and let \\(A,B\\in\\R\\).\nSuppose that\n\\begin{equation}\\label{eq:subcritical}\n \\frac{n+A}{p+1}+\\frac{n+B}{q+1}>n-2.\n\\end{equation}\nThere are no functions\n\\[\n u,v\\in C^2(\\R^n\\setminus\\{0\\})\\cap C(\\R^n),\n \\qquad u(x)>0,\\quad v(x)>0\\quad(x\\in\\R^n),\n\\]\nsatisfying Equation~\\eqref{eq:system} at every \\(x\\ne0\\)."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:5c64cb2601b579104a995af5c44fdf5cdc8557abf3050c75a34cf77421ac3026","grain":"paper-statement","id":"The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026#cor:lane-emden","title":"Unweighted Lane--Emden conjecture"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/43cf577bae55356c9f94eac0.json","pointer":"/row"},"display":"Corollary","id":"r:The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026:cor:lane-emden","manuscript_id":"p:The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026","name":"Unweighted Lane--Emden conjecture","printed_number":"1.2","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/01-introduction.tex","label":"cor:lane-emden","line":58,"manuscript":"The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026","statement_sha256":"ffe175cf15b69eda80fe1cbef2b544c1bc2c9060f9fc93d23dc1e5d502824dbd"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026.html#cor:lane-emden","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:0b2d6544fc44a80acb0ce31ced55e769e6c75bd3c979259d4abcb922a9d49394","file":"preprints/The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026/build/sections/01-introduction.tex","line":58,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"ffe175cf15b69eda80fe1cbef2b544c1bc2c9060f9fc93d23dc1e5d502824dbd","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026/build/sections/01-introduction.tex"},"sha256":"sha256:0b2d6544fc44a80acb0ce31ced55e769e6c75bd3c979259d4abcb922a9d49394","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026/build/sections/01-introduction.tex#L58"},"statement_kind":"corollary","text":"\\label{cor:lane-emden}\nFor every integer \\(n\\ge3\\) and \\(p,q>0\\) satisfying\n\\[\n \\frac{1}{p+1}+\\frac{1}{q+1}>\\frac{n-2}{n},\n\\]\nthere is no strictly positive \\(C^2(\\R^n)\\) solution of\n\\[\n -\\Delta u=v^p,\\qquad -\\Delta v=u^q\\qquad\\text{in }\\R^n.\n\\]"},{"appendix":false,"contribution_target":{"fingerprint":"sha256:cf114db718498419fdfc71277a8a5ea4d850c90d80d17f19be959e5cc2c7f15b","grain":"paper-statement","id":"The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026#prop:uniform","title":"Universal centered estimates"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/64b6d2c021099690525c0ed7.json","pointer":"/row"},"display":"Proposition","id":"r:The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026:prop:uniform","manuscript_id":"p:The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026","name":"Universal centered estimates","printed_number":"2.4","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/02-preliminaries.tex","label":"prop:uniform","line":222,"manuscript":"The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026","statement_sha256":"f785dd91a6b5aaf35d22fb400ab3b191c940f75d27d8f8dc2face1c82421a837"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/The-Subcritical-Henon-Lane-Emden-Conjecture-September-24-2026.html#prop:uniform","section":2,"section_title":"Reductions and Newton potentials","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256