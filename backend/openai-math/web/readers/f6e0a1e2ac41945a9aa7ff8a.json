:"One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026","statement_sha256":"5b15fcbe35d7d2d9ba1b834cce7fa7a864793c5c4a62c4b98e38d91cd914b479"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"8056826bbd00caea871ad036bd295182e2bef3e2","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:202193e6deddb8284717c0a6f1800d0732acea9bd7757bf793dd792ce014c143","file":"preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/introduction.tex","line":24,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"5b15fcbe35d7d2d9ba1b834cce7fa7a864793c5c4a62c4b98e38d91cd914b479","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:202193e6deddb8284717c0a6f1800d0732acea9bd7757bf793dd792ce014c143","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/introduction.tex#L24"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is a measurable online selection rule, independent of the value\ndistributions, with the following property. Let $M=(E,\\mathcal I)$ be any\nfinite known labeled matroid, and let $(S_e,V_e:e\\in E)$ be mutually\nindependent nonnegative real random variables, with $S_e$ and $V_e$ having\nthe same arbitrary law $D_e$. Assume\n$\\Ex[\\OPT_M(V)]<\\infty$. The rule receives exactly the sample vector $S$\nbefore arrivals and uses a seed $R$ independent of $S,V$.\n\nFor every measurable permutation rule $\\pi$ depending on $M$, the laws\n$(D_e)$, $S$, $V$, and $R$, the rule accepts an independent set $A$,\nirrevocably deciding at each arrival using only the available history, and\n\\begin{equation}\\label{eq:main}\n \\Ex\\left[\\sum_{e\\in A}V_e\\right]\n       \\ge 2^{-310}\\Ex[\\OPT_M(V)].\n\\end{equation}"},{"appendix":false,"contribution_target":{"fingerprint":"sha256:cc2e908d446ff02224d32461833d4318fb84a03f82e6412aadb3060920300301","grain":"paper-statement","id":"One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026#prop:hidden","title":"prop:hidden"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/e9acec999a7394629a0b2096.json","pointer":"/row"},"display":"Proposition","id":"r:One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026:prop:hidden","manuscript_id":"p:One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026","name":"prop:hidden","printed_number":"2.1","printed_number_provenance":{"atlas_pin":"8056826bbd00caea871ad036bd295182e2bef3e2","binding":{"file":"build/sections/setup.tex","label":"prop:hidden","line":23,"manuscript":"One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026","statement_sha256":"5a56f8533eb3587aeba02fb3a5c2cfb58b826d37a44925d8cd3fb95d8e823b97"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"8056826bbd00caea871ad036bd295182e2bef3e2","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026.html#prop:hidden","section":2,"section_title":"A fixed-vector formulation","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:47f74ccbb7b99d8afeb8de937021a6b41ae786fe290812496062b752c3f8332f","file":"preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/setup.tex","line":23,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"5a56f8533eb3587aeba02fb3a5c2cfb58b826d37a44925d8cd3fb95d8e823b97","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/setup.tex"},"sha256":"sha256:47f74ccbb7b99d8afeb8de937021a6b41ae786fe290812496062b752c3f8332f","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/setup.tex#L23"},"statement_kind":"proposition","text":null},{"appendix":false,"contribution_target":{"fingerprint":"sha256:3015171c286bb5e82588fd9dce20b40789e2cf17b44723b9e8523da3e62bd49e","grain":"paper-statement","id":"One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026#cor:secretary","title":"Order-oblivious selection with full-seed visibility"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-so