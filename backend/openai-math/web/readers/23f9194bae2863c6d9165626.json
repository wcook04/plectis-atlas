_sha256":"d2595dd5c3f7699d5e5aa1b70a4751af98ad0999fabbd03b51cb2e9475a4aef4"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026.html#thm:signing","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:7ffdc1b3c2a5f2dea88d3e70490c6b9004dd3a4ea09ef14f3e3720ce2150f89e","file":"preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex","line":10,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"d2595dd5c3f7699d5e5aa1b70a4751af98ad0999fabbd03b51cb2e9475a4aef4","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex"},"sha256":"sha256:7ffdc1b3c2a5f2dea88d3e70490c6b9004dd3a4ea09ef14f3e3720ce2150f89e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex#L10"},"statement_kind":"theorem","text":"\\label{thm:signing}\nThere is an absolute constant $C$ such that, for all integers $d,N\\ge1$ and\nevery sequence $v_1,\\ldots,v_N\\in\\R^d$ with $\\lVert v_i\\rVert_2\\le1$,\nthere are signs $\\varepsilon_1,\\ldots,\\varepsilon_N\\in\\{-1,1\\}$ for which\n\\[\n \\max_{0\\le k\\le N}\n \\left\\lVert\\sum_{i=1}^k\\varepsilon_i v_i\\right\\rVert_2\\le C\\sqrt d.\n\\]\nThe same signs control all prefixes, and $C$ is independent of $d$, $N$\nand the sequence."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:a41ccbc057b89d556b22f80c8b5a15a724366972a7d695934742631abcc1772d","grain":"paper-statement","id":"The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026#thm:steinitz","title":"Euclidean Steinitz--Bergstr\\\"om bound"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/3586e02c3e52ead9006fe326.json","pointer":"/row"},"display":"Theorem","id":"r:The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026:thm:steinitz","manuscript_id":"p:The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026","name":"Euclidean Steinitz--Bergstr\\\"om bound","printed_number":"1.2","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/introduction.tex","label":"thm:steinitz","line":35,"manuscript":"The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026","statement_sha256":"a27eba0a3bc2ef195a070b06e2c4247b6b6bcd4bbdbe5b03ff657049cdd4e398"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026.html#thm:steinitz","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:6be428d298fec5c9172bed2488b5366b24179fe43113968e3ed58437becc35b1","file":"preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex","line":35,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"a27eba0a3bc2ef195a070b06e2c4247b6b6bcd4bbdbe5b03ff657049cdd4e398","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex"},"sha256":"sha256:6be428d298fec5c9172bed2488b5366b24179fe43113968e3ed58437becc35b1","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex#L35"},"statement_kind":"theorem","text":"\\label{thm:steinitz}\nThere is an absolute constant $C$ such that, for all integers $d,N\\ge1$ and\nevery indexed family $v_1,\\ldots,v_N\\in\\R^d$ satisfying\n$\\lVert v_i\\rVert_2\\le1$ and $\\sum_{i=1}^N v_i=0$, some permutation\n$\\pi\\in\\mathfrak S_N$ satisfies\n\\[\n \\max_{0\\le k\\le N}\\left\\lVert\\sum_{i=1}^k v_{\\pi(i)}\\right\\rVert_2\n \\le C\\sqrt d.\n\\]\nThe constant in Theorem~\\ref{thm:signing} also suffices here."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:2e0e169a0f9be3e967cc8fd4fc67eb5b8efb60f27a56c2814418c183800995f7","grain":"paper-statement","id":"The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026#prop:adaptive","title":"Signs with adaptive shifts"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/c7971e30c195bf0c6daa04b3.json","pointer":"/row"},"display":"Proposition","id":"r:The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026:prop:adaptive","manuscript_id":"p:The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026","name":"Signs with adaptive shifts","printed_number":"2.1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/assembly.tex","label":"prop:adaptive","line":32,"manuscript":"The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026","statement_sha256":"a3ab778bd7d5f351b0e6de9cea15255008d22414531359ecda988062f0734566"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026.html#prop:adaptive","section":2,"section_title":"Constructing the signed walk","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:871206780307c45941f1d9b08e3ba0d2dfc7bc5c81b1b8f23ed836987478fa0d","file":"preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/assembly.tex","line":32,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"a3ab778bd7d5f351b0e6de9cea15255008d22414531359ecda988062f0734566","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/assembly.tex"},"sha256":"sha256:871206780307c45941f1d9b08e3ba0d2dfc7bc5c81b1b8f23ed836987478fa0d","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/assembly.tex#L32"},"statement_kind":"proposition","text":null},{"appendix":false,"contribution_target":{"fingerprint":"sha256:dca513f8ade528dbbf98310896d0398841ef3ba6dd1bd02a7f553fc2e2c4bf74","grain":"paper-statement","id":"The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026#prop:filtered","title":"Energy of a filtered path body"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-sourc