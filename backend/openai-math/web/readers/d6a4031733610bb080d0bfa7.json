et-Sum-September-26-2026/build/separators.tex#L371"},"statement_kind":"corollary","text":null},{"appendix":false,"contribution_target":{"fingerprint":"sha256:08a12a6f4ea2234ea66490158013c3fd2c4dc901dff2c1be6ab9170ad9a4b11d","grain":"paper-statement","id":"Subset-Sum-in-Time-2-power-0-49n-October-4-2026#thm:main","title":"thm:main"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/3ee38dfe6224ff67caabd5fa.json","pointer":"/row"},"display":"Theorem","id":"r:Subset-Sum-in-Time-2-power-0-49n-October-4-2026:thm:main","manuscript_id":"p:Subset-Sum-in-Time-2-power-0-49n-October-4-2026","name":"thm:main","printed_number":"1.1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/introduction.tex","label":"thm:main","line":58,"manuscript":"Subset-Sum-in-Time-2-power-0-49n-October-4-2026","statement_sha256":"1b6cc1c1aca603ec28ab420933bac0ea75873affcf9c9f308207d901fcca6f33"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Subset-Sum-in-Time-2-power-0-49n-October-4-2026.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:44eeadceb5ec9c614d879b98280391fd447a825b26bf4b59d16670e6bdf40e04","file":"preprints/Subset-Sum-in-Time-2-power-0-49n-October-4-2026/build/sections/introduction.tex","line":58,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"1b6cc1c1aca603ec28ab420933bac0ea75873affcf9c9f308207d901fcca6f33","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Subset-Sum-in-Time-2-power-0-49n-October-4-2026/build/sections/introduction.tex"},"sha256":"sha256:44eeadceb5ec9c614d879b98280391fd447a825b26bf4b59d16670e6bdf40e04","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Subset-Sum-in-Time-2-power-0-49n-October-4-2026/build/sections/introduction.tex#L58"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is a uniform randomized classical algorithm $\\mathcal A$ for\nSubset Sum with the following properties in the word-RAM model\n\\eqref{eq:word-length}.\nFor every input with $n\\ge2$, the algorithm halts on every execution\nand outputs the correct answer with probability at least $2/3$.\nFor every fixed positive integer $c$, there are constants $C_c>0$\nand $N_c\\ge2$ such that every input with $n\\ge N_c$ and $b\\le n^c$\nis processed, on every outcome of the random choices, in at most\n\\[\n                         C_c\\,2^{0.49n}\n\\]\nword operations.  The program is not given $c$ and does not depend\non $c$."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:07d7ced1f13b4c5ca90ed4256a23f6c82df7204e0b704da3a6a7fb699e2ffe3d","grain":"paper-statement","id":"Subset-Sum-in-Time-2-power-0-49n-October-4-2026#prop:preliminary","title":"Capped preliminary search"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/6332998f1c43414ed0b607cd.json","pointer":"/row"},"display":"Proposition","id":"r:Subset-Sum-in-Time-2-power-0-49n-October-4-2026:prop:preliminary","manuscript_id":"p:Subset-Sum-in-Time-2-power-0-49n-October-4-20