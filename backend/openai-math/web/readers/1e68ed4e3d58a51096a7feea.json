introduction.tex","line":29,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"f610d581605f52f96a3d66748b076370fc1ff042fe3a35da952586e0cbd5e887","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-Nearly-Quartic-Separation-Between-Randomized-and-Quantum-Query-Complexity-October-5-2026/build/sections/01-introduction.tex"},"sha256":"sha256:e8b513e04cbfff953d24691bca964f36d1ff4f7bd6a8848827e9002d0c36b990","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-Nearly-Quartic-Separation-Between-Randomized-and-Quantum-Query-Complexity-October-5-2026/build/sections/01-introduction.tex#L29"},"statement_kind":"theorem","text":"\\label{thm:main}\nThe optimal power is $\\alpha_{\\mathrm{tot}}=4$.\nMore precisely, $\\R(f)=O((1+\\Q(f))^4)$ for every total Boolean function.\nFor each fixed integer $k\\ge2$, there are positive constants $c_k,C_k,b_k$\nand total Boolean functions $F_{k,m}$, for all sufficiently large powers\nof four $m$, such that\n\\begin{equation}\\label{eq:main-family}\n \\Q(F_{k,m})\\le C_k\\sqrt m\\,(\\log m)^{b_k},\n \\qquad\n \\R(F_{k,m})\\ge c_k\\frac{m^{2-1/k}}{(\\log m)^2}.\n\\end{equation}"},{"appendix":false,"contribution_target":{"fingerprint":"sha256:659b010b99a58d96d1ce36c38fd2f0ecc46b7a13829b83af24157746df449f52","grain":"paper-statement","id":"A-Nearly-Quartic-Separation-Between-Randomized-and-Quantum-Query-Complexity-October-5-2026#prop:tournament","title":"A tournament for probabilistic comparisons"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/0de5b78acdede986f2d18e1a.json","pointer":"/row"},"display":"Proposition","id":"r:A-Nearly-Quartic-Separation-Between-Randomized-and-Quantu