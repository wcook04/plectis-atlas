18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/9d5aaf5e92faa98f4471ef8c.json","pointer":"/row"},"display":"Corollary","id":"r:A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026:cor:product-singularities","manuscript_id":"p:A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026","name":"Products with stationary factors","printed_number":"1.2","printed_number_provenance":{"atlas_pin":"c0851ae4ba3e12b1170cd4cdae33b48fae15d9a0","binding":{"file":"build/sections/introduction.tex","label":"cor:product-singularities","line":40,"manuscript":"A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026","statement_sha256":"3d258542b5f961fe9e846df602fd720ebf759c9ffff1360538699b384aa6821b"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"c0851ae4ba3e12b1170cd4cdae33b48fae15d9a0","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026.html#cor:product-singularities","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","file":"preprints/A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026/build/sections/introduction.tex","line":40,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"3d258542b5f961fe9e846df602fd720ebf759c9ffff1360538699b384aa6821b","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:6634edc95854a1d9d0fb9db852698d6951dcfdae0ca87c372823dcfe58618128","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026/build/sections/introduction.tex#L40"},"statement_kind":"corollary","text":"\\label{cor:product-singularities}\nLet \\(\\omega(t)\\), \\(T_*\\), \\(p\\), and \\(a\\) be as in\nTheorem~\\ref{thm:main}, and let \\((Y,\\eta)\\) be a compact connected\nK\\\"ahler manifold with \\(\\eta\\) of constant scalar curvature.  With\n\\(\\pi_X\\) and \\(\\pi_Y\\) the projections from \\(\\CP^{10}\\times Y\\),\nthe maximal smooth Calabi flow from\n\\(\\Omega_0=\\pi_X^*\\omega_0+\\pi_Y^*\\eta\\) is\n\\[\n \\Omega(t)=\\pi_X^*\\omega(t)+\\pi_Y^*\\eta,\n \\qquad 0\\leq t<T_*.\n\\]\nFor every \\(y\\in Y\\),\n\\(S(\\Omega(t))(p,y)\\sim a(T_*-t)^{-1/2}\\).\nIn particular, finite-time smooth Calabi-flow singularities occur in\nevery complex dimension \\(n\\geq10\\), on\n\\(\\CP^{10}\\times\\CP^{n-10}\\), in a class containing a\nK\\\"ahler--Einstein metric."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:30497814aec596708d6f689463f7399c060e63a14fa7400e042ef64dd21a3565","grain":"paper-statement","id":"A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026#geo:reduction"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/9ed33bcff53daa9232f7b0b2.json","pointer":"/row"},"display":"Proposition","id":"r:A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026:geo:reduction","manuscript_id":"p:A-finite-time-singularity-of-Calabi-flow-on-projective-space-September-24-2026","name":"Exact fixed-class reduction","printed_number":"2.1","printed_number