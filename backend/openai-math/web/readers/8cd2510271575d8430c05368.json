)|\\longrightarrow\\infty$, such that every vertex belongs to\nat most $D$ faces of dimension $d$ and, for every\n$f\\in C^i(X_m;\\F)$,\n\\begin{equation}\\label{eq:goal}\n \\norm{\\delta_i f}_{X_m,i+1}\n \\ge \\eps\\,\\dist_{X_m,i}(f,B^i(X_m))\n \\qquad(0\\le i<d).\n\\end{equation}\nThe constants are independent of $m$, $i$, and $f$."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:ba90843e570fc391049fdd4af3425358abc0f4b602bf874787b0c3a869286c48","grain":"paper-statement","id":"Bounded-degree-coboundary-expanders-in-every-dimension-September-24-2026#prop:L-acyclic","title":"prop:L-acyclic"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/98c1c98c66b728370a0f24de.json","pointer":"/row"},"display":"Proposition","id":"r:Bounded-degree-coboundary-expanders-in-every-dimension-September-24-2026:prop:L-acyclic","manuscript_id":"p:Bounded-degree-coboundary-expanders-in-every-dimension-September-24-2026","name":"prop:L-acyclic","printed_number":"1","printed_number_provenance":{"atlas_pin":"598384f431d532144d03cbabd1c5b384e1610218","binding":{"file":"build/source/sections/geometry.tex","label":"prop:L-acyclic","line":163,"manuscript":"Bounded-degree-coboundary-expanders-in-every-dimension-September-24-2026","statement_sha256":"3915dd8f23b8308646090393b6997f11891e4f3279f8b056a8bc0397e5ec7133"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"598384f431d532144d03cbabd1c5b384e1610218","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Bounded-degree-coboundary-expanders-in-every-dimension-