83cc46.json","pointer":"/row"},"display":"Theorem","id":"r:Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026:thm:main","manuscript_id":"p:Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026","name":"Exact matching in almost-linear input-size time","printed_number":"1.1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/01-introduction.tex","label":"thm:main","line":34,"manuscript":"Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026","statement_sha256":"29b3972f8e04528edc4e7bec809a552e7ea3572a9d41083ab199507af1e9b569"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:e8e76068b7a6a31fdbe505896693f7a5ce64409ad016216bdb1e3dfb43b538a9","file":"preprints/Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026/build/sections/01-introduction.tex","line":34,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"29b3972f8e04528edc4e7bec809a552e7ea3572a9d41083ab199507af1e9b569","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026/build/sections/01-introduction.tex"},"sha256":"sha256:e8e76068b7a6a31fdbe505896693f7a5ce64409ad016216bdb1e3dfb43b538a9","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026/build/sections/01-introduction.tex#L34"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere are a single uniform randomized word-RAM algorithm, fixed constants\n$c_0\\ge2$ and $C\\ge1$, and a nonincreasing function\n$\\eta:\\mathbb N_{\\ge1}\\to\\mathbb R_{\\ge0}$ with $\\eta(q)\\to0$ as\n$q\\to\\infty$ such that the following holds.\nFor every input graph $G=([n],E)$ with $m=|E|$ and $p=n+m$, the algorithm\nhalts on every computation path in at most\n\\[\n                          C p^{1+\\eta(p)}\n\\]\ninstructions. With probability at least $2/3$ it outputs an explicit list of\nedges of a matching of size $\\nu(G)$."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:55ab06cb576499b745d891bfed91e1520968509aa94b4fc29a00ce1fb4753be8","grain":"paper-statement","id":"Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026#thm:subcubic","title":"Fixed-parameter subcubic perfect-matching search"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/f60c83b1fca16e9704f42db0.json","pointer":"/row"},"display":"Theorem","id":"r:Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026:thm:subcubic","manuscript_id":"p:Almost-Linear-Time-Maximum-Cardinality-Matching-in-Sparse-General-Graphs-September-24-2026","name":"Fixed-parameter subcubic perfect-matching search","printed_number":"4.7","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/04-projection-analysis.tex","labe