d04ea9f60c08"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026.html#intro:entropy","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:22b55480bab060cee55923cf052ac59ad7bbb935b53a5ba550067b37e5f39cf0","file":"preprints/A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026/build/manuscript/introduction.tex","line":75,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"388a9b7234e85b3b7733a0968297d89a56868c5ae4e1428171f3d04ea9f60c08","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026/build/manuscript/introduction.tex"},"sha256":"sha256:22b55480bab060cee55923cf052ac59ad7bbb935b53a5ba550067b37e5f39cf0","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026/build/manuscript/introduction.tex#L75"},"statement_kind":"theorem","text":"\\label{intro:entropy}\nLet $m\\ge1$ and let $f$ be a log-concave probability density on $\\R^m$.\nThen\n\\begin{equation}\\label{intro:entropy-bound}\n h(f)\\ge m+\\frac12\\log\\det\\Cov(f).\n\\end{equation}\nEquality holds if and only if $f$ is, almost everywhere, the density\nof $M(E_1,\\ldots,E_m)^{\\mathsf T}+b$, where $M$ is an invertible real\n$m\\times m$ matrix, $b\\in\\R^m$, and the $E_i$ are independent random\nvariables with density $e^{-u}\\mathbf1_{\\{u\\ge0\\}}$."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:a898ebf09b9a96a634a26607d830d3320c8fc15f3500c6039fb2decb31d88de5","grain":"paper-statement","id":"A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026#tr:normalization","title":"Affine normalization"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/1c17112bbe96e1c8ccca34c0.json","pointer":"/row"},"display":"Proposition","id":"r:A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026:tr:normalization","manuscript_id":"p:A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026","name":"Affine normalization","printed_number":"2.3","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/manuscript/transport.tex","label":"tr:normalization","line":160,"manuscript":"A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026","statement_sha256":"7197c4e4cc6cbc7e1855dc97b2d44e2cb68e8f6ed2846005125c5e7a2be40fdb"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-sharp-entropy-bound-and-the-simplex-inequality-for-isotropic-constants-October-5-2026.html#tr:normalization","section":2,"section_title":"Gaussian transport and a matrix surplus","source":{"current_hash_method":"tex-environment-body-comments