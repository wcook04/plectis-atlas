:"paper-statement","id":"Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026#thm:main","title":"thm:main"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/b8cdb9d5e5ffa8ac80866e70.json","pointer":"/row"},"display":"Theorem","id":"r:Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026:thm:main","manuscript_id":"p:Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026","name":"thm:main","printed_number":"1.1","printed_number_provenance":{"atlas_pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","binding":{"file":"build/source/sections/00-introduction.tex","label":"thm:main","line":16,"manuscript":"Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026","statement_sha256":"836d23782b878bd24a5143506bf5dab243d0735afa90e6d114dea385821e5efa"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:b0592b3037a4387bdfaec98e2791972eda9009d4516bd1925dcc261dfc6cd86b","file":"preprints/Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026/build/source/sections/00-introduction.tex","line":16,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"836d23782b878bd24a5143506bf5dab243d0735afa90e6d114dea385821e5efa","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026/build/source/sections/00-introduction.tex"},"sha256":"sha256:b0592b3037a4387bdfaec98e2791972eda9009d4516bd1925dcc261dfc6cd86b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026/build/source/sections/00-introduction.tex#L16"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every fixed real constant $C>1$, there is a polynomial-time reduction\nfrom $3$CNF satisfiability to finite undirected graphs with nonnegative\nrational capacities and exactly unit demands, together with a positive\nrational threshold $a$, such that\n\\[\n \\begin{array}{ll}\n \\text{the formula is satisfiable}&\\Longrightarrow\\ \\Phi(G)\\le a,\\\\[2pt]\n \\text{the formula is unsatisfiable}&\\Longrightarrow\\ \\Phi(G)>Ca.\n \\end{array}\n\\]\nThe graph size and the bit lengths of all output numbers are polynomial\nin the formula size, with constants and exponents allowed to depend on\n$C$.  In particular, approximating Uniform Sparsest Cut within any fixed\nfactor $C>1$ is NP-hard."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:b89a2240c9bed6e4a02868470690f1658c608038abdd98670c8ccccee3e76b7d","grain":"paper-statement","id":"Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026#thm:bit-test-system","title":"thm:bit-test-system"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/564d8a1084c2ca6f3d229edf.json","pointer":"/row"},"display":"Theorem","id":"r:Constant-factor-hardness-of-uniform-sparsest-cut-September-24-2026:thm:bit-test-system"