source/main.tex"},"sha256":"sha256:83e3df0df54a256d25c50659362ed0c8b186847b038ae92b0608c62960b595a8","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Near-square-root-logarithmic-integrality-gaps-for-uniform-sparsest-cut-September-24-2026/build/source/main.tex#L152"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere are an absolute constant $c>0$ and capacity instances $C^{(j)}$\non $n_j\\to\\infty$ vertices, with $\\GL(C^{(j)})>0$, such that\n\\[\n\\frac{\\OPT(C^{(j)})}{\\GL(C^{(j)})}\n\\ge c\\,\\frac{\\sqrt{\\log n_j}}{(\\log\\log n_j)^3}\n\\]\nfor all sufficiently large $j$. The demand is one between every pair\nof distinct vertices."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:fa9d0bae6aeb26125c26c21ed8f6d37a2b996612dc2dda814b61c85742b4fc70","grain":"paper-statement","id":"Near-square-root-logarithmic-integrality-gaps-for-uniform-sparsest-cut-September-24-2026#prop:metric","title":"prop:metric"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/0fb22a882af0b6dc2d724a9f.json","pointer":"/row"},"display":"Proposition","id":"r:Near-square-root-logarithmic-integrality-gaps-for-uniform-sparsest-cut-September-24-2026:prop:metric","manuscript_id":"p:Near-square-root-logarithmic-integrality-gaps-for-uniform-sparsest-cut-September-24-2026","name":"prop:metric","printed_number":"1","printed_number_provenance":{"atlas_pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","binding":{"file":"build/source/metric.tex","label":"prop:metric","line":5,"manuscript":"Near-square-root-logarithmic-integrality-gaps-for-uniform-sparsest-cut-September-24-2026","statement_sha256":"f13d8c30246b9e6001be39b8b31525ae9eef61fc4b90d2f3ba83dd82303fd7ad"},"blob_sha256":"sha256:253ae0683558fd09