-Oracle-October-5-2026","statement_sha256":"51f21ce621a1a1ae271caf24402f8e57fd7a3fc1a9b4747bda4ae763574cbe35"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:6939b9dad78d364d7d6d519599cbc77519cd4ae9732149bf0bd13bb28d04219b","file":"preprints/Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026/build/sections/01-introduction.tex","line":46,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"51f21ce621a1a1ae271caf24402f8e57fd7a3fc1a9b4747bda4ae763574cbe35","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026/build/sections/01-introduction.tex"},"sha256":"sha256:6939b9dad78d364d7d6d519599cbc77519cd4ae9732149bf0bd13bb28d04219b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026/build/sections/01-introduction.tex#L46"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere are a polynomial $p$ and a deterministic classical algorithm which, on\ninput $1^n$ for any integer $n\\ge1$, outputs in time at most $p(n)$ a quantum\noracle circuit $A_n$ with the following properties.  The circuit uses the gates\n$H,T,T^\\dagger,\\mathrm{CNOT}$ and a single Boolean oracle of input length\n$m(n)\\le p(n)$.  Its total number of qubits, elementary gates, and oracle calls\nare each at most $p(n)$.  For every unitary $U\\in U(2^n)$ there is a function\n$f:\\{0,1\\}^{m(n)}\\to\\{0,1\\}$ for which the output channel $\\Phi_{n,f}$ of\n$A_n^{O_f}$ satisfies\n\\[\n \\norm{\\Phi_{n,f}-\\mathcal U}_\\diamond\\le\\frac12.\n\\]"},{"appendix":false,"contribution_target":{"fingerprint":"sha256:08c02a473bbd54cc1c23c96d9d18bb159f3c56f4dd6d63d99bfa62119c0cd121","grain":"paper-statement","id":"Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026#contract:block","title":"A block of uniformly small norm"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/2aad2cb0dcbd5d09b75a721c.json","pointer":"/row"},"display":"Proposition","id":"r:Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026:contract:block","manuscript_id":"p:Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026","name":"A block of uniformly small norm","printed_number":"3.2","printed_number_provenance":{"atlas_pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","binding":{"file":"build/sections/03-contraction.tex","label":"contract:block","line":93,"manuscript":"Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026","statement_sha256":"1941640ecbc4f45f64741457bbb0384fb66b1910fc82a46b3994f74450262a58"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Polynomial-Time-Unitary-Synthesis-from-a-Boolean-Oracle-October-5-2026.html#contrac