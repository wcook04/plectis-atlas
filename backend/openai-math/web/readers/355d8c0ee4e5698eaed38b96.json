f7566b117c89596c8d51df98c5ccb1115dc7bddfb35c3cf3061db2b17534","grain":"family","id":"family:355","title":"Unique tangent flows at the first surface singularity"},"kind":"claim-identification","reason":"Lexical navigation candidate; catalogue headline identity requires review.","target":"f:355"},{"contribution_target":{"fingerprint":"sha256:73d6f7566b117c89596c8d51df98c5ccb1115dc7bddfb35c3cf3061db2b17534","grain":"family","id":"family:355","title":"Unique tangent flows at the first surface singularity"},"kind":"formalization","reason":"No Lean object is recorded for this family.","target":"f:355"}],"schema":"statement-map-web/2","selection":{"headline_state":"candidate","headline_statement":"r:Tangent-flow-uniqueness-2026-09-24:thm:main","lean":null,"method":"Show catalogue candidate separately; use source-cited targets or unambiguous manifest bindings, abstain on unresolved associations, then use source-text navigation candidates. Prefer a producer main-result Lean object with an available target.","paired_statement":null,"paired_statements":[],"pairing_state":"unavailable","scope_context":"family-readings"},"source_associations":[],"statements":[{"appendix":false,"contribution_target":{"fingerprint":"sha256:3b5f26932f4967b9885165e29f71ae4d5abb3ba4686f2ab499dccf703ab7e200","grain":"paper-statement","id":"Tangent-flow-uniqueness-2026-09-24#thm:main","title":"thm:main"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/d623ecd6b1627f5c6c604bbb.json","pointer":"/row"},"display":"Theorem","id":"r:Tangent-flow-uniqueness-2026-09-24:thm:main","manuscript_id":"p:Tangent-flow-uniqueness-2026-09-24","name":"thm:main","printed_number":"1.1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/introduction.tex","label":"thm:main","line":46,"manuscript":"Tangent-flow-uniqueness-2026-09-24","statement_sha256":"1b37127c80b7c342418754f5d2a1ca9002d8749c53d32ac01edcadd3b35683ec"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Tangent-flow-uniqueness-2026-09-24.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:d389e5dc84bf51eb0f7daf0d0dd2b2227aea4c3c4427ea36be3a5f8274d5fb05","file":"preprints/Tangent-flow-uniqueness-2026-09-24/build/sections/introduction.tex","line":46,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"1b37127c80b7c342418754f5d2a1ca9002d8749c53d32ac01edcadd3b35683ec","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Tangent-flow-uniqueness-2026-09-24/build/sections/introduction.tex"},"sha256":"sha256:d389e5dc84bf51eb0f7daf0d0dd2b2227aea4c3c4427ea36be3a5f8274d5fb05","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Tangent-flow-uniqueness-2026-09-24/build/sections/introduction.tex#L46"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $M_0\\subset\\R^3$ be a smooth compact connected embedded surface\nwithout boundary, and let $(M_t)_{0\\le t<T}$ be its maximal smooth\nmean curvature flow.  At every singular point $(x_0,T)$ at its first\nsingular time there is a smooth properly embedded self-shrinker $S$\nsuch that, as $\\lambda\\to\\infty$, the full family\n\\eqref{intro:rescalings} converges locally smoothly in space and with\nmultiplicity one to $\\sqrt{-s}\\,S$, uniformly for $s$ in compact\nsubintervals of $(-\\infty,0)$.  The convergence is in the original\nambient coordinates, including the axes and position of the limit.\nEvery backward integral Brakke tangent in the stated convention\ntherefore equals the area-measure flow of $\\sqrt{-s}\\,S$ at every\nnegative time."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:dd607ac071032488eeabf93058da57675b6d44967e5027bacc5933813c19f548","grain":"paper-statement","id":"Tangent-flow-uniqueness-2026-09-24#geo:tangent","title":"Tangent section and ends"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/407ba4bd6381d40c50668120.json","pointer":"/row"},"display":"Proposition","id":"r:Tangent-flow-uniqueness-2026-09-24:geo:tangent","manuscript_id":"p:Tangent-flow-uniqueness-2026-09-24","name":"Tangent section and ends","printed_number":"2.2","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/geometry.tex","label":"geo:tangent","line":90,"manuscript":"Tangent-flow-uniqueness-2026-09-24","statement_sha256":"6d3b913ff7496edf61957e319943ef15c184ca9bfd279841e607888f803f4d35"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Tangent-flow-uniqueness-2026-09-24.html#geo:tangent","section":2,"section_title":"Geometric input and normalization","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_