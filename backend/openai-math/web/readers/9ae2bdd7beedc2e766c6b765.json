th":"../rows/8a685c6f23693752bd6734d3.json","pointer":"/row"},"display":"Theorem","id":"r:Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026:thm:main","manuscript_id":"p:Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026","name":"thm:main","printed_number":"1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/source/main.tex","label":"thm:main","line":88,"manuscript":"Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026","statement_sha256":"880326b528f52e2650098ace17a638c1568485322d0ae6f83e470f59fa04bac7"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026.html#thm:main","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:2ca6dbc68145c227d8397384647f8fc27fed107ef3f967024e07826b260dbcda","file":"preprints/Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026/build/source/main.tex","line":88,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"880326b528f52e2650098ace17a638c1568485322d0ae6f83e470f59fa04bac7","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026/build/source/main.tex"},"sha256":"sha256:2ca6dbc68145c227d8397384647f8fc27fed107ef3f967024e07826b260dbcda","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026/build/source/main.tex#L88"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet \\(Q\\) be the interior of a nondegenerate Euclidean triangle with angles\n\\(\\alpha,\\beta,\\gamma\\). Suppose that at least one of\n\\[\n \\alpha/\\pi,\\qquad \\beta/\\pi,\\qquad \\gamma/\\pi\n\\]\nis irrational.\nThe unit-speed billiard flow \\(\\Phi_t\\), with specular reflection at the\nopen sides, is ergodic on \\(Q\\times S^1\\) for the probability measure\n\\[\n d\\mu=\\frac{dA\\,d\\theta}{2\\pi\\operatorname{Area}(Q)}.\n\\]\nHere trajectories hitting a vertex in either time direction are discarded.\nIn particular, if a measurable set \\(A\\) satisfies\n\\(\\mu(\\Phi_t^{-1}A\\mathbin\\triangle A)=0\\) for every \\(t\\in\\R\\), then\n\\(\\mu(A)\\in\\{0,1\\}\\)."},{"appendix":false,"contribution_target":{"fingerprint":"sha256:c4bbe55eca484bf24b2d8b85915dac5f873893ab97166a54a787f106d8b8e852","grain":"paper-statement","id":"Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026#prop:rigidity","title":"prop:rigidity"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/a98980d9826d91a7ebaef5f5.json","pointer":"/row"},"display":"Proposition","id":"r:Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026:prop:rigidity","manuscript_id":"p:Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026","name":"prop:rigidity","printed_number":"5","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/source/main.tex","label":"prop:rigidity","line":476,"manuscript":"Ergodicity-of-triangular-billiards-with-an-irrational-angle-September-25-2026","statement_sha