-introduction.tex","label":"cor:stable-finiteness","line":110,"manuscript":"A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026","statement_sha256":"8af11a4c1904451eaf09d40c3709ad344a8dd9d5e5384a6322d036141a1e1c0d"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026.html#cor:stable-finiteness","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:c8e8fe4edfb6291480e8f4f3e24350e6b12c4ee78412831a11da9c91490e9f3e","file":"preprints/A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026/build/01-introduction.tex","line":110,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8af11a4c1904451eaf09d40c3709ad344a8dd9d5e5384a6322d036141a1e1c0d","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026/build/01-introduction.tex"},"sha256":"sha256:c8e8fe4edfb6291480e8f4f3e24350e6b12c4ee78412831a11da9c91490e9f3e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026/build/01-introduction.tex#L110"},"statement_kind":"corollary","text":"\\label{cor:stable-finiteness}\n\\leavevmode\n\\begin{enumerate}[label=\\textup{(\\roman*)}]\n\\item There are two unital simple stably finite complex \\(C^*\\)-algebras\nwhose minimal tensor product is properly infinite. One factor can be\ntaken to be \\(C_r^*(\\mathbb F_2)\\).\n\\item There is a separable unital complex \\(C^*\\)-algebra \\(B\\) admitting\na normalized \\(2\\)-quasitrace such that\n\\(B\\otimes_{\\min}C_r^*(\\mathbb F_2)\\) is properly infinite and admits no\nnormalized \\(2\\)-quasitrace.\n\\item There is a separable unital stably finite complex \\(C^*\\)-algebra\nwith no tracial state.\n\\end{enumerate}"},{"appendix":false,"contribution_target":{"fingerprint":"sha256:7c51cfb3d1e10de12370cc346bd317854f7d58beb98b78f23a2c5834e01fc7d6","grain":"paper-statement","id":"A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026#thm:existence","title":"Quasitrace existence"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/f73a2859b1a02a455e7dc498.json","pointer":"/row"},"display":"Theorem","id":"r:A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026:thm:existence","manuscript_id":"p:A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026","name":"Quasitrace existence","printed_number":"2.1","printed_number_provenance":{"atlas_pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","binding":{"file":"build/02-preliminaries.tex","label":"thm:existence","line":31,"manuscript":"A-counterexample-to-Kaplanskys-quasitrace-conjecture-September-23-2026","statement_sha256":"72ca53d0af418d5d168671eeed9038bf706a02b6781bd2f8f6cf9a345cba73c0"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"755c4b729512c7e2c7d1d3303eb9706f5adf1681","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/A-counterexample-to-Kaplanskys-quasitrac