itory":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/d9c4ac08856e495d955ec592.json","pointer":"/row"},"display":"Corollary","id":"r:The-Blockwise-Alperin-Weight-Conjecture-September-23-2026:cor:block-consequences","manuscript_id":"p:The-Blockwise-Alperin-Weight-Conjecture-September-23-2026","name":"Local--global and principal-block bounds","printed_number":"1.2","printed_number_provenance":{"atlas_pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","binding":{"file":"build/sections/intro.tex","label":"cor:block-consequences","line":61,"manuscript":"The-Blockwise-Alperin-Weight-Conjecture-September-23-2026","statement_sha256":"2f73c22a385c96c9f4cb55c1d72234d577a0799c30122e5d1daafc9b7c0f66aa"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/The-Blockwise-Alperin-Weight-Conjecture-September-23-2026.html#cor:block-consequences","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:4b6f01e79b40c33f84a1d52e8ad579586765ab6db8133400d1eb5ba580c822ec","file":"preprints/The-Blockwise-Alperin-Weight-Conjecture-September-23-2026/build/sections/intro.tex","line":61,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"2f73c22a385c96c9f4cb55c1d72234d577a0799c30122e5d1daafc9b7c0f66aa","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Blockwise-Alperin-Weight-Conjecture-September-23-2026/build/sections/intro.tex"},"sha256":"sha256:4b6f01e79b40c33f84a1d52e8ad579586765ab6db8133400d1eb5ba580c822ec","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Blockwise-Alperin-Weight-Conjecture-September-23-2026/build/sections/intro.tex#L61"},"statement_kind":"corollary","text":"\\label{cor:block-consequences}\nLet $p$ be a prime, $G$ a finite group, $B$ a $p$-block with defect group\n$D$, and $b$ its Brauer correspondent in $N_G(D)$. Then\n\\[\n l(B)\\geq l(b),\\qquad\n D\\text{ abelian}\\Longrightarrow l(B)=l(b).\n\\]\nFor $P\\in\\operatorname{Syl}_p(G)$, one also has\n\\[\n |\\IBr_p(G)|\\geq|\\IBr_p(N_G(P))|.\n\\]\nLet $B_0$ be the principal $p$-block of $G$, and let $k_p(G)$ count the\nconjugacy classes of $p$-power-order elements, including the identity.\nThen\n\\[\n \\begin{aligned}\n k_p(G)=3&\\Longrightarrow l(B_0)\\geq (p-1)/2,\\\\\n p\\mid |G|&\\Longrightarrow l(B_0)\\geq 2\\sqrt{p-1}+1-k_p(G).\n \\end{aligned}\n\\]"},{"appendix":false,"contribution_target":{"fingerprint":"sha256:d053032fcd83b2a9a2e6c0ec3dfb48aa290040e6de1d2872fdeae7a33d930c17","grain":"paper-statement","id":"The-Blockwise-Alperin-Weight-Conjecture-September-23-2026#thm:tuple-divisibility","title":"Uniform divisibility for generating tuples"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/54e66c1360eddc644c8c0fba.json","pointer":"/row"},"display":"Theorem","id":"r:The-Blockwise-Alperin-Weight-Conjecture-September-23-2026:thm:tuple-divisibility","manuscript_id":"p:The-Blockwise-Alperin-Weight-Conjecture-September-23-2026","name":"Uniform divisibility for generating tuples","printed_number":"3.1","printed_number_provenance":{"atlas_pin":"6f7e5bf965eb85fac44ec93860c456b6a510b344","binding":{"file":"build/sections/group.tex","label":"thm:tuple-divisibility","line":10,"manuscript":"The-Blockwise-Alperin-Weight