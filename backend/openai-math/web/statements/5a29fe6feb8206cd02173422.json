ma":"statement-map-web/2","section":7,"section_title":"Compact obstructions in infinite-dimensional Banach spaces","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:1a14f7a5b466c786f23f1f05f109eccdec37f2e1c96c53130d44f908f83bb47f","file":"preprints/A-doubling-Hilbert-subset-with-no-finite-dimensional-bi-Lipschitz-embedding-September-25-2026/build/main.tex","line":418,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8435b8f8d04757fbb044dfc66dc283308fa303eb583e6d35509926728987f41a","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-doubling-Hilbert-subset-with-no-finite-dimensional-bi-Lipschitz-embedding-September-25-2026/build/main.tex"},"sha256":"sha256:1a14f7a5b466c786f23f1f05f109eccdec37f2e1c96c53130d44f908f83bb47f","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-doubling-Hilbert-subset-with-no-finite-dimensional-bi-Lipschitz-embedding-September-25-2026/build/main.tex#L418"},"statement_kind":"corollary","text":"\\label{cor:banach}\nThere is a universal constant $\\Lambda$ such that every infinite-dimensional real Banach space $B$ contains a compact subset $K_B$ whose doubling constant is at most $\\Lambda$ and which admits no bi-Lipschitz embedding into any finite-dimensional real normed space at any finite distortion. The subset $K_B$ may depend on $B$, but is chosen independently of the target dimension and distortion."}
