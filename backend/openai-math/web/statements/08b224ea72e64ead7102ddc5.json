nt_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:e703216a02a6833e45716492230ec2a272e4a9d21705ac2095f0af3c97e4f02e","file":"preprints/Ordinary-two-point-correlations-of-multiplicative-functions-September-24-2026/build/introduction.tex","line":64,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"b7eed160e0e4ab4cef20f50f9d8378e97ea4838159bffabf4633a557fa8bb538","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Ordinary-two-point-correlations-of-multiplicative-functions-September-24-2026/build/introduction.tex"},"sha256":"sha256:e703216a02a6833e45716492230ec2a272e4a9d21705ac2095f0af3c97e4f02e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Ordinary-two-point-correlations-of-multiplicative-functions-September-24-2026/build/introduction.tex#L64"},"statement_kind":"theorem","text":"\\label{thm:elliott}\nLet \\(f_1,f_2:\\N\\to\\mathbb D\\) be multiplicative, and suppose that\nat least one satisfies \\eqref{eq:unp}. For every fixed pair of distinct\nnonnegative integers \\(h_1,h_2\\),\n\\[\n \\frac1N\\sum_{n=1}^N f_1(n+h_1)f_2(n+h_2)\\longrightarrow0\n \\qquad(N\\longrightarrow\\infty,\\ N\\in\\N).\n\\]"}
