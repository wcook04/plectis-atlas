ource":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:f9dc0863877acfab17151b4e2e88c1804609169914b63b36e68344cb39bbf475","file":"preprints/Positive-Metric-Entropy-for-the-Standard-Map-at-Large-Parameters-September-23-2026/build/sections/introduction.tex","line":15,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"3e1cf60dfdf95ebe95929ceefa5cf4e34b0d6e1a5fb68fe7162a28fb5576ae01","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Positive-Metric-Entropy-for-the-Standard-Map-at-Large-Parameters-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:f9dc0863877acfab17151b4e2e88c1804609169914b63b36e68344cb39bbf475","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Positive-Metric-Entropy-for-the-Standard-Map-at-Large-Parameters-September-23-2026/build/sections/introduction.tex#L15"},"statement_kind":"theorem","text":"\\label{main:entropy}\nThere exists $k_0>0$ such that\n\\[\n h_m(f_k)>0\\qquad\\text{for every }k\\ge k_0.\n\\]\nEquivalently, for every such $k$ the largest Lyapunov exponent of $f_k$\nis positive on a set of positive $m$-measure."}
