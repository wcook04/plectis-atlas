atement_sha256":"sha256:9b7fa4069d064ca36274bf0e751364dc53ab74ab5d99a4368429a4ed09c15310","file":"preprints/Universal-strong-Kadison-Kastler-stability-September-23-2026/build/sections/01-introduction.tex","line":18,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"4d285c5e8f7cf2f2c6763f8eadf4a54f20f4f167f1e7861d9dcab1f741a00346","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Universal-strong-Kadison-Kastler-stability-September-23-2026/build/sections/01-introduction.tex"},"sha256":"sha256:9b7fa4069d064ca36274bf0e751364dc53ab74ab5d99a4368429a4ed09c15310","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Universal-strong-Kadison-Kastler-stability-September-23-2026/build/sections/01-introduction.tex#L18"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every $\\eps>0$ there is $\\delta=\\delta(\\eps)>0$ such that the\nfollowing holds. If $H$ is any complex Hilbert space and\n$M,N\\subseteq\\B(H)$ are unital von Neumann algebras with identity\n$I_H$ and $d(M,N)<\\delta$, there is a unitary $u\\in\\B(H)$ satisfying\n\\[\n uMu^*=N,\\qquad \\norm{u-I_H}<\\eps.\n\\]"}
