removed","current_statement_sha256":"sha256:877b40fae4fdc7a78e477f97730b4612d4a6ea80a2380ead2d65959cb365eb43","file":"preprints/An-explicit-failure-of-complex-affine-space-cancellation-September-23-2026/build/sections/01-introduction.tex","line":59,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"ccf3e37c739ce464433f83acdd37d4842e79f39fc5e2fb1beddf5a3f64bd0cc6","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/An-explicit-failure-of-complex-affine-space-cancellation-September-23-2026/build/sections/01-introduction.tex"},"sha256":"sha256:877b40fae4fdc7a78e477f97730b4612d4a6ea80a2380ead2d65959cb365eb43","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/An-explicit-failure-of-complex-affine-space-cancellation-September-23-2026/build/sections/01-introduction.tex#L59"},"statement_kind":"theorem","text":"\\label{thm:main}\nThe algebra $A$ in \\eqref{eq:example} is an integral complex algebra of\ndimension four. For an independent variable $w$,\n\\[\n A[w]\\simeq\\kk\\poly5,\n \\qquad\n A\\not\\simeq\\kk\\poly4.\n\\]\nConsequently the Zariski cancellation problem over the complex numbers has\na negative answer in dimension four."}
