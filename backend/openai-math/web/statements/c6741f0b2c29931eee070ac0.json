sh_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:a88f3d916e6fa75ee2bc72484d20e5598e54042783cc06cd4af8272a4c17f137","file":"preprints/Spontaneous-magnetization-in-the-quantum-Heisenberg-ferromagnet-September-24-2026/build/source/sections/00-introduction.tex","line":64,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"2d7a0cf297172f0f2ce7d9e48ae4576f0d08e295b130626ffd0aba00f184fc1f","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Spontaneous-magnetization-in-the-quantum-Heisenberg-ferromagnet-September-24-2026/build/source/sections/00-introduction.tex"},"sha256":"sha256:a88f3d916e6fa75ee2bc72484d20e5598e54042783cc06cd4af8272a4c17f137","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Spontaneous-magnetization-in-the-quantum-Heisenberg-ferromagnet-September-24-2026/build/source/sections/00-introduction.tex#L64"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every integer $d\\geq3$ and every\n$S\\in\\{\\frac12,1,\\frac32,\\ldots\\}$, there is a finite\n$\\beta_0(d,S)>0$ such that, for every finite $\\beta\\geq\\beta_0(d,S)$,\nthe dynamics associated with \\eqref{eq:hamiltonian} has a\ntranslation-invariant $\\beta$-KMS state $\\omega$ satisfying\n\\[\n                         \\omega(S_0^z)\\ge S/4.\n\\]"}
