"source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:4f8b8927c20f933cf8e6658844afcbfe0aaacc7a6f440dd4bfc8488848a5d78f","file":"preprints/Bi-Lipschitz-Absorption-of-c0-Without-a-Linear-Copy-of-c0-September-26-2026/build/sections/08-assembly.tex","line":29,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"d58a2c7792928931e92ba61182b7397c875aa24b1aa8de2cce93e3cb4c445753","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Bi-Lipschitz-Absorption-of-c0-Without-a-Linear-Copy-of-c0-September-26-2026/build/sections/08-assembly.tex"},"sha256":"sha256:4f8b8927c20f933cf8e6658844afcbfe0aaacc7a6f440dd4bfc8488848a5d78f","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Bi-Lipschitz-Absorption-of-c0-Without-a-Linear-Copy-of-c0-September-26-2026/build/sections/08-assembly.tex#L29"},"statement_kind":"corollary","text":"\\label{cor:same-space}\nFor this same separable real Banach space \\(Z\\):\n\\begin{enumerate}\n\\item \\(Z\\oplus_\\infty c_0\\) and \\(Z\\) are bi-Lipschitz equivalent\nbut not linearly isomorphic.\n\\item \\(c_0\\) embeds bi-Lipschitzly into \\(Z\\), although \\(Z\\)\ncontains no linear copy of \\(c_0\\).\n\\item Every separable metric space embeds bi-Lipschitzly into \\(Z\\).\n\\end{enumerate}"}
