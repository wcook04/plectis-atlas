n":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:ac8f39cf8648bff7de53c07c2552af6175d59b63fc723ffe1d956a9f282fb26b","file":"preprints/Brennans-conjecture-and-sharp-inverse-square-integral-means-September-24-2026/build/sections/00-introduction.tex","line":82,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8600348b7566066c5b61251d09b7266dcf46507f0d694691dac96d3a175e6307","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Brennans-conjecture-and-sharp-inverse-square-integral-means-September-24-2026/build/sections/00-introduction.tex"},"sha256":"sha256:ac8f39cf8648bff7de53c07c2552af6175d59b63fc723ffe1d956a9f282fb26b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Brennans-conjecture-and-sharp-inverse-square-integral-means-September-24-2026/build/sections/00-introduction.tex#L82"},"statement_kind":"corollary","text":"\\label{cor:sharp-endpoints}\nThe Koebe function $f(z)=z/(1-z)^2$ belongs to $\\SSS$ and satisfies\n\\[\n \\int_{\\DD}|f'|^{-2}\\dd A=\\infty,\n \\qquad\n \\int_{\\DD}|f'|^{2/3}\\dd A=\\infty.\n\\]\nIts inverse therefore fails area integrability at both $s=4$ and $s=4/3$."}
