ction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:ce6b2879526a90eaa4b36c21935d3eec5b9b20c2964015d28ac74a31c1f168d9","file":"preprints/A-Sharp-Threshold-Bound-for-Monotone-Graph-Properties-September-25-2026/build/sections/introduction.tex","line":12,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"7faa58fe3ade821265e63bc4c6cfcbdc8233a4acdbd0edd79aa6b62e0c6aa579","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-Sharp-Threshold-Bound-for-Monotone-Graph-Properties-September-25-2026/build/sections/introduction.tex"},"sha256":"sha256:ce6b2879526a90eaa4b36c21935d3eec5b9b20c2964015d28ac74a31c1f168d9","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-Sharp-Threshold-Bound-for-Monotone-Graph-Properties-September-25-2026/build/sections/introduction.tex#L12"},"statement_kind":"theorem","text":"\\label{thm:threshold}\nFor every integer $n\\ge2$, every nontrivial increasing family $\\mathcal P$ of graphs on $n$ vertices invariant under all vertex permutations, and every $0<\\varepsilon<1/2$,\n\\begin{equation}\n\\label{eq:threshold}\n p_{1-\\varepsilon}(\\mathcal P)-p_\\varepsilon(\\mathcal P)\n \\le \\frac{2^{19}}{(\\log n)^2}\\log\\frac1{2\\varepsilon}.\n\\end{equation}"}
