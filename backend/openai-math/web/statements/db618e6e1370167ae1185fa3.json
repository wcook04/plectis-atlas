sha256":"sha256:2690018bd97f22346613b73784b67f4f4e9c4d839f95e3731decb2fe0a18669b","file":"preprints/The-free-uniform-spanning-forest-is-a-factor-of-IID-September-25-2026/build/sections/introduction.tex","line":54,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"85f0b8ccf5865c6b098d25f7dd37a263e7be1fbe7e9956f3a75bb4a0a7b4d7ee","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-free-uniform-spanning-forest-is-a-factor-of-IID-September-25-2026/build/sections/introduction.tex"},"sha256":"sha256:2690018bd97f22346613b73784b67f4f4e9c4d839f95e3731decb2fe0a18669b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-free-uniform-spanning-forest-is-a-factor-of-IID-September-25-2026/build/sections/introduction.tex#L54"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is one Borel, root-independent, equivariant rule\n\\[\n \\Phi(G,U,e)\\in\\{0,1\\}\n\\]\nsuch that, for every infinite connected locally finite simple undirected\nunweighted graph $G$ and independent\n$\\operatorname{Uniform}[0,1]$ vertex labels $U=(U_v)_{v\\in V(G)}$, the entire\nedge set\n\\[\n \\{e\\in E(G):\\Phi(G,U,e)=1\\}\n\\]\nhas law $\\FUSF_G$."}
