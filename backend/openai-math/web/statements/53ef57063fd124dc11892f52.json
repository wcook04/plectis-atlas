,"current_statement_sha256":"sha256:8b65bad35988d75cb07be753747f1313c6b4bd8271138aebe485dc783e0e4cef","file":"preprints/Open-Homomorphisms-of-Global-Solvably-Closed-Galois-Groups-October-5-2026/build/sections/introduction.tex","line":11,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"9dff8f61c29a491edc29f158016bc64eff8560fd42164ec7a532b1eaebf03c4e","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Open-Homomorphisms-of-Global-Solvably-Closed-Galois-Groups-October-5-2026/build/sections/introduction.tex"},"sha256":"sha256:8b65bad35988d75cb07be753747f1313c6b4bd8271138aebe485dc783e0e4cef","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Open-Homomorphisms-of-Global-Solvably-Closed-Galois-Groups-October-5-2026/build/sections/introduction.tex#L11"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $F_1,F_2$ be number fields, and let $E_i/F_i$ be possibly infinite solvably closed Galois extensions. Every continuous open homomorphism\n\\[\n \\alpha:\\Gal(E_1/F_1)\\longrightarrow\\Gal(E_2/F_2)\n\\]\nis induced by a unique field embedding $j:E_2\\hookrightarrow E_1$."}
