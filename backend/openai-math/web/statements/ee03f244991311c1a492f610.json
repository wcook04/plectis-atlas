nt_statement_sha256":"sha256:2f71d5ede42da32ab68db71f8aa2f1bd0e139b6dd148bd72d25d2248fd38a274","file":"preprints/Positively-curved-Einstein-four-manifolds-September-23-2026/build/sections/01-introduction.tex","line":13,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"02c287d13631a2d4477bd27a3e0d3b2b82cd97585c996c39c47efe71fc800b25","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Positively-curved-Einstein-four-manifolds-September-23-2026/build/sections/01-introduction.tex"},"sha256":"sha256:2f71d5ede42da32ab68db71f8aa2f1bd0e139b6dd148bd72d25d2248fd38a274","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Positively-curved-Einstein-four-manifolds-September-23-2026/build/sections/01-introduction.tex#L13"},"statement_kind":"theorem","text":"\\label{thm:classification}\nLet $(M,g)$ be a connected smooth closed Einstein four-manifold with\nstrictly positive sectional curvature, without an orientability\nassumption. There is a constant $a>0$ such that $(M,ag)$ is isometric to\nthe standard round $S^4$, to $\\mathbb{CP}^2$ with its Fubini--Study\nmetric, or to $\\mathbb{RP}^4$ with its standard round metric."}
