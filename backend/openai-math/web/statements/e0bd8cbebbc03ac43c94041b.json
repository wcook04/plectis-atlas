c348336e65479345f34889fc014acd42550799f1440407a4f5de4","file":"preprints/Finite-Smith-Toda-Complexes-at-Varying-Primes-September-23-2026/build/sections/00-introduction.tex","line":29,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"dbe690f730f01222b1e51e1b3f4817b1c302a984ce9a1024c698070bdd3176b1","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Finite-Smith-Toda-Complexes-at-Varying-Primes-September-23-2026/build/sections/00-introduction.tex"},"sha256":"sha256:974f803e2f8c348336e65479345f34889fc014acd42550799f1440407a4f5de4","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Finite-Smith-Toda-Complexes-at-Varying-Primes-September-23-2026/build/sections/00-introduction.tex#L29"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every integer $n\\geq0$, there exist a prime $p$ and a finite\n$p$-local spectrum $X$ such that\n\\[\n \\BP_*X\\cong\\BP_*/(p,v_1,\\ldots,v_n)\n\\]\nas graded $\\BP_*\\BP$-comodules, with the canonical quotient coaction\nand generator in degree zero."}
