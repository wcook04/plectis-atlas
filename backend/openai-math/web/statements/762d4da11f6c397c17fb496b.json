:"sha256:ee38a279b129db1c58467d9a4ad5eaea3f219e405e0c0a0d50d759b2fd030e85","file":"preprints/The-joint-Dickman-law-for-consecutive-integers-September-24-2026/build/sections/introduction.tex","line":19,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"e3fd7e2506e4791ec3c1c57632d69b70f94008c932d25690d1288f8d42b5a0ff","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-joint-Dickman-law-for-consecutive-integers-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:ee38a279b129db1c58467d9a4ad5eaea3f219e405e0c0a0d50d759b2fd030e85","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-joint-Dickman-law-for-consecutive-integers-September-24-2026/build/sections/introduction.tex#L19"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every fixed $a,b\\in(0,1)$,\n\\[\n \\lim_{X\\to\\infty}\\frac1X\n \\#\\{2\\leq n\\leq X:\\Pplus(n)\\leq n^a,\n                         \\ \\Pplus(n+1)\\leq n^b\\}\n =\\rho(1/a)\\rho(1/b).\n\\]\nHere the limit is taken over all real $X$, with ordinary, unweighted\ncounting."}
