h_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:6afc9a677337cdbc6b262a6fd60d5a84ee39aa640ccd4fde88394f6a23521251","file":"preprints/Invariant-projection-counterexamples-for-every-irrational-rotation-September-27-2026/build/00-introduction.tex","line":33,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"deca3d9d85b3c934203895f4f2cab03f72ba46887f8e908cb330b311da4a447c","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Invariant-projection-counterexamples-for-every-irrational-rotation-September-27-2026/build/00-introduction.tex"},"sha256":"sha256:6afc9a677337cdbc6b262a6fd60d5a84ee39aa640ccd4fde88394f6a23521251","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Invariant-projection-counterexamples-for-every-irrational-rotation-September-27-2026/build/00-introduction.tex#L33"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every irrational $\\theta\\in(0,1)$ there exists a continuous function\n$f:\\T\\to[0,1]$ such that\n\\[\n f^{-1}(\\{0\\})=\\{1\\},\\qquad \\int_\\T\\log f\\,dm=-\\infty,\n\\]\nand every projection $p\\in R_\\theta$ satisfying $(1-p)Uf(V)p=0$\nis either $0$ or $1$."}
