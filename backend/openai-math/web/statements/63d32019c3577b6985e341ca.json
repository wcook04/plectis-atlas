t_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:279244fc2698a101557ecd64dde851efae59f7a62ea9ab208e87daec47023156","file":"preprints/A-translational-tile-with-no-fully-periodic-tiling-in-dimension-three-September-23-2026/build/paper.tex","line":79,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"5566e293463ff7d0c4463acb15896bf5853167f3017cc885bca544b729c04cb7","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-translational-tile-with-no-fully-periodic-tiling-in-dimension-three-September-23-2026/build/paper.tex"},"sha256":"sha256:279244fc2698a101557ecd64dde851efae59f7a62ea9ab208e87daec47023156","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-translational-tile-with-no-fully-periodic-tiling-in-dimension-three-September-23-2026/build/paper.tex#L79"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is a finite nonempty set $T\\subset\\Z^3$ such that:\n\\begin{enumerate}[label=\\textup{(\\roman*)}]\n\\item $T$ tiles $\\Z^3$ by translations, but no translation set $A$ with $A\\oplus T=\\Z^3$ is invariant under a subgroup of finite index in $\\Z^3$;\n\\item the set $\\Omega=T+[0,1]^3$ tiles $\\R^3$ by translations up to null sets, but no such tiling has a translation set invariant under a lattice of full rank in $\\R^3$.\n\\end{enumerate}"}
