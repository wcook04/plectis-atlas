itle":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:0cd6d0f3820827a19b27ab24da32078e66c91810656b3bdaedb6fec91485f58c","file":"preprints/A-cubic-lower-bound-for-border-determinantal-complexity-of-the-permanent-September-24-2026/build/source/sections/introduction.tex","line":41,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"6822902319e07397ed2aa09ba9e1378ebd4c680d2b918cb815c65b432603e497","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-cubic-lower-bound-for-border-determinantal-complexity-of-the-permanent-September-24-2026/build/source/sections/introduction.tex"},"sha256":"sha256:0cd6d0f3820827a19b27ab24da32078e66c91810656b3bdaedb6fec91485f58c","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-cubic-lower-bound-for-border-determinantal-complexity-of-the-permanent-September-24-2026/build/source/sections/introduction.tex#L41"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exist absolute constants $c>0$ and $m_0$ such that, for every integer\n$m\\ge m_0$,\n\\[\n \\bdc(\\per_m)\\ge c m^3.\n\\]\nOne may take $c=1/(5\\,529\\,600e)$ and $m_0=1408$."}
