d","current_statement_sha256":"sha256:f9bc9812a997e3f046f66768ba2276e26a6c75150e7dd15e9674a385ca18e7cc","file":"preprints/Bounded-degree-coboundary-expanders-in-every-dimension-September-24-2026/build/source/sections/introduction.tex","line":40,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"c3764d72923eee33c5cfc897f61a67737f27cab48b6da1bda18a44d6e06d6d49","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Bounded-degree-coboundary-expanders-in-every-dimension-September-24-2026/build/source/sections/introduction.tex"},"sha256":"sha256:f9bc9812a997e3f046f66768ba2276e26a6c75150e7dd15e9674a385ca18e7cc","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Bounded-degree-coboundary-expanders-in-every-dimension-September-24-2026/build/source/sections/introduction.tex#L40"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every integer $d\\ge3$, there exist constants $D<\\infty$, $\\eps>0$,\nand finite connected pure $d$-dimensional simplicial complexes $X_m$,\nwith $|X_m(0)|\\longrightarrow\\infty$, such that every vertex belongs to\nat most $D$ faces of dimension $d$ and, for every\n$f\\in C^i(X_m;\\F)$,\n\\begin{equation}\\label{eq:goal}\n \\norm{\\delta_i f}_{X_m,i+1}\n \\ge \\eps\\,\\dist_{X_m,i}(f,B^i(X_m))\n \\qquad(0\\le i<d).\n\\end{equation}\nThe constants are independent of $m$, $i$, and $f$."}
