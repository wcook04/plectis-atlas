p-web/2","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:99c31cf5a329e0ee3773a31d90f0c0b3cee0ed0f4d128aae0601aec25511454e","file":"preprints/Blochs-Conjecture-for-Surfaces-with-pg-equals-q-equals-0-September-24-2026/build/sections/introduction.tex","line":31,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"7f1e06d1295ed00df48c851d7f7663a2d5aa98272d3f43222eaa33d4893b1ac9","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Blochs-Conjecture-for-Surfaces-with-pg-equals-q-equals-0-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:99c31cf5a329e0ee3773a31d90f0c0b3cee0ed0f4d128aae0601aec25511454e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Blochs-Conjecture-for-Surfaces-with-pg-equals-q-equals-0-September-24-2026/build/sections/introduction.tex#L31"},"statement_kind":"corollary","text":"\\label{cor:bloch-pg-zero}\nLet \\(S\\) be a smooth connected projective surface over \\(\\mathbb C\\)\nwith \\(p_g(S)=0\\). Then the Albanese homomorphism\n\\[\n\\operatorname{alb}_S:\\CH_0(S)^0\\longrightarrow\\Alb(S)(\\mathbb C)\n\\]\nis an isomorphism of abelian groups, where \\(\\CH_0(S)\\) has integral\ncoefficients."}
