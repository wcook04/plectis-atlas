tatement_sha256":"sha256:a037ee3c69aae95b48b4dfe7d0808847437c6b4c73d4b5779f661f7a6649aeb0","file":"preprints/De-Giorgis-conjecture-in-dimension-eight-September-26-2026/build/sections/00-introduction.tex","line":103,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"abbc449e6b27b758dfe95ffb3f57c3fb753e28cc9cb459ee7fc6d87379ffaf9a","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/De-Giorgis-conjecture-in-dimension-eight-September-26-2026/build/sections/00-introduction.tex"},"sha256":"sha256:a037ee3c69aae95b48b4dfe7d0808847437c6b4c73d4b5779f661f7a6649aeb0","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/De-Giorgis-conjecture-in-dimension-eight-September-26-2026/build/sections/00-introduction.tex#L103"},"statement_kind":"theorem","text":"\\label{thm:stable}\nLet $v\\in C^2(\\R^7,[-1,1])$ be a stable solution of\n$\\Delta v=v^3-v$.  Then either $v\\equiv1$, $v\\equiv-1$, or\n\\[\n v(x)=\\tanh\\!\\left(\\frac{a\\cdot x-b}{\\sqrt2}\\right)\n \\qquad\\text{for some }a\\in\\mathbb S^6,\\ b\\in\\R.\n\\]\nNo energy-growth assumption is required."}
