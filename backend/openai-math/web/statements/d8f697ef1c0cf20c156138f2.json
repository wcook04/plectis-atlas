ent_statement_sha256":"sha256:6be428d298fec5c9172bed2488b5366b24179fe43113968e3ed58437becc35b1","file":"preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex","line":35,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"a27eba0a3bc2ef195a070b06e2c4247b6b6bcd4bbdbe5b03ff657049cdd4e398","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex"},"sha256":"sha256:6be428d298fec5c9172bed2488b5366b24179fe43113968e3ed58437becc35b1","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Euclidean-Steinitz-Bergstrom-theorem-September-24-2026/build/introduction.tex#L35"},"statement_kind":"theorem","text":"\\label{thm:steinitz}\nThere is an absolute constant $C$ such that, for all integers $d,N\\ge1$ and\nevery indexed family $v_1,\\ldots,v_N\\in\\R^d$ satisfying\n$\\lVert v_i\\rVert_2\\le1$ and $\\sum_{i=1}^N v_i=0$, some permutation\n$\\pi\\in\\mathfrak S_N$ satisfies\n\\[\n \\max_{0\\le k\\le N}\\left\\lVert\\sum_{i=1}^k v_{\\pi(i)}\\right\\rVert_2\n \\le C\\sqrt d.\n\\]\nThe constant in Theorem~\\ref{thm:signing} also suffices here."}
