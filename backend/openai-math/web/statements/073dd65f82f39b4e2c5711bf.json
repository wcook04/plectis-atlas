statement_sha256":"sha256:3aeedb904a3b0f6db90e6f4a205986280d4ed1edfdc14d6706fe3e9cf1e340b5","file":"preprints/The-logarithmic-Brunn-Minkowski-conjecture-September-23-2026/build/introduction.tex","line":55,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"b7268b1f76d35c5b88859d07ee0851420525ee39da1ba0eb38828ca580b16b46","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-logarithmic-Brunn-Minkowski-conjecture-September-23-2026/build/introduction.tex"},"sha256":"sha256:3aeedb904a3b0f6db90e6f4a205986280d4ed1edfdc14d6706fe3e9cf1e340b5","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-logarithmic-Brunn-Minkowski-conjecture-September-23-2026/build/introduction.tex#L55"},"statement_kind":"corollary","text":"\\label{cor:lp}\nLet $n\\ge1$, let $K,L\\subset\\R^n$ be full-dimensional origin-symmetric\nconvex bodies, and let $0<p<1$. For every $0\\le\\lambda\\le1$,\n\\begin{equation}\\label{eq:lp}\n \\left|\\mathcal W\\!\\left[\n  \\bigl((1-\\lambda)h_K^p+\\lambda h_L^p\\bigr)^{1/p}\n \\right]\\right|^{p/n}\n \\ge (1-\\lambda)|K|^{p/n}+\\lambda|L|^{p/n}.\n\\end{equation}"}
