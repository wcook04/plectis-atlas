sh_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:034952fd594ec75e2d2f3db16f1d40f0a9b23f7956bf3acc22d4ec5ea0457af5","file":"preprints/An-Endpoint-Gradient-Bound-for-the-Centered-Disk-Maximal-Operator-September-26-2026/build/sections/introduction.tex","line":19,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8e9d0b3002dae169950225e0d246ebe7ec790769cf3ed14a947b4438bedc5c26","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/An-Endpoint-Gradient-Bound-for-the-Centered-Disk-Maximal-Operator-September-26-2026/build/sections/introduction.tex"},"sha256":"sha256:034952fd594ec75e2d2f3db16f1d40f0a9b23f7956bf3acc22d4ec5ea0457af5","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/An-Endpoint-Gradient-Bound-for-the-Centered-Disk-Maximal-Operator-September-26-2026/build/sections/introduction.tex#L19"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is an absolute constant $C<\\infty$ such that, for every\nreal-valued $f\\in W^{1,1}(\\R^2)$, the function $Mf$ is locally\nintegrable, belongs to $W^{1,1}_{\\mathrm{loc}}(\\R^2)$, and satisfies\n\\begin{equation}\\label{eq:main}\n \\int_{\\R^2}|\\nabla Mf|\\,\\dd x\n \\le C\\int_{\\R^2}|\\nabla f|\\,\\dd x.\n\\end{equation}\nIn particular, its distributional derivatives are represented by\nglobally integrable functions."}
