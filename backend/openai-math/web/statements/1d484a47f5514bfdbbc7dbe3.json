mments-removed","current_statement_sha256":"sha256:81049a2f26f12be12dae7ccbf3b8f767c1cd2892cea6b8056b33dc01e3334392","file":"preprints/Balanced-Counterexamples-to-Rysers-Conjecture-at-Prime-Orders-September-27-2026/build/paper.tex","line":121,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"ece4e578edc3355ac2f926d4addb39a8d476194c3aab886bfc008c37a1870fc5","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Balanced-Counterexamples-to-Rysers-Conjecture-at-Prime-Orders-September-27-2026/build/paper.tex"},"sha256":"sha256:81049a2f26f12be12dae7ccbf3b8f767c1cd2892cea6b8056b33dc01e3334392","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Balanced-Counterexamples-to-Rysers-Conjecture-at-Prime-Orders-September-27-2026/build/paper.tex#L121"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exists $q_0$ such that, for every prime $q\\ge q_0$, there is a\nfinite intersecting $(q+1)$-partite $(q+1)$-uniform hypergraph $H$ with\n\\[\n |V_1|=\\cdots=|V_{q+1}|=q+1,\n \\qquad \\tau(H)=q+1.\n\\]\nEvery vertex belongs to an edge."}
