rent_statement_sha256":"sha256:e60f3180448134daae2be220a98e99ab45293d4804d823f552074500765f8956","file":"preprints/A-counterexample-to-Sidorenkos-conjecture-September-23-2026/build/sections/introduction.tex","line":335,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"ae0c55b2610ae12a6dea6d62bad8fe9d6a0b0a54ab5cfc10b79d2ab52cba6d83","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-counterexample-to-Sidorenkos-conjecture-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:e60f3180448134daae2be220a98e99ab45293d4804d823f552074500765f8956","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-counterexample-to-Sidorenkos-conjecture-September-23-2026/build/sections/introduction.tex#L335"},"statement_kind":"corollary","text":"\\label{cor:forcing}\nFor the same connected bipartite graph \\(H\\) of\nTheorem~\\ref{thm:main}, there are \\(p\\in(0,1)\\) and a nonconstant\ngraphon \\(W\\) such that\n\\[\nt(K_2,W)=p,\\qquad t(H,W)=p^{66}.\n\\]\nConsequently, \\(H\\) is not \\(p\\)-forcing at this density and hence is\nnot forcing, despite being bipartite and containing a cycle."}
