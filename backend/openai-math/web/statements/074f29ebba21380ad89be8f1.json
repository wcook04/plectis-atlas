atement_sha256":"sha256:d546dec849236b21693a7b5ef316d3421917965485f0088ba3081ac537cf0d0c","file":"preprints/Unbounded-Violations-of-the-Square-Root-Degree-Bound-September-26-2026/build/sections/00-introduction.tex","line":23,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"0351ff5b8e88f144007acf9dc43fe10171e06b66d24fe2f25b535c025f99a550","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Unbounded-Violations-of-the-Square-Root-Degree-Bound-September-26-2026/build/sections/00-introduction.tex"},"sha256":"sha256:d546dec849236b21693a7b5ef316d3421917965485f0088ba3081ac537cf0d0c","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Unbounded-Violations-of-the-Square-Root-Degree-Bound-September-26-2026/build/sections/00-introduction.tex#L23"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every real \\(C>0\\), there are a positive integer \\(n\\) and a\nnonconstant Boolean function \\(f:\\{-1,1\\}^n\\to\\{-1,1\\}\\) such that\n\\[\n \\sum_{i=1}^n\\widehat f(\\{i\\})>C\\sqrt{\\deg(f)}.\n\\]\nConsequently,\n\\[\n \\sup_{\\substack{n\\ge1,\\ f:\\{-1,1\\}^n\\to\\{-1,1\\}\\\\\\deg(f)>0}}\n \\frac{\\sum_i|\\widehat f(\\{i\\})|}{\\sqrt{\\deg(f)}}=\\infty.\n\\]"}
