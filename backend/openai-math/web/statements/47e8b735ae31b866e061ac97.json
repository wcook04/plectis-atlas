ment_sha256":"sha256:9dcded0014d1224046703926080d5cf46c99749dbd23e800d17000b182a8dd49","file":"preprints/A-counterexample-to-the-nearby-Lagrangian-conjecture-September-23-2026/build/sections/introduction.tex","line":25,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8303422bc736755e49344f7efdc1cc2557743894ecaf93c308efed47027a6c42","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-counterexample-to-the-nearby-Lagrangian-conjecture-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:9dcded0014d1224046703926080d5cf46c99749dbd23e800d17000b182a8dd49","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-counterexample-to-the-nearby-Lagrangian-conjecture-September-23-2026/build/sections/introduction.tex#L25"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor some sufficiently large even integer $N$, the manifold\n$Q=S^9\\times S^{N-1}$ admits a closed exact smoothly embedded Lagrangian\n$L\\subset T^*Q$ such that $L$ is diffeomorphic to $Q$ and no compactly\nsupported Hamiltonian isotopy carries the zero section to $L$."}
