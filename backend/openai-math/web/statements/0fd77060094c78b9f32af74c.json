tex-environment-body-comments-removed","current_statement_sha256":"sha256:da35f94fd734024fd7836ed99eb103b63b953dfc4204e8c480aaeaabc0e083c2","file":"preprints/Almost-everywhere-Fourier-convergence-in-L-log-L-September-23-2026/build/sections/01-introduction.tex","line":17,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"6656f4937453b597e14e07946a2b1cc3db91da0b6192aa8e620344b665fbdd18","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Almost-everywhere-Fourier-convergence-in-L-log-L-September-23-2026/build/sections/01-introduction.tex"},"sha256":"sha256:da35f94fd734024fd7836ed99eb103b63b953dfc4204e8c480aaeaabc0e083c2","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Almost-everywhere-Fourier-convergence-in-L-log-L-September-23-2026/build/sections/01-introduction.tex#L17"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every complex-valued $f\\in L\\log L(\\mathbb T)$, there is a measurable\nset $N_f$ of measure zero such that\n\\[\n \\lim_{N\\to\\infty}S_Nf(x)=f(x)\n \\qquad (x\\in\\mathbb T\\setminus N_f).\n\\]\nThe limit is along the full sequence $N=0,1,2,\\ldots$."}
