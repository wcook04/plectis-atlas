od":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:75b137c6f2f8da85765996d8aeb1418216b35c926228d2b1d76303734dc34366","file":"preprints/Ordinary-two-point-correlations-of-multiplicative-functions-September-24-2026/build/introduction.tex","line":81,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"2e7db94053fe09155a4745aa14ee687e64e410d0a49ed9ee50d6242adcc51265","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Ordinary-two-point-correlations-of-multiplicative-functions-September-24-2026/build/introduction.tex"},"sha256":"sha256:75b137c6f2f8da85765996d8aeb1418216b35c926228d2b1d76303734dc34366","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Ordinary-two-point-correlations-of-multiplicative-functions-September-24-2026/build/introduction.tex#L81"},"statement_kind":"corollary","text":"\\label{cor:affine}\nLet \\(f_1,f_2:\\N\\to\\mathbb D\\) be multiplicative, with at least one\nsatisfying \\eqref{eq:unp}. For all fixed integers \\(a_1,a_2\\ge1\\) and\n\\(b_1,b_2\\ge0\\) with \\(a_1b_2-a_2b_1\\ne0\\),\n\\[\n \\frac1N\\sum_{n=1}^N f_1(a_1n+b_1)f_2(a_2n+b_2)\n \\longrightarrow0.\n\\]"}
