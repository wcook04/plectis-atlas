mments-removed","current_statement_sha256":"sha256:74fe6113083ab7f1fccd14aa3126da2b89da5476c5113dc92adced0e62fba06b","file":"preprints/The-Kirchberg-Rordam-character-criterion-September-25-2026/build/sections/introduction.tex","line":70,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"05987c45d59e6d363addc6b7ab616efaf65c63b1f0898801af5f7dc4667c9d25","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Kirchberg-Rordam-character-criterion-September-25-2026/build/sections/introduction.tex"},"sha256":"sha256:74fe6113083ab7f1fccd14aa3126da2b89da5476c5113dc92adced0e62fba06b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Kirchberg-Rordam-character-criterion-September-25-2026/build/sections/introduction.tex#L70"},"statement_kind":"corollary","text":"\\label{cor:infinite-tensor}\nLet $D$ be a nonzero unital separable complex $C^*$-algebra without\ncharacters, and write\n\\[\n B=D^{\\otimes_{\\min}\\infty}\n :=\\varinjlim_{n\\ge1}\n \\bigl(D^{\\otimes_{\\min}n},\\,x\\longmapsto x\\otimes1_D\\bigr).\n\\]\nThen $B\\cong B\\otmin\\Z$, and $B$ contains a unital copy of $\\Z$."}
