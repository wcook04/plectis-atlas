oved","current_statement_sha256":"sha256:17a30a0c5180177f8912d617ee49460f8a6cf740c7d4a31026b91f6bf875c6ec","file":"preprints/The-Mahler-Conjecture-for-General-Convex-Bodies-September-22-2026/build/sections/00-introduction.tex","line":26,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"2c192b9dc772d130b62c75fc92b698f020ff9713d26beb2684bee845acb579ef","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Mahler-Conjecture-for-General-Convex-Bodies-September-22-2026/build/sections/00-introduction.tex"},"sha256":"sha256:17a30a0c5180177f8912d617ee49460f8a6cf740c7d4a31026b91f6bf875c6ec","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Mahler-Conjecture-for-General-Convex-Bodies-September-22-2026/build/sections/00-introduction.tex#L26"},"statement_kind":"theorem","text":"\\label{thm:mahler}\nFor every integer $n\\ge1$ and every convex body $K\\subset\\mathbb R^n$,\n\\[\n                 P(K)\\ge\\frac{(n+1)^{n+1}}{(n!)^2}.\n\\]\nEquality holds if and only if $K$ is a simplex."}
