nt_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:b9c4a6e0ee2e9c29bcc982a11763beffb2f4631931b8c8d33807f0b3341e28a1","file":"preprints/Entropy-and-Face-Dimension-of-the-Perfect-Matching-Polytope-September-23-2026/build/sections/01-introduction.tex","line":33,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"e9ab6a5aec2525c1539f4fc7d84f1786c89c1148ce378a3d706bf97c88849878","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Entropy-and-Face-Dimension-of-the-Perfect-Matching-Polytope-September-23-2026/build/sections/01-introduction.tex"},"sha256":"sha256:b9c4a6e0ee2e9c29bcc982a11763beffb2f4631931b8c8d33807f0b3341e28a1","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Entropy-and-Face-Dimension-of-the-Perfect-Matching-Polytope-September-23-2026/build/sections/01-introduction.tex#L33"},"statement_kind":"theorem","text":"\\label{ent:main}\nLet $G$ be a loopless multigraph on $2m\\ge2$ vertices with at least one\nperfect matching. For every $x\\in P(G)$,\n\\begin{equation}\\label{intro:main-bound}\n                  F(x)-\\left(2-\\frac2m\\right)B(x)\n                  \\le H(x)\\le F(x).\n\\end{equation}"}
