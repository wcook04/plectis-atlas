tion_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:e5e9f32bf23a1cd00790abe185b2e43bbe6ff58ccf2896a80d5ea74e0aea901d","file":"preprints/A-finite-entropy-separation-of-microstates-and-nonmicrostates-free-entropy-September-25-2026/build/sections/01-introduction.tex","line":42,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8f075cb032c5064a1ddf45b95f426370d324adc051f76009e00fc0e95816ff70","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-finite-entropy-separation-of-microstates-and-nonmicrostates-free-entropy-September-25-2026/build/sections/01-introduction.tex"},"sha256":"sha256:e5e9f32bf23a1cd00790abe185b2e43bbe6ff58ccf2896a80d5ea74e0aea901d","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-finite-entropy-separation-of-microstates-and-nonmicrostates-free-entropy-September-25-2026/build/sections/01-introduction.tex#L42"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exist an integer $n\\geq2$ and a bounded self-adjoint tuple\n$X=(X_1,\\ldots,X_n)$ in a von Neumann algebra with faithful normal\ntracial state such that\n\\[\n -\\infty<\\chi(X)\\leq\\chi^*(X)-\\tfrac12<\\infty.\n\\]\nHere $\\chi$ is the original microstates entropy using an operator-norm\ncutoff and a limsup over matrix sizes."}
