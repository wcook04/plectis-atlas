":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:da82971558f47b59c01a28cc98fec01b0d683758ace8a5d796da739cf1e4830e","file":"preprints/Universal-cover-splitting-for-compact-Kahler-manifolds-September-23-2026/build/intro.tex","line":126,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"94bca75d2eead1808e91b11962ae281c1e51876252ec4bb677718a183a72f63f","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Universal-cover-splitting-for-compact-Kahler-manifolds-September-23-2026/build/intro.tex"},"sha256":"sha256:da82971558f47b59c01a28cc98fec01b0d683758ace8a5d796da739cf1e4830e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Universal-cover-splitting-for-compact-Kahler-manifolds-September-23-2026/build/intro.tex#L126"},"statement_kind":"corollary","text":"\\label{cor:non-uniruled}\nLet $X$ be a smooth connected non-uniruled projective complex manifold,\nand let $T_X=E_1\\oplus E_2$ be a specified holomorphic splitting into\nsubbundles of positive ranks. Then both summands are integrable and the\nordinary universal cover has a compatible product decomposition as in\nTheorem~\\ref{thm:main}."}
