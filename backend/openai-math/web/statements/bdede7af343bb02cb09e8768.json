rent_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:a8b7793f86e20e5ea7a590241626ba29bada4f917366fbe83a014e425572201c","file":"preprints/Relative-independence-of-the-separable-quotient-problem-September-23-2026/build/sections/evaluation.tex","line":81,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"bf4c7ea68050b841db1fed8dc9ce9cb8c574b89fc1f77708db633a939375ac25","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Relative-independence-of-the-separable-quotient-problem-September-23-2026/build/sections/evaluation.tex"},"sha256":"sha256:a8b7793f86e20e5ea7a590241626ba29bada4f917366fbe83a014e425572201c","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Relative-independence-of-the-separable-quotient-problem-September-23-2026/build/sections/evaluation.tex#L81"},"statement_kind":"proposition","text":"\\label{ev:criterion}\nFor an infinite-dimensional real or complex Banach space $X$, the following\nare equivalent:\n\\begin{enumerate}\n\\item $X$ admits a bounded linear surjection onto a separable\n      infinite-dimensional Banach space.\n\\item There is a closed infinite-dimensional subspace $F\\subset X^*$\n      for which $R_F(X)$ is norm separable.\n\\end{enumerate}\nIn the second assertion, $F$ may be required to be separable."}
