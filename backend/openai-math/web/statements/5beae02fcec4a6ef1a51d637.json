:"sha256:b7cedbbd9f4190c3401de7ca685dba4a497982357d946770edd26603cce56078","file":"preprints/Close-Separable-Cstar-Algebras-Without-Spatial-Conjugacy-October-5-2026/build/main.tex","line":67,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"5176031cd69d355afcbcdede7d6228273798a55483554273cabacb2a31143a19","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Close-Separable-Cstar-Algebras-Without-Spatial-Conjugacy-October-5-2026/build/main.tex"},"sha256":"sha256:b7cedbbd9f4190c3401de7ca685dba4a497982357d946770edd26603cce56078","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Close-Separable-Cstar-Algebras-Without-Spatial-Conjugacy-October-5-2026/build/main.tex#L67"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every $\\varepsilon>0$ there are a separable complex Hilbert space $H$\nand unital, norm-separable $C^*$-algebras $A,B\\subseteq\\B(H)$ with common\nidentity $\\id_H$ such that\n\\[\n\\KK(A,B)<\\varepsilon,\\qquad A''=B'',\n\\]\nbut no unitary $u\\in\\B(H)$ satisfies $uAu^*=B$."}
