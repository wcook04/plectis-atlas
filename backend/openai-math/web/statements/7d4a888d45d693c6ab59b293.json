_statement_sha256":"sha256:c5152104fa79dfd0e039220acb3dd5516479db671839230b03dc69242c23703e","file":"preprints/Exact-asymptotic-moduli-in-a-Daugavet-subspace-of-L1-September-27-2026/build/sections/introduction.tex","line":63,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"92c7842bfd0337a47964839f8cd61df39980918a32328913393d0124189ee444","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Exact-asymptotic-moduli-in-a-Daugavet-subspace-of-L1-September-27-2026/build/sections/introduction.tex"},"sha256":"sha256:c5152104fa79dfd0e039220acb3dd5516479db671839230b03dc69242c23703e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Exact-asymptotic-moduli-in-a-Daugavet-subspace-of-L1-September-27-2026/build/sections/introduction.tex#L63"},"statement_kind":"theorem","text":"\\label{thm:exact}\nLet $E$ be an infinite-dimensional closed real subspace of\n$L^1(\\Omega,\\mathbb P)$, where $\\mathbb P$ is a probability measure.\nSuppose its closed unit ball is totally bounded for convergence in\nmeasure and its inherited norm has the Daugavet property.  Then every\n$x\\in S_E$ and $t>0$ satisfy\n\\[\n H_E(x,t)=\\max\\{t/2,t-1\\},\\qquad\n D_E(x,t)=\\max\\{0,t-2\\}.\n\\]\nConsequently these are also the formulas for\n$\\widehat\\delta_E(t)$ and $\\overline\\delta_E(t)$.  The space $E$ admits\nno equivalent AUC norm."}
