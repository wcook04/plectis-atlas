atement_sha256":"sha256:9ca2d4045664992aab34b37aedcf73799893b730623039f7b3dd579fcaeb7c03","file":"preprints/Exponential-decay-in-two-dimensional-classical-On-models-September-23-2026/build/main.tex","line":76,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8c72e1b06ed93dc56ac9b554f1e3a9753bc3f0262bab76ef24ccc196cf11a1b1","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Exponential-decay-in-two-dimensional-classical-On-models-September-23-2026/build/main.tex"},"sha256":"sha256:9ca2d4045664992aab34b37aedcf73799893b730623039f7b3dd579fcaeb7c03","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Exponential-decay-in-two-dimensional-classical-On-models-September-23-2026/build/main.tex#L76"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every integer $n\\ge3$ and every finite $\\beta>0$, there are constants\n$A=A(n,\\beta)<\\infty$ and $m=m(n,\\beta)>0$ such that, for every finite\nnearest-neighbor square-lattice subgraph $G$, every strength array\n$b\\in[0,\\beta]^E$, and all $x,y\\in V$,\n\\begin{equation}\n 0\\le \\langle\\sigma_x\\cdot\\sigma_y\\rangle_{G,b}^{(n)}\n \\le A\\exp(-m\\|x-y\\|_2).\n \\label{eq:main-bound}\n\\end{equation}"}
