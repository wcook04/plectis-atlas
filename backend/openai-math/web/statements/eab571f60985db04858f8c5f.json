{"appendix":false,"contribution_target":{"fingerprint":"sha256:752a3f532b5cffd3d51ec84df047adcf9d3f4e7143ae626995ecb42187986284","grain":"paper-statement","id":"Weak-Hessian-bounds-along-every-geodesic-in-RCD-spaces-September-24-2026#weight:every-geodesic","title":"Weak Hessian bounds along every geodesic"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/92dfde38223469b18defc843.json","pointer":"/row"},"display":"Theorem","generation_id":"sha256:eb85d3603ec7254e8723f8292d2014fbb295087c537d4a9a7c22689061a82822","id":"r:Weak-Hessian-bounds-along-every-geodesic-in-RCD-spaces-September-24-2026:weight:every-geodesic","kind":"statement-detail","manuscript_id":"p:Weak-Hessian-bounds-along-every-geodesic-in-RCD-spaces-September-24-2026","name":"Weak Hessian bounds along every geodesic","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","printed_number":"1.1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/introduction.tex","label":"weight:every-geodesic","line":52,"manuscript":"Weak-Hessian-bounds-along-every-geodesic-in-RCD-spaces-September-24-2026","statement_sha256":"0c6701bc0fcaa68fecbc98186919da9fca7b87d49d188af800fcc303e614e627"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/Weak-Hessian-bounds-along-every-geodesic-in-RCD-spaces-September-24-2026.html#weight:every-geodesic","release_id":"openai-math","schema":"statement-map-web/2","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:983177bee6782af9b23a0f04b53b18d014a43aafd0d599ba5468f6d98ac8bbc0","file":"preprints/Weak-Hessian-bounds-along-every-geodesic-in-RCD-spaces-September-24-2026/build/sections/introduction.tex","line":52,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"0c6701bc0fcaa68fecbc98186919da9fca7b87d49d188af800fcc303e614e627","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Weak-Hessian-bounds-along-every-geodesic-in-RCD-spaces-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:983177bee6782af9b23a0f04b53b18d014a43aafd0d599ba5468f6d98ac8bbc0","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Weak-Hessian-bounds-along-every-geodesic-in-RCD-spaces-September-24-2026/build/sections/introduction.tex#L52"},"statement_kind":"theorem","text":"\\label{weight:every-geodesic}\nLet \\((M,d,m)\\) be a full-support \\(\\RCD(K,N)\\) space,\nwhere \\(K\\in\\mathbb R\\) and \\(1<N<\\infty\\). Let\n\\(F\\colon M\\to\\mathbb R\\) be bounded and globally Lipschitz,\nand let \\(G\\colon M\\to\\mathbb R\\) be bounded and continuous.\nSuppose that for every compactly supported \\(g\\in\\Test(M)\\)\nand every nonnegative \\(h\\in\\Lip_c(M)\\),\n\\begin{equation}\n\\label{weight:hessian-assumption}\nH_F(\\nabla g,\\nabla g)(h)\n\\le\\int_M hG\\Gamma(g)\\dd m.\n\\end{equation}\nThen every constant-speed minimizing geodesic\n\\(\\sigma\\colon[0,1]\\to M\\), of length \\(\\ell\\), satisfies\n\\begin{equation}\n\\label{weight:curve-hessian}\n(F\\circ\\sigma)''\\le\\ell^2G\\circ\\sigma\n\\qquad\\text{in distributions on }(0,1).\n\\end{equation}"}
