mments-removed","current_statement_sha256":"sha256:9e3c68363f773a94189b66fe181515234b3b3a9c652babb2c44681364c6e85be","file":"preprints/Maximal-Seshadri-Constants-on-Arbitrary-Polarized-Surfaces-September-23-2026/build/sections/introduction.tex","line":31,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"56bab251e8631d3896097eb2304e9fbaaabfa80560abd5698fc18030a33bd776","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Maximal-Seshadri-Constants-on-Arbitrary-Polarized-Surfaces-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:9e3c68363f773a94189b66fe181515234b3b3a9c652babb2c44681364c6e85be","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Maximal-Seshadri-Constants-on-Arbitrary-Polarized-Surfaces-September-23-2026/build/sections/introduction.tex#L31"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every smooth integral complex projective surface $S$ and every ample\nline bundle $L$ on $S$, there is an integer $r_0=r_0(S,L)$ with the following\nproperty. For each integer $r\\ge r_0$, there is a countable union\n$Z_r$ of proper Zariski-closed subsets of $U_r$, with nonempty complement,\nsuch that for every $\\mathbf p\\in U_r\\setminus Z_r$ the class\n\\[\n \\pi^*L-\\sqrt{\\frac{L^2}{r}}\\sum_{i=1}^r E_i\n\\]\nis nef on the blow-up at $\\mathbf p$. Consequently,\n\\[\n \\varepsilon(S,L;\\mathbf p)=\\sqrt{\\frac{L^2}{r}}.\n\\]"}
