,"current_statement_sha256":"sha256:af85192d88f6c1fd079c6f83bc718260939dab9caf581ad6ef47104c1406711d","file":"preprints/A-Logarithmic-Independence-Bound-for-Clique-Free-Graphs-September-25-2026/build/sections/introduction.tex","line":14,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"75ea200bad276654e76747a0469d7876ee6bca4ab75a94b3fc27ca7b65331593","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-Logarithmic-Independence-Bound-for-Clique-Free-Graphs-September-25-2026/build/sections/introduction.tex"},"sha256":"sha256:af85192d88f6c1fd079c6f83bc718260939dab9caf581ad6ef47104c1406711d","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-Logarithmic-Independence-Bound-for-Clique-Free-Graphs-September-25-2026/build/sections/introduction.tex#L14"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every integer $r\\ge4$, there is a constant $c_r>0$ such that every\nfinite simple $K_r$-free graph $G$ with $n$ vertices and average degree $d\\ge2$\nsatisfies\n\\[\n \\alpha(G)\\ge c_r\\frac{n\\log d}{d}.\n\\]"}
