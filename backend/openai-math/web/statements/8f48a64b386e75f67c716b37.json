prints/The-strong-thin-tree-conjecture-September-23-2026/build/source/sections/introduction.tex","line":18,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"1f53d21c605bcb672e0f5f55ef2750f7d3f0529d4df12704b7ef3e4a6062421c","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-strong-thin-tree-conjecture-September-23-2026/build/source/sections/introduction.tex"},"sha256":"sha256:7eb25c4c4974c319e2b67caca8172881800a3ef89d79f9b44f0b1bd011f2d87d","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-strong-thin-tree-conjecture-September-23-2026/build/source/sections/introduction.tex#L18"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is a universal constant \\(C>0\\) such that, for every integer\n\\(k\\ge1\\), every finite \\(k\\)-edge-connected undirected multigraph\nwithout loops and with at least two vertices has a spanning tree \\(T\\)\nsatisfying\n\\[\n |\\delta_T(S)|\\le\\frac Ck\\,|\\delta_G(S)|\n \\qquad\\text{for every }\\varnothing\\ne S\\subsetneq V.\n\\]"}
