nt-map-web/2","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:3edd3d257ef8130f06b4d9dbf2b3d88722c8893f195adca53832afb81b37a238","file":"preprints/ample-rank-two-bundles-on-the-quadric-surface-without-griffiths-positive-metrics-September-24-2026/build/sections/01-introduction.tex","line":23,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"f242a85afd88017edf720e818e44068c0cc02c955f9c732a59ff18c168ff7f8a","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/ample-rank-two-bundles-on-the-quadric-surface-without-griffiths-positive-metrics-September-24-2026/build/sections/01-introduction.tex"},"sha256":"sha256:3edd3d257ef8130f06b4d9dbf2b3d88722c8893f195adca53832afb81b37a238","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/ample-rank-two-bundles-on-the-quadric-surface-without-griffiths-positive-metrics-September-24-2026/build/sections/01-introduction.tex#L23"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is an algebraic vector bundle $G$ of rank two on $S$ such that,\nfor every positive integer $m$, the bundle\n\\[\n E_m=f_m^*G\\otimes P\n\\]\nis ample. There is an integer $m_0$ such that $E_m$ admits no smooth\nHermitian metric with strictly Griffiths-positive Chern curvature\nfor every $m\\ge m_0$."}
