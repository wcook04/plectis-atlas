current_statement_sha256":"sha256:5d5f10f65fefa454e979ccfd96c3b663d5a9b9e873e28b32a609cfd9989be3a4","file":"preprints/Uniform-Stability-of-the-Spherical-Laughlin-Gap-October-5-2026/build/sections/01-introduction.tex","line":52,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"4d5292985e22c2c97e2a8e66f4796956da039306d06c6c2bb1d654241bf3800d","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Uniform-Stability-of-the-Spherical-Laughlin-Gap-October-5-2026/build/sections/01-introduction.tex"},"sha256":"sha256:5d5f10f65fefa454e979ccfd96c3b663d5a9b9e873e28b32a609cfd9989be3a4","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Uniform-Stability-of-the-Spherical-Laughlin-Gap-October-5-2026/build/sections/01-introduction.tex#L52"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere are constants $\\lambda_*>0$, $\\Delta_*>0$, and\n$N_*<\\infty$ such that, for every $N\\ge N_*$, every real\nbounded measurable $\\varphi$ on $S_{3(N-1)}$ with\n$\\|\\varphi\\|_\\infty\\le1$, and every real\n$|\\lambda|\\le\\lambda_*$,\n\\begin{equation}\\label{eq:intro-stability}\n E_1(N,\\lambda,\\varphi)-E_0(N,\\lambda,\\varphi)\\ge\\Delta_*.\n\\end{equation}\nIn particular the perturbed ground state is unique."}
