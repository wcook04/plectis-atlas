tion":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:a523cb34c5d9b7917c5946d4b89e3ec9721a1a64b77fcb1feaea7c8c9c3a1aab","file":"preprints/Smooth-counterexamples-to-Yaus-nodal-upper-bound-in-dimensions-three-and-four-September-23-2026/build/sections/introduction.tex","line":31,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"979ba91022c3c2950f376f68e084a64b08081b192586f30dd55fecb040075094","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Smooth-counterexamples-to-Yaus-nodal-upper-bound-in-dimensions-three-and-four-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:a523cb34c5d9b7917c5946d4b89e3ec9721a1a64b77fcb1feaea7c8c9c3a1aab","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Smooth-counterexamples-to-Yaus-nodal-upper-bound-in-dimensions-three-and-four-September-23-2026/build/sections/introduction.tex#L31"},"statement_kind":"theorem","text":"\\label{thm:four}\nThere are a smooth Riemannian metric $g_\\infty$ on $S^2\\times\\T^2$,\nnonzero smooth real functions $u_j$, and positive numbers\n$\\lambda_j\\to\\infty$ such that\n\\[\n -\\Delta_{g_\\infty}u_j=\\lambda_j u_j,\\qquad\n \\frac{\\cH^3_{g_\\infty}(Z_{u_j})}{\\sqrt{\\lambda_j}}\n       \\longrightarrow\\infty.\n\\]"}
