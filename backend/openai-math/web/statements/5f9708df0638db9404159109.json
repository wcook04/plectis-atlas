tex-environment-body-comments-removed","current_statement_sha256":"sha256:32281b5b6eb9ae7d389248e7c06cea898c828eea8230ebba10a7d783ac7c9b23","file":"preprints/A-finite-entropy-system-without-a-smooth-positive-volume-model-September-25-2026/build/sections/01-introduction.tex","line":91,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"4963021af984c2e9a651b29ff1af9a625466b5cd66ac226ad1ded2fd71f44168","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-finite-entropy-system-without-a-smooth-positive-volume-model-September-25-2026/build/sections/01-introduction.tex"},"sha256":"sha256:32281b5b6eb9ae7d389248e7c06cea898c828eea8230ebba10a7d783ac7c9b23","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-finite-entropy-system-without-a-smooth-positive-volume-model-September-25-2026/build/sections/01-introduction.tex#L91"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exists an ergodic invertible measure-preserving transformation\n$(X,\\mu,T)$ of a standard nonatomic probability space such that\n$h_\\mu(T)=0$ and $(X,\\mu,T)$ is not measurably conjugate, on invariant conull sets, to\nany $C^\\infty$ diffeomorphism of a compact finite-dimensional manifold\npreserving a strictly positive smooth probability density. The manifold\nmay have smooth boundary and need not be orientable."}
