s-removed","current_statement_sha256":"sha256:c48ab654dd3bdcf59837e7e74ad24c928b401162b000555ebce7407098512242","file":"preprints/The-Margulis-Platonov-conjecture-over-global-function-fields-October-5-2026/build/paper/01-introduction.tex","line":18,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"748e346097c850e1b1cd33acf4a4cc0691e090ab75275731f78f76985c097f2d","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-Margulis-Platonov-conjecture-over-global-function-fields-October-5-2026/build/paper/01-introduction.tex"},"sha256":"sha256:c48ab654dd3bdcf59837e7e74ad24c928b401162b000555ebce7407098512242","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-Margulis-Platonov-conjecture-over-global-function-fields-October-5-2026/build/paper/01-introduction.tex#L18"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $k$ be a global function field and let $G$ be an absolutely almost\nsimple simply connected $k$-group. If\n$N\\triangleleft G(k)$ and $N\\not\\subseteq Z(G(k))$, then\n\\[\n                  N=\\delta_A^{-1}(W)\n\\]\nfor an open normal subgroup $W\\triangleleft H_A$. This holds in every\npositive characteristic, including when $G$ is anisotropic over $k$."}
