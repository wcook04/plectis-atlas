rrent_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:a1f86ab8e14702396a5816b53be25bff429877afbca947c10d81f9394cf813ab","file":"preprints/A-direct-proof-of-the-complete-Crouzeix-inequality-September-26-2026/build/main.tex","line":323,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"b23c014c8cf1cdd2171adb006a9878e34ccd2c166e991b49ee84512b947dff5e","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-direct-proof-of-the-complete-Crouzeix-inequality-September-26-2026/build/main.tex"},"sha256":"sha256:a1f86ab8e14702396a5816b53be25bff429877afbca947c10d81f9394cf813ab","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-direct-proof-of-the-complete-Crouzeix-inequality-September-26-2026/build/main.tex#L323"},"statement_kind":"theorem","text":"\\label{thm:domain}\nFor positive integers $n,m$, let $\\Omega\\subset\\C$ be bounded, open, and convex with regular real-analytic Jordan boundary, and let $A\\in M_n(\\C)$ satisfy $W(A)\\subset\\Omega$. For every $M_m(\\C)$-valued polynomial $F$ with $\\|F(z)\\|\\le1$ on $\\partial\\Omega$, one has $\\|F[A]\\|\\le2$."}
