ment-body-comments-removed","current_statement_sha256":"sha256:5b8167bf4e66d5e12080a53644d7bb0dfab4bd868cec54a8401f7b40855a62f4","file":"preprints/Fixed-Points-of-Nonexpansive-Maps-in-Reflexive-Banach-Spaces-September-24-2026/build/sections/00-introduction.tex","line":9,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"7d569c87fc51bafa28613f0301c3d16c58ec33980a5f6b5ce4d46d7c0bb0bff1","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Fixed-Points-of-Nonexpansive-Maps-in-Reflexive-Banach-Spaces-September-24-2026/build/sections/00-introduction.tex"},"sha256":"sha256:5b8167bf4e66d5e12080a53644d7bb0dfab4bd868cec54a8401f7b40855a62f4","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Fixed-Points-of-Nonexpansive-Maps-in-Reflexive-Banach-Spaces-September-24-2026/build/sections/00-introduction.tex#L9"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $X$ be a real reflexive Banach space, and let $C\\subseteq X$ be\nnonempty, norm closed, bounded, and convex. If $F:C\\to C$ satisfies\n\\[\n  \\norm{F(a)-F(b)}\\le \\norm{a-b}\\qquad(a,b\\in C),\n\\]\nthen $F$ has a fixed point."}
