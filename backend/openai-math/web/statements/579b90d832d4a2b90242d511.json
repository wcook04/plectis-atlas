,"source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:380cee1b2303be8af6a248b5bdada194e599edd0a9018578a02f54b04cf51293","file":"preprints/Sharp-binary-information-contraction-on-the-discrete-cube-September-24-2026/build/main.tex","line":92,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"ea0b9fbcbb3da0f983e87903bbf469fe0c8cedd21eb78b20bb731dff9572d7b5","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Sharp-binary-information-contraction-on-the-discrete-cube-September-24-2026/build/main.tex"},"sha256":"sha256:380cee1b2303be8af6a248b5bdada194e599edd0a9018578a02f54b04cf51293","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Sharp-binary-information-contraction-on-the-discrete-cube-September-24-2026/build/main.tex#L92"},"statement_kind":"corollary","text":"\\label{main:ck}\nFor every finite $n\\ge0$, $\\rho\\in[-1,1]$, and\n$f:\\Omega_n\\to\\{-1,1\\}$, put\n$m=\\E f$ and $r_m=\\psi^{-1}(H(m))$.  Then\n\\begin{equation}\n I(f(X);Y)\\le\\psi(|\\rho|r_m)\\le\\psi(|\\rho|).\n \\label{main:bound}\n\\end{equation}\nFor $n\\ge1$, signed coordinate functions attain the bound at $m=0$.\nIf $0<|m|<1$ and $0<|\\rho|\\le1$, the refined upper curve is\nstrictly below the universal curve $\\psi(|\\rho|)$."}
