ease_id":"openai-math","schema":"statement-map-web/2","section":6,"section_title":"Completion and consequences","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:46c8b058864340c20912c67532f441dd6d05c0255a7e17c70567b55a43b735cf","file":"preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex","line":35,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"40782f5a35c8cf96a13991b8e2eb033f44ddaa858ca1c2465260c8818ac62d41","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex"},"sha256":"sha256:46c8b058864340c20912c67532f441dd6d05c0255a7e17c70567b55a43b735cf","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/06-completion.tex#L35"},"statement_kind":"corollary","text":"\\label{cor:characteristic-zero}\nThere is an absolute integer $n_0$ such that, for every field $K$ of\ncharacteristic zero and every $n\\ge n_0$, every syntactically homogeneous\n$\\Sigma\\Pi\\Sigma\\Pi\\Sigma$ circuit over $K$ computing $\\IMM_{n,n}$\nhas at least $n^{\\sqrt n/400}$ gates.  Bottom fan-in and bottom support\nare unrestricted."}
