ce":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:83e3df0df54a256d25c50659362ed0c8b186847b038ae92b0608c62960b595a8","file":"preprints/Near-square-root-logarithmic-integrality-gaps-for-uniform-sparsest-cut-September-24-2026/build/source/main.tex","line":152,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"f294501e7eb2a34359fffe529ae2d72970c0c57c7ecb2ac3376c578f0ae66007","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Near-square-root-logarithmic-integrality-gaps-for-uniform-sparsest-cut-September-24-2026/build/source/main.tex"},"sha256":"sha256:83e3df0df54a256d25c50659362ed0c8b186847b038ae92b0608c62960b595a8","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Near-square-root-logarithmic-integrality-gaps-for-uniform-sparsest-cut-September-24-2026/build/source/main.tex#L152"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere are an absolute constant $c>0$ and capacity instances $C^{(j)}$\non $n_j\\to\\infty$ vertices, with $\\GL(C^{(j)})>0$, such that\n\\[\n\\frac{\\OPT(C^{(j)})}{\\GL(C^{(j)})}\n\\ge c\\,\\frac{\\sqrt{\\log n_j}}{(\\log\\log n_j)^3}\n\\]\nfor all sufficiently large $j$. The demand is one between every pair\nof distinct vertices."}
