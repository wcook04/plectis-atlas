oduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:354b4bfbeac12a7b2eb8deac6a2282c02445542278595936aaf9a6185f2cec1b","file":"preprints/A-doubling-Hilbert-subset-with-no-finite-dimensional-bi-Lipschitz-embedding-September-25-2026/build/main.tex","line":47,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"f7d75d85c19672cec63cbf9eaa170897ece8eb2acfd43030f72e41e2d7f05e4f","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-doubling-Hilbert-subset-with-no-finite-dimensional-bi-Lipschitz-embedding-September-25-2026/build/main.tex"},"sha256":"sha256:354b4bfbeac12a7b2eb8deac6a2282c02445542278595936aaf9a6185f2cec1b","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-doubling-Hilbert-subset-with-no-finite-dimensional-bi-Lipschitz-embedding-September-25-2026/build/main.tex#L47"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is a fixed subset $S$ of real $\\ell_2$, equipped with its induced Hilbert distance, whose doubling constant is at most $76800$ and which admits no bi-Lipschitz embedding into $\\R^k$ for any positive integer $k$, at any finite distortion."}
