6":"sha256:d9cc6fca9df3e7090952beef37b58f50dec84e480ecf6d270b4fe04bdfaee2e8","file":"preprints/The-dyadic-case-of-the-Erdos-similarity-conjecture-September-25-2026/build/sections/introduction.tex","line":24,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"6f74109bafa1f5054e6205ebdf71c5a2b28960b8bf2a292936dca6cf5a3ca69a","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-dyadic-case-of-the-Erdos-similarity-conjecture-September-25-2026/build/sections/introduction.tex"},"sha256":"sha256:d9cc6fca9df3e7090952beef37b58f50dec84e480ecf6d270b4fe04bdfaee2e8","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-dyadic-case-of-the-Erdos-similarity-conjecture-September-25-2026/build/sections/introduction.tex#L24"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every $\\eta\\in(0,1)$, there is a compact set $E_\\eta\\subseteq[0,1]$\nwith $m(E_\\eta)>1-\\eta$ such that\n\\[\n \\text{for every }x\\in\\R\\text{ and every }s\\in\\R\\setminus\\{0\\},\n \\quad x+sD\\nsubseteq E_\\eta.\n\\]\nEquivalently, for every such $x,s$ there is an integer $n\\ge1$ with\n$x+s2^{-n}\\notin E_\\eta$."}
