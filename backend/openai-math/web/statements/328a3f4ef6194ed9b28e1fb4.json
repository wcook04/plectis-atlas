256:4ae48dd671f276ba304efc16cd22861cd2ac5eae148892e48c72bb532c87135f","file":"preprints/A-linear-cycle-and-edge-decomposition-of-every-graph-September-24-2026/build/main.tex","line":62,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"c5f13ff1bf19a76cc81815ed4b7276a936af80e13ff9d4b073aaa1cff4b00629","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-linear-cycle-and-edge-decomposition-of-every-graph-September-24-2026/build/main.tex"},"sha256":"sha256:4ae48dd671f276ba304efc16cd22861cd2ac5eae148892e48c72bb532c87135f","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-linear-cycle-and-edge-decomposition-of-every-graph-September-24-2026/build/main.tex#L62"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is an absolute constant \\(C>0\\) such that, for every finite\nsimple undirected graph \\(G\\) with \\(n\\) vertices, \\(E(G)\\) has a\npartition into at most \\(Cn\\) parts, each of which is the edge set of\na cycle or consists of a single edge."}
