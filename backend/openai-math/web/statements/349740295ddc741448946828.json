examples","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:5e813c69d21855d14943a7c5ce55cbbb5183f4f7b42b49512f2bcb4f221b0e3d","file":"preprints/A-classification-of-finite-Euclidean-Ramsey-configurations-September-23-2026/build/sections/07-consequences.tex","line":62,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"0c0a9deca7a853347d12cc6ec3fb7b9c37ea3615870814ebe0dfb5c206bc1b2b","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-classification-of-finite-Euclidean-Ramsey-configurations-September-23-2026/build/sections/07-consequences.tex"},"sha256":"sha256:5e813c69d21855d14943a7c5ce55cbbb5183f4f7b42b49512f2bcb4f221b0e3d","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-classification-of-finite-Euclidean-Ramsey-configurations-September-23-2026/build/sections/07-consequences.tex#L62"},"statement_kind":"proposition","text":"\\label{cons:quadratic}\nLet $A=\\{a_1,\\ldots,a_s\\}\\subset\\R^d$ be spherical and affinely\nspan $\\R^d$. Put $p_i=(1,a_i)^{\\mathsf T}$ and let $F$ be its\ncoordinate field. If the $s$ row vectors\n\\[\n (p_{i\\alpha}p_{i\\beta})_{0\\le\\alpha,\\beta\\le d}\n \\quad(1\\le i\\le s)\n\\]\nare linearly independent over $F$, then $A$ is Ramsey."}
