ath","schema":"statement-map-web/2","section":2,"section_title":"A fixed-vector formulation","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:47f74ccbb7b99d8afeb8de937021a6b41ae786fe290812496062b752c3f8332f","file":"preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/setup.tex","line":23,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"5a56f8533eb3587aeba02fb3a5c2cfb58b826d37a44925d8cd3fb95d8e823b97","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/setup.tex"},"sha256":"sha256:47f74ccbb7b99d8afeb8de937021a6b41ae786fe290812496062b752c3f8332f","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/setup.tex#L23"},"statement_kind":"proposition","text":"\\label{prop:hidden}\nThere is a measurable rule in the fixed-vector formulation that is feasible for every\nrealization and every permutation, and for every $w\\in[0,\\infty)^E$ satisfies\n\\begin{equation}\\label{eq:hidden-guarantee}\n \\Ex_R\\left[\\min_{\\pi}\\sum_{e\\in A(w,R,\\pi)}w_e\\right]\n \\ge 2^{-293}\\OPT_M(w).\n\\end{equation}\nIts revealed mask is selected before any weights are seen."}
