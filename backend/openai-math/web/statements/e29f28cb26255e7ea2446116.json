dy-comments-removed","current_statement_sha256":"sha256:3ca09f9b68e52b68e43ca6afc14c5c05f73a200cdebb95b39c1705a8c8adbc99","file":"preprints/Planar-Graph-Metrics-Embed-into-L1-with-Constant-Distortion-September-23-2026/build/sections/introduction.tex","line":13,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"529beabe58207085b12f464bb08ebec4b78c3b05c30c9a1dc6fbd4cccacf2a63","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Planar-Graph-Metrics-Embed-into-L1-with-Constant-Distortion-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:3ca09f9b68e52b68e43ca6afc14c5c05f73a200cdebb95b39c1705a8c8adbc99","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Planar-Graph-Metrics-Embed-into-L1-with-Constant-Distortion-September-23-2026/build/sections/introduction.tex#L13"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is a finite universal constant $C\\ge1$ with the following property.\nFor every finite connected planar graph $G=(V,E)$ with strictly positive real\nedge lengths, there exist a measure space $(\\Omega,\\mathcal F,\\mu)$ and a map\n$f:V\\to L_1(\\Omega,\\mathcal F,\\mu;\\R)$ such that\n\\[\n d_G(x,y)\\le\\|f(x)-f(y)\\|_1\\le C d_G(x,y)\n \\qquad(x,y\\in V).\n\\]"}
