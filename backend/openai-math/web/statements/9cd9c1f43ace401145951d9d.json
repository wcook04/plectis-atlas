section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:7737d31724fa046de10732933607adcde01ddb6e98c4f6ff2d6f494515289600","file":"preprints/A-projective-fourfold-with-large-fundamental-group-and-non-Stein-universal-cover-October-5-2026/build/sections/01-introduction.tex","line":17,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"6f908d8afe31518e11c278e12a61c59905e9efd2850716e9e28c70794920580e","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-projective-fourfold-with-large-fundamental-group-and-non-Stein-universal-cover-October-5-2026/build/sections/01-introduction.tex"},"sha256":"sha256:7737d31724fa046de10732933607adcde01ddb6e98c4f6ff2d6f494515289600","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-projective-fourfold-with-large-fundamental-group-and-non-Stein-universal-cover-October-5-2026/build/sections/01-introduction.tex#L17"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exist a smooth connected projective complex fourfold $X$ and a\nsimple abelian surface $A\\subset X$ such that\n\\begin{enumerate}\n\\item $X$ has large fundamental group;\n\\item $\\im\\bigl(\\pi_1(A)\\to\\pi_1(X)\\bigr)\\simeq\\Z$.\n\\end{enumerate}\nThe universal cover $\\widetilde X$ contains no positive-dimensional\ncompact complex analytic subvariety and is not Stein."}
