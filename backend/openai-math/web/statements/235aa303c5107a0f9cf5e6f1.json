ved","current_statement_sha256":"sha256:eb84b4580d19e9884e0ca21a512f55d922b4cc59d21d2f4ee4b362f05ebbbb08","file":"preprints/A-Fock-space-inequality-and-the-Laughlin-spectral-gap-September-24-2026/build/sections/01-introduction.tex","line":60,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"80ba4f7672b8a4bab23a4671ec0a17dbcdb0ab4553278aba40e2f0f05c828b33","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-Fock-space-inequality-and-the-Laughlin-spectral-gap-September-24-2026/build/sections/01-introduction.tex"},"sha256":"sha256:eb84b4580d19e9884e0ca21a512f55d922b4cc59d21d2f4ee4b362f05ebbbb08","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-Fock-space-inequality-and-the-Laughlin-spectral-gap-September-24-2026/build/sections/01-introduction.tex#L60"},"statement_kind":"corollary","text":"\\label{thm:main}\nThere is an integer \\(N_0\\ge2\\) such that, for every \\(N\\ge N_0\\) and\n\\(Q=3(N-1)\\),\n\\begin{equation}\\label{eq:main}\n H_{N,Q}\\ge\\frac1{25}\\bigl(I-P_{\\mathrm L,N}\\bigr)\n \\qquad\\text{on }\\bigwedge^N U_Q,\n\\end{equation}\nwhere \\(P_{\\mathrm L,N}\\) projects onto the line spanned by\n\\[\n \\Psi_{\\mathrm L,N}=\\prod_{i<j}(u_iv_j-u_jv_i)^3.\n\\]"}
