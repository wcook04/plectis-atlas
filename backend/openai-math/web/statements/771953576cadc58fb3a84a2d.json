urce":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:bba66bb7b9cad7580be228fb49e338cd6ca4c7177bd1a472ab9f4d2696c405f5","file":"preprints/The-complexity-of-identifying-a-graph-by-Weisfeiler-Leman-refinement-September-25-2026/build/sections/01-introduction.tex","line":36,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8d1290189c3ceec8aa64b21ffae4bc0d6c8575a3cd6967435835dcdced17e974","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-complexity-of-identifying-a-graph-by-Weisfeiler-Leman-refinement-September-25-2026/build/sections/01-introduction.tex"},"sha256":"sha256:bba66bb7b9cad7580be228fb49e338cd6ca4c7177bd1a472ab9f4d2696c405f5","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-complexity-of-identifying-a-graph-by-Weisfeiler-Leman-refinement-September-25-2026/build/sections/01-introduction.tex#L36"},"statement_kind":"theorem","text":"\\label{thm:main}\nThe following problem is EXPTIME-complete under deterministic\npolynomial-time many-one reductions: given a nonempty finite simple\nundirected uncolored graph $G$ by its adjacency matrix and a positive\ninteger $k$ in binary, decide whether $\\WLdim(G)\\le k$.\nHere dimension one uses ordinary neighbor color refinement, and\ndimensions at least two use the joint-update rule described above."}
