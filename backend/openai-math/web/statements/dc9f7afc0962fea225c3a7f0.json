ment-body-comments-removed","current_statement_sha256":"sha256:1b4116784c3cbe5e0a1c0537aafda44edffd7988c6276be6bf3d29f2fd2b806e","file":"preprints/Backward-intertwiners-and-a-transitive-commutant-September-27-2026/build/sections/introduction.tex","line":72,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"068bfc44907c178069e0d6b0fd9c92360a18f06d27e5c389a65e0141990df59f","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Backward-intertwiners-and-a-transitive-commutant-September-27-2026/build/sections/introduction.tex"},"sha256":"sha256:1b4116784c3cbe5e0a1c0537aafda44edffd7988c6276be6bf3d29f2fd2b806e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Backward-intertwiners-and-a-transitive-commutant-September-27-2026/build/sections/introduction.tex#L72"},"statement_kind":"corollary","text":"\\label{cor:direct-algebra}\nEvery infinite-dimensional separable complex Hilbert space admits a\nnonzero bounded norm-quasinilpotent operator with no nonzero proper\nclosed hyperinvariant subspace. Its commutant is a proper strongly\nclosed unital transitive complex operator algebra."}
