":"openai-math","schema":"statement-map-web/2","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:9465aee207317ce97b62a9049089cdf42d54b6bca4b0f6872efd7d0ba8243d1c","file":"preprints/The-two-primary-Birch-Swinnerton-Dyer-formula-in-Selmer-corank-at-most-one-October-6-2026/build/sections/01-introduction.tex","line":73,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"4e08eb011dd0b7fc6ebcf15c61dd59721777e46593069028ed71af71724ce926","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-two-primary-Birch-Swinnerton-Dyer-formula-in-Selmer-corank-at-most-one-October-6-2026/build/sections/01-introduction.tex"},"sha256":"sha256:9465aee207317ce97b62a9049089cdf42d54b6bca4b0f6872efd7d0ba8243d1c","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-two-primary-Birch-Swinnerton-Dyer-formula-in-Selmer-corank-at-most-one-October-6-2026/build/sections/01-introduction.tex#L73"},"statement_kind":"corollary","text":"\\label{cor:any-prime-bsd}\nLet \\(E/\\mathbb Q\\) be an elliptic curve. Suppose that, for some prime\n\\(p\\), its full \\(p\\)-power Selmer group with the usual local Kummer\nconditions at every place satisfies\n\\[\n s_p(E):=\\corank_{\\mathbb Z_p}\\Sel_{p^\\infty}(E/\\mathbb Q)\\le1.\n\\]\nThen all conclusions of Theorem~\\ref{thm:main} hold, with common rank\n\\(r=s_p(E)\\)."}
