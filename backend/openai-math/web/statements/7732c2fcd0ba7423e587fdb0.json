sha256:b56f213a2779e8aa4dd5b3a345be9274dfbc619f663bde9cfdc08fb8d0783099","file":"preprints/The-rational-Hodge-conjecture-for-CM-abelian-varieties-October-6-2026/build/sections/01-introduction.tex","line":17,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"49631d722776b2b032875a3aa9c23ef0efa8d8ad8236574558ebcefbf35e5d1c","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-rational-Hodge-conjecture-for-CM-abelian-varieties-October-6-2026/build/sections/01-introduction.tex"},"sha256":"sha256:b56f213a2779e8aa4dd5b3a345be9274dfbc619f663bde9cfdc08fb8d0783099","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-rational-Hodge-conjecture-for-CM-abelian-varieties-October-6-2026/build/sections/01-introduction.tex#L17"},"statement_kind":"theorem","text":"\\label{thm:cm}\nLet \\(A\\) be a complex CM abelian variety.  For every integer\n\\(p\\geq0\\), the Betti cycle-class map\n\\[\n \\operatorname{cl}_B:\\CH^p(A)_{\\Q}\n \\longrightarrow H^{2p}(A,\\Q)\\cap H^{p,p}(A)\n\\]\nis surjective, where \\(\\CH^p(A)_{\\Q}=\\CH^p(A)\\otimes_{\\Z}\\Q\\) and\nthe intersection is taken in \\(H^{2p}(A,\\C)\\).  In particular, the\nrational Hodge conjecture holds in every codimension on every finite\nproduct of complex CM abelian varieties and on every power of such a\nproduct."}
