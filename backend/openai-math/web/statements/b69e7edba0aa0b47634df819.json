source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:3c8fca99528c73db4edee971c071cb0d8c4e598950f21b88d1a423eda6c2c5de","file":"preprints/Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026/build/sections/introduction.tex","line":31,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"df86ad93518557be74e01ac05a91d250f6b8a7af08dff03fa8cf8f1ac9f01d6a","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:3c8fca99528c73db4edee971c071cb0d8c4e598950f21b88d1a423eda6c2c5de","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Global-Uniqueness-for-the-Smooth-Isotropic-Elasticity-Inverse-Problem-September-24-2026/build/sections/introduction.tex#L31"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $\\Omega\\subset\\R^3$ be any bounded connected domain with\n$C^\\infty$ boundary. For $j=1,2$, let\n$\\lambda_j,\\mu_j\\in C^\\infty(\\overline\\Omega;\\R)$ satisfy\n$\\mu_j>0$ and $3\\lambda_j+2\\mu_j>0$ on $\\overline\\Omega$.\nIf\n\\[\n \\Lambda_{\\lambda_1,\\mu_1}\n =\\Lambda_{\\lambda_2,\\mu_2}\n \\colon H^{1/2}(\\partial\\Omega;\\R^3)\n       \\longrightarrow H^{-1/2}(\\partial\\Omega;\\R^3),\n\\]\nthen $\\lambda_1=\\lambda_2$ and $\\mu_1=\\mu_2$ throughout $\\Omega$."}
