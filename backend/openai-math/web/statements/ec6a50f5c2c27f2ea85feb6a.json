a256":"sha256:ad62380289a9ad287054dcd0d7ffd3e664dd5527993eae1e8e068d09befa4b0f","file":"preprints/An-algebra-of-infinite-little-finitistic-dimension-September-23-2026/build/sections/01-introduction.tex","line":24,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"bc3a3e55955937daa95d8ba9eedd8976e54a051ca6cad7233384ae498e0f3542","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/An-algebra-of-infinite-little-finitistic-dimension-September-23-2026/build/sections/01-introduction.tex"},"sha256":"sha256:ad62380289a9ad287054dcd0d7ffd3e664dd5527993eae1e8e068d09befa4b0f","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/An-algebra-of-infinite-little-finitistic-dimension-September-23-2026/build/sections/01-introduction.tex#L24"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is a finite-dimensional unital complex algebra \\(A\\) such that,\nfor every integer \\(m\\ge1\\), there is a finite-dimensional left\n\\(A\\)-module \\(N_m\\) with\n\\[\n2m-2\\le\\pd_A N_m<\\infty.\n\\]\nIn particular, \\(\\findim A=\\infty\\)."}
