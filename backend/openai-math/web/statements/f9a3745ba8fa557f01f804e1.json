nt_sha256":"sha256:ed0cd651becc30e3b3f164b6635871e299682a92c7b63903afe147ac6370de4e","file":"preprints/Graph-Decompositions-at-the-Integral-Expectation-Threshold-October-5-2026/build/main.tex","line":80,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"17235bfce9f86db21a7284effd4deffc8b2dcbdb7c7e21a3ad30f5f75a9e1b01","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Graph-Decompositions-at-the-Integral-Expectation-Threshold-October-5-2026/build/main.tex"},"sha256":"sha256:ed0cd651becc30e3b3f164b6635871e299682a92c7b63903afe147ac6370de4e","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Graph-Decompositions-at-the-Integral-Expectation-Threshold-October-5-2026/build/main.tex#L80"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exist an absolute integer $k\\geq2$ and an absolute constant\n$L\\geq1$ such that, for every $n\\geq2$ and every graph $H$ on\nat most $n$ vertices, the edges of $H$ admit a partition\n\\[\n E(H)=E(H_1)\\,\\dot\\cup\\,\\cdots\\,\\dot\\cup\\,E(H_k)\n \\quad\\text{with}\\quad\n p_c(H_i;n)\\leq Lq(H;n)\\qquad(1\\leq i\\leq k).\n\\]\nThe pieces may be empty and may share vertices. The partition\ndepends only on $H,n$ and is fixed before the random host is sampled."}
