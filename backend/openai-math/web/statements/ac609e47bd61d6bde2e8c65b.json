ma":"statement-map-web/2","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:79602a9792bfbb069848acc2c6a24968549bcef383e3415640e3aa37629c8ff8","file":"preprints/A-Three-Manifold-Without-Conjugate-Points-and-Without-a-Nonpositively-Curved-Metric-September-24-2026/build/sections/introduction.tex","line":27,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"b8bce094a1252ea46658688fe5e88bcfec73bb1b84754364c350c6c6383e39df","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-Three-Manifold-Without-Conjugate-Points-and-Without-a-Nonpositively-Curved-Metric-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:79602a9792bfbb069848acc2c6a24968549bcef383e3415640e3aa37629c8ff8","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-Three-Manifold-Without-Conjugate-Points-and-Without-a-Nonpositively-Curved-Metric-September-24-2026/build/sections/introduction.tex#L27"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exists a closed connected orientable smooth three-manifold $M$ with a $C^\\infty$ Riemannian metric without conjugate points, such that $M$ admits no $C^\\infty$ Riemannian metric whose sectional curvature is everywhere at most zero."}
