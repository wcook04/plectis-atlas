:"statement-map-web/2","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:a2f6cac02e105744ba53461553b56ca87b8157241b8ce5b4693b6edae39fea47","file":"preprints/Additive-hardness-and-unbounded-configuration-gaps-in-bin-packing-September-24-2026/build/source/introduction.tex","line":106,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"290f6c57603771e03268f76a59865495ed247ed080264904454249b72c4f790f","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Additive-hardness-and-unbounded-configuration-gaps-in-bin-packing-September-24-2026/build/source/introduction.tex"},"sha256":"sha256:a2f6cac02e105744ba53461553b56ca87b8157241b8ce5b4693b6edae39fea47","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Additive-hardness-and-unbounded-configuration-gaps-in-bin-packing-September-24-2026/build/source/introduction.tex#L106"},"statement_kind":"theorem","text":"\\label{thm:additive-hardness}\nFor every fixed integer $c\\ge0$, it is NP-hard to distinguish pairs $(I,B)$\nsuch that $I$ packs into $B$ bins from pairs such that $I$ cannot be packed\ninto $B+c$ bins.  Here $B$ is an integer supplied with the instance,\nthe item sizes are rational, and every item size is strictly greater\nthan $1/6$."}
