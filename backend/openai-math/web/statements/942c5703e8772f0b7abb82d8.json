mments-removed","current_statement_sha256":"sha256:3721663a8ae623223a0441485c2b075cc6e2d75457243a91e0490655b393cebc","file":"preprints/Canonical-ampleness-of-compact-hyperbolic-Kahler-manifolds-September-23-2026/build/sections/introduction.tex","line":21,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"b20d8e04a68ddae94a9ccd3c73369fa338050e0b51a175dbee2680fe492a95c6","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Canonical-ampleness-of-compact-hyperbolic-Kahler-manifolds-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:3721663a8ae623223a0441485c2b075cc6e2d75457243a91e0490655b393cebc","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Canonical-ampleness-of-compact-hyperbolic-Kahler-manifolds-September-23-2026/build/sections/introduction.tex#L21"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $X$ be a compact connected K\\\"ahler manifold of positive complex\ndimension. If every holomorphic map $\\C\\to X$ is constant, then $K_X$ is\nample. In particular, a positive tensor power of $K_X$ defines a\nholomorphic embedding of $X$ into a complex projective space."}
