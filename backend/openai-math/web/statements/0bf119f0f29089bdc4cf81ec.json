,"file":"preprints/The-crossing-number-of-complete-graphs-September-23-2026/build/main.tex","line":117,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"b4665628c232e380d9d57e28f497230b302fc7b632975a40c4a9e2560cd2584e","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-crossing-number-of-complete-graphs-September-23-2026/build/main.tex"},"sha256":"sha256:21239b769f93e028eb1eb11a121c75377018c2f34052274e6d15ddfdbfbf413a","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-crossing-number-of-complete-graphs-September-23-2026/build/main.tex#L117"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every integer \\(n\\ge3\\),\n\\[\n\\crn(K_n)=Z(n):=\n\\frac14\\left\\lfloor\\frac n2\\right\\rfloor\n\\left\\lfloor\\frac{n-1}2\\right\\rfloor\n\\left\\lfloor\\frac{n-2}2\\right\\rfloor\n\\left\\lfloor\\frac{n-3}2\\right\\rfloor.\n\\]"}
