vironment-body-comments-removed","current_statement_sha256":"sha256:8a76c361fd92f830d9fa9c1f1b3a10d8a05ea490b5bd5f729fd3747fecb107dd","file":"preprints/A-sharp-Fourier-certificate-for-planar-circle-packing-September-23-2026/build/sections/introduction.tex","line":34,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"cee192fc6a5da268e4cab6b7825ad18be044fbd04ea1ccbb935aa58eefcb0156","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-sharp-Fourier-certificate-for-planar-circle-packing-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:8a76c361fd92f830d9fa9c1f1b3a10d8a05ea490b5bd5f729fd3747fecb107dd","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-sharp-Fourier-certificate-for-planar-circle-packing-September-23-2026/build/sections/introduction.tex#L34"},"statement_kind":"theorem","text":"\\label{intro:main}\nThere is a real radial Schwartz function $f:\\RR^2\\to\\RR$ such that\n\\begin{equation}\\label{intro:conditions}\n  \\widehat f(0)=1,\\qquad f(0)=\\frac{2}{\\sqrt3},\\qquad\n  \\widehat f(\\xi)\\ge0\\quad(\\xi\\in\\RR^2),\\qquad\n  f(x)\\le0\\quad(|x|\\ge1).\n\\end{equation}"}
