hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:e54c00e61d727c3d639d1b2a96193dc79d548e569546093bdc6801bec279deda","file":"preprints/A-classification-of-finite-Euclidean-Ramsey-configurations-September-23-2026/build/sections/07-consequences.tex","line":153,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"4f411ce18ca2275f1b05e947d1c2082e3610d2ae496431bddc7572551e1485fa","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-classification-of-finite-Euclidean-Ramsey-configurations-September-23-2026/build/sections/07-consequences.tex"},"sha256":"sha256:e54c00e61d727c3d639d1b2a96193dc79d548e569546093bdc6801bec279deda","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-classification-of-finite-Euclidean-Ramsey-configurations-September-23-2026/build/sections/07-consequences.tex#L153"},"statement_kind":"proposition","text":"\\label{cons:nine}\nLet $t_1,\\ldots,t_9$ be algebraically independent real numbers over\n$\\Q$. The nine points\n\\[\n a_i=\\left(\\frac{1-t_i^2}{1+t_i^2},\n                \\frac{2t_i}{1+t_i^2}\\right),\\qquad 1\\le i\\le9,\n\\]\nform a spherical set that is not Ramsey."}
