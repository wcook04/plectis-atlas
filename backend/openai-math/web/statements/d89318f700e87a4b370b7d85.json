:"sha256:1c2bc869d5e78763ec356288c51a316e9b687f820a5271af343a605617201fba","file":"preprints/A-Cyclic-Polytabloid-Proof-of-Saxls-Conjecture-September-24-2026/build/sections/introduction.tex","line":18,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"9c4bb97f4859530ed6df3d22082d16013c0a8162dbb6342c7e147f28c8dbb33b","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-Cyclic-Polytabloid-Proof-of-Saxls-Conjecture-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:1c2bc869d5e78763ec356288c51a316e9b687f820a5271af343a605617201fba","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-Cyclic-Polytabloid-Proof-of-Saxls-Conjecture-September-24-2026/build/sections/introduction.tex#L18"},"statement_kind":"theorem","text":"\\label{thm:saxl}\nFor every integer $m\\ge1$ and every partition $\\lambda\\vdash N_m$,\n\\[\ng(\\rho_m,\\rho_m,\\lambda)>0.\n\\]\nEquivalently, $S^{\\rho_m}\\otimes S^{\\rho_m}$ contains every irreducible\ncomplex representation of $S_{N_m}$."}
