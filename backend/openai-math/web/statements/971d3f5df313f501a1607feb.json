statement-map-web/2","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:94b3e1f5c064fdf76ebfc13325f05f5ccf744b2b41190b07d2fb7eb53717c1ab","file":"preprints/Relative-generation-and-the-generator-problem-for-finite-factors-September-23-2026/build/sections/introduction.tex","line":19,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"ab2f27f8289de1f78ed174a654290d467f8dcf4edbbb7cace02d29d480b6160c","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Relative-generation-and-the-generator-problem-for-finite-factors-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:94b3e1f5c064fdf76ebfc13325f05f5ccf744b2b41190b07d2fb7eb53717c1ab","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Relative-generation-and-the-generator-problem-for-finite-factors-September-23-2026/build/sections/introduction.tex#L19"},"statement_kind":"theorem","text":"\\label{thm:relative-generation}\nLet $P\\subset M$ be an irreducible inclusion of type $\\mathrm{II}_1$\nfactors, with $M$ of separable predual. The set\n\\[\n \\{u\\in\\mathcal U(M):W^*(P,u)=M\\}\n\\]\nis a dense $G_\\delta$ subset of the unitary group $\\mathcal U(M)$\nfor the trace $2$-norm topology."}
