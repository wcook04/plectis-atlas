{"appendix":false,"contribution_target":{"fingerprint":"sha256:b30dcc243db952f670fc7d87fba42c91edd8c79ec66c4dfd4e722e5b80239411","grain":"paper-statement","id":"One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026#thm:main","title":"thm:main"},"credit":{"kind":"producer-declared","license":null,"license_status":"consult-source-notice","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","repository":"https://github.com/openai/math","source":"lean/formalization.yaml","source_registry":"index.json#/sources"},"detail":{"path":"../rows/33bd30240cfb8ee3d41d3960.json","pointer":"/row"},"display":"Theorem","generation_id":"sha256:c701139844a2d825c371ded7486924e7dae7de0af77a69dc9c1abaf1129191a1","id":"r:One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026:thm:main","kind":"statement-detail","manuscript_id":"p:One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026","name":"thm:main","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","printed_number":"1.1","printed_number_provenance":{"atlas_pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","binding":{"file":"build/sections/introduction.tex","label":"thm:main","line":24,"manuscript":"One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026","statement_sha256":"5b15fcbe35d7d2d9ba1b834cce7fa7a864793c5c4a62c4b98e38d91cd914b479"},"blob_sha256":"sha256:253ae0683558fd095a71d6f47ab0694d8d98b846c1a65d2bbf9b145d484af567","kind":"reading-page-computed","pdf_verified":false,"pin":"f047bac96ee80ebef0b4f5a403831b84de6e32c1","renderer":"scripts/build_papers.py","source":"data/statement_numbers.json","upstream_pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb"},"printed_number_status":"recorded","reading_page":"papers/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026.html#thm:main","release_id":"openai-math","schema":"statement-map-web/2","section":1,"section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:202193e6deddb8284717c0a6f1800d0732acea9bd7757bf793dd792ce014c143","file":"preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/introduction.tex","line":24,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"5b15fcbe35d7d2d9ba1b834cce7fa7a864793c5c4a62c4b98e38d91cd914b479","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:202193e6deddb8284717c0a6f1800d0732acea9bd7757bf793dd792ce014c143","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/One-Sample-Suffices-for-Matroid-Prophet-Inequalities-against-an-Almighty-Adversary-September-23-2026/build/sections/introduction.tex#L24"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere is a measurable online selection rule, independent of the value\ndistributions, with the following property. Let $M=(E,\\mathcal I)$ be any\nfinite known labeled matroid, and let $(S_e,V_e:e\\in E)$ be mutually\nindependent nonnegative real random variables, with $S_e$ and $V_e$ having\nthe same arbitrary law $D_e$. Assume\n$\\Ex[\\OPT_M(V)]<\\infty$. The rule receives exactly the sample vector $S$\nbefore arrivals and uses a seed $R$ independent of $S,V$.\n\nFor every measurable permutation rule $\\pi$ depending on $M$, the laws\n$(D_e)$, $S$, $V$, and $R$, the rule accepts an independent set $A$,\nirrevocably deciding at each arrival using only the available history, and\n\\begin{equation}\\label{eq:main}\n \\Ex\\left[\\sum_{e\\in A}V_e\\right]\n       \\ge 2^{-310}\\Ex[\\OPT_M(V)].\n\\end{equation}"}
