ction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:6bccdabc0ebe6b1930079c923c812a2dac37f9701e4a4e583150795d8addb868","file":"preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/01-introduction.tex","line":53,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"2f636074f34fa2b79c1620f5314d1ec138c6f212b44100a4412facc4e0740952","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/01-introduction.tex"},"sha256":"sha256:6bccdabc0ebe6b1930079c923c812a2dac37f9701e4a4e583150795d8addb868","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Homogeneous-depth-five-lower-bounds-for-iterated-matrix-multiplication-September-25-2026/build/sections/01-introduction.tex#L53"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exist absolute constants $c>0$ and $n_0$ such that, for every integer\n$n\\geq n_0$, every syntactically homogeneous\n$\\Sigma\\Pi\\Sigma\\Pi\\Sigma$ circuit over $\\C$ computing $\\IMM_{n,n}$\nhas size at least\n\\[\n n^{c\\sqrt n}.\n\\]\nOne may take $c=1/400$."}
