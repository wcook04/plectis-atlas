nt_sha256":"sha256:933340a3f6dc2eec04dd78dd0a8671a4da897805c3812e5e1b66259f76143646","file":"preprints/The-curve-scaling-limit-of-half-plane-double-dimers-September-23-2026/build/sections/10-introduction.tex","line":84,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"b9321e9e98504c8ce04ddd83036d382a3a2f9e5032d1c9695b4f0eda91e28aac","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-curve-scaling-limit-of-half-plane-double-dimers-September-23-2026/build/sections/10-introduction.tex"},"sha256":"sha256:933340a3f6dc2eec04dd78dd0a8671a4da897805c3812e5e1b66259f76143646","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-curve-scaling-limit-of-half-plane-double-dimers-September-23-2026/build/sections/10-introduction.tex#L84"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor the half-plane Temperleyan law specified above, the family\n\\(F(\\mathcal L_\\delta)\\) is tight as \\(\\delta\\downarrow0\\) in the\nloop-collection topology just defined, and\n\\[\n F(\\mathcal L_\\delta)\\ \\Longrightarrow\\ F(\\mathcal L),\n \\qquad \\delta\\downarrow0,\n\\]\nwhere \\(\\mathcal L\\) is standard nested \\(\\CLE_4\\) in \\(\\HH\\).\nThe convergence holds along the full mesh limit and matches all\nmacroscopic loops as curves."}
