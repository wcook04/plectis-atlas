tement","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:74381b41e99471b73cb950c3ce4667e48d9abb0c1fbf24a2845f43a2cd3e71f7","file":"preprints/An-explicit-noncoordinate-polynomial-with-affine-three-space-zero-fibre-September-24-2026/build/paper.tex","line":103,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"aa21ee819ecac5e598e8122cd1328dd8df8f354e4df2816742925327bb73c34c","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/An-explicit-noncoordinate-polynomial-with-affine-three-space-zero-fibre-September-24-2026/build/paper.tex"},"sha256":"sha256:74381b41e99471b73cb950c3ce4667e48d9abb0c1fbf24a2845f43a2cd3e71f7","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/An-explicit-noncoordinate-polynomial-with-affine-three-space-zero-fibre-September-24-2026/build/paper.tex#L103"},"statement_kind":"theorem","text":"\\label{thm:main}\nThe polynomial $F$ defined in \\eqref{eq:xyz}--\\eqref{eq:F} satisfies\n\\[\n  R/(F)\\cong\\CC^{[3]},\n  \\qquad\n  \\grad F(2,0,-1/2,1/2)=0.\n\\]\nConsequently $F$ is not a coordinate of $R$."}
