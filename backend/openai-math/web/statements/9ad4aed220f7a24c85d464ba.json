:5ac4a3d1a0ccb89af0d945fbfcc95304b5503930edffcd2e6ec57b51b454edfa","file":"preprints/Harmonic-heights-and-the-Artin-K-pi-1-conjecture-September-23-2026/build/sections/introduction.tex","line":22,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"e096620c55ec2843fab2103275bdf25987a023460bf87289b7a455504248c321","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Harmonic-heights-and-the-Artin-K-pi-1-conjecture-September-23-2026/build/sections/introduction.tex"},"sha256":"sha256:5ac4a3d1a0ccb89af0d945fbfcc95304b5503930edffcd2e6ec57b51b454edfa","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Harmonic-heights-and-the-Artin-K-pi-1-conjecture-September-23-2026/build/sections/introduction.tex#L22"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every Coxeter matrix on a finite set \\(S\\), the universal cover\nof \\(X(W,S)\\) is contractible.  Equivalently,\n\\[\n  \\pi_n\\bigl(X(W,S)\\bigr)=0\\qquad(n\\ge2).\n\\]\nThe conclusion allows arbitrary finite labels, infinite labels,\nand connected or disconnected diagrams."}
