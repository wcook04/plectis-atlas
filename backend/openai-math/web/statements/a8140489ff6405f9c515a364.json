current_statement_sha256":"sha256:915b7b66773006fbf3290283436a494e8807dab71709859011d53b722da63961","file":"preprints/The-logarithmic-Brunn-Minkowski-conjecture-September-23-2026/build/introduction.tex","line":21,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"8edc56032c0e2b7ac941be818e3ef438e337ffe7727eca77727b18756e5ff8cf","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-logarithmic-Brunn-Minkowski-conjecture-September-23-2026/build/introduction.tex"},"sha256":"sha256:915b7b66773006fbf3290283436a494e8807dab71709859011d53b722da63961","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-logarithmic-Brunn-Minkowski-conjecture-September-23-2026/build/introduction.tex#L21"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $n\\ge1$ and let $K,L\\subset\\R^n$ be convex bodies satisfying\n$K=-K$ and $L=-L$. For every $0\\le\\lambda\\le1$,\n\\begin{equation}\\label{eq:main}\n \\left|\\mathcal W[h_K^{1-\\lambda}h_L^\\lambda]\\right|\n \\ge |K|^{1-\\lambda}|L|^\\lambda.\n\\end{equation}"}
