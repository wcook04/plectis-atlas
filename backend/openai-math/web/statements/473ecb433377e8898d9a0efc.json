ection_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:497117ed7afe901ae551e051500c617be1a56700e227cad7dd1061f5f8429d3f","file":"preprints/An-exponential-two-way-deterministic-state-lower-bound-for-one-way-liveness-September-25-2026/build/sections/introduction.tex","line":99,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"1bd9d089e587be5ebd0708ffb94be4a5418c464bbbb3f979d7aa6537ced27aad","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/An-exponential-two-way-deterministic-state-lower-bound-for-one-way-liveness-September-25-2026/build/sections/introduction.tex"},"sha256":"sha256:497117ed7afe901ae551e051500c617be1a56700e227cad7dd1061f5f8429d3f","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/An-exponential-two-way-deterministic-state-lower-bound-for-one-way-liveness-September-25-2026/build/sections/introduction.tex#L99"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every integer $h\\ge2$, the language $\\OWL_h$ is recognized by a\nnondeterministic automaton with $h+3$ states using no left moves. Every\nequivalent deterministic two-way automaton with $s$ states satisfies\n\\begin{equation}\n\\label{eq:main-bound}\n 4(s+2)^2\\ge 2^{\\lfloor(h-2)/31\\rfloor}.\n\\end{equation}\nIf an initially accepting configuration counts as acceptance, $s+2$ in\n\\eqref{eq:main-bound} may be replaced by $s+1$."}
