urce":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:40b3b6de5f7042652ad753961e4e6adee85f457435a1bdd094043fe61e97e079","file":"preprints/Midpoint-convexity-from-bounded-tree-potentials-and-path-costs-September-27-2026/build/sections/constrained.tex","line":63,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"b436ca1cbd6243ba2ab971216f088661c4e7c427cacd22c93d4307c66c8dab15","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Midpoint-convexity-from-bounded-tree-potentials-and-path-costs-September-27-2026/build/sections/constrained.tex"},"sha256":"sha256:40b3b6de5f7042652ad753961e4e6adee85f457435a1bdd094043fe61e97e079","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Midpoint-convexity-from-bounded-tree-potentials-and-path-costs-September-27-2026/build/sections/constrained.tex#L63"},"statement_kind":"theorem","text":"\\label{thm:four}\nEach of the four completed spaces $X_K$ is a separable infinite-dimensional\nreal Banach space. For $K\\in\\{K_{\\rm s},K_{\\rm p},K_{\\rm a},K_{\\rm g}\\}$\nand $0<t<1$,\n\\begin{equation}\\label{eq:common-bound}\n \\widehat\\delta_{X_K}(t)\\ge\\sqrt{1+t^2/4}-1.\n\\end{equation}\nNone of these spaces admits an equivalent AUC norm."}
