d","current_statement_sha256":"sha256:090f55b18868871bdf41b66e530d0306d855ddda0e5578a7833e21af46c2b5c2","file":"preprints/Parabolic-intersections-in-Artin-groups-September-23-2026/build/sections/01_intro.tex","line":59,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"5a39df98f10810375f423ee4522a7731de808afdc474773c04a62dcbc7823256","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Parabolic-intersections-in-Artin-groups-September-23-2026/build/sections/01_intro.tex"},"sha256":"sha256:090f55b18868871bdf41b66e530d0306d855ddda0e5578a7833e21af46c2b5c2","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Parabolic-intersections-in-Artin-groups-September-23-2026/build/sections/01_intro.tex#L59"},"statement_kind":"corollary","text":"\\label{cor:membership}\nThere is an algorithm which, given a finite Coxeter matrix $M$, a subset\n$X\\subseteq S$, and words $u,v$ in the standard generators of $A_M$ and their inverses, decides\nwhether the element represented by $v$ belongs to $uA_Xu^{-1}$.\nIn particular, the word problem is decidable for every finite-rank\nArtin group."}
