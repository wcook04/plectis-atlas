section_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:cb6efa89b91ba0d3b1d6c487ee7d3e1368c4df0b2ddd1417de2abc1e33f98f9d","file":"preprints/Turn-Based-Stochastic-Mean-Payoff-Games-in-Deterministic-Quasipolynomial-Time-October-5-2026/build/build/sections/introduction.tex","line":49,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"a0db12ad5fae058123e59178e9ac33808ceb21e1f952ba68e3da227117f44a22","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Turn-Based-Stochastic-Mean-Payoff-Games-in-Deterministic-Quasipolynomial-Time-October-5-2026/build/build/sections/introduction.tex"},"sha256":"sha256:cb6efa89b91ba0d3b1d6c487ee7d3e1368c4df0b2ddd1417de2abc1e33f98f9d","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Turn-Based-Stochastic-Mean-Payoff-Games-in-Deterministic-Quasipolynomial-Time-October-5-2026/build/build/sections/introduction.tex#L49"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere are a uniform deterministic Turing machine and an absolute constant\n$C$ such that, on every valid input described above, the machine outputs\nexactly $U$ in at most\n\\[\n                       2^{C(\\log_2(L+2))^2}\n\\]\nbit operations. The bound includes input reading, exact rational\narithmetic, and output. Vertices of value zero are included."}
