ction_title":"Introduction","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:65d672c9cc9dea57c0152b24a1794e8ee2d0a9b2e34627ffd6b41191d9660348","file":"preprints/Nonuniqueness-for-Bounded-Measurable-Scalar-Conductivities-in-Three-Dimensions-September-23-2026/build/paper.tex","line":79,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"d79e2d996d519cc0f2622777ca36b9f8337e9c4e2b033d4fbd58c3fd3cae2562","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Nonuniqueness-for-Bounded-Measurable-Scalar-Conductivities-in-Three-Dimensions-September-23-2026/build/paper.tex"},"sha256":"sha256:65d672c9cc9dea57c0152b24a1794e8ee2d0a9b2e34627ffd6b41191d9660348","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Nonuniqueness-for-Bounded-Measurable-Scalar-Conductivities-in-Three-Dimensions-September-23-2026/build/paper.tex#L79"},"statement_kind":"theorem","text":"\\label{thm:main}\nThere exist real scalar functions $\\gamma_0,\\gamma_1\\in\nL^\\infty(B(0,3);\\R)$ and constants $0<c<C<\\infty$ such that\n\\begin{enumerate}[label=\\textup{(\\roman*)},itemsep=2pt]\n\\item $c\\leq\\gamma_j\\leq C$ almost everywhere, for $j=0,1$;\n\\item both conductivities equal $1$ in a neighborhood of the boundary;\n\\item $\\abs{\\{x:\\gamma_0(x)\\ne\\gamma_1(x)\\}}>0$;\n\\item $\\Lambda_{\\gamma_0}=\\Lambda_{\\gamma_1}$ as bounded operators\nfrom $H^{1/2}(\\partial B(0,3))$ to $H^{-1/2}(\\partial B(0,3))$.\n\\end{enumerate}"}
