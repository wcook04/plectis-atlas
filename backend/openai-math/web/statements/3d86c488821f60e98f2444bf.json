t-body-comments-removed","current_statement_sha256":"sha256:39263d54fd9a94fdd3024ec68649928a6f05efacd473ebdcab80418db1c87fc9","file":"preprints/Symmetry-of-semialgebraic-bounded-domains-with-compact-quotient-September-24-2026/build/paper.tex","line":77,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"a09901a6f1f204abcca462d6203e8b79d07f7f400b0b13a20fee4f3481d653ab","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Symmetry-of-semialgebraic-bounded-domains-with-compact-quotient-September-24-2026/build/paper.tex"},"sha256":"sha256:39263d54fd9a94fdd3024ec68649928a6f05efacd473ebdcab80418db1c87fc9","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Symmetry-of-semialgebraic-bounded-domains-with-compact-quotient-September-24-2026/build/paper.tex#L77"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet \\(U\\) be a nonempty connected semialgebraic bounded open subset of a\ncomplex affine variety. Suppose that a group \\(\\Gamma\\) of\nbiholomorphisms acts properly discontinuously on \\(U\\) and that\n\\(U/\\Gamma\\) is compact. Then \\(U\\) is smooth and is biholomorphic to a\nbounded symmetric domain."}
