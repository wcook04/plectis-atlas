_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:8206acecb0977ac62ebc04598777acb5fd9882e2354bf95dbb05d59fb45ada71","file":"preprints/The-maximum-number-of-mutually-unbiased-bases-in-dimension-six-September-24-2026/build/sections/introduction.tex","line":13,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"5dcd228658603ae7775558cc85cf9d0f5be22f595ef2c319f11deb56408d4e13","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/The-maximum-number-of-mutually-unbiased-bases-in-dimension-six-September-24-2026/build/sections/introduction.tex"},"sha256":"sha256:8206acecb0977ac62ebc04598777acb5fd9882e2354bf95dbb05d59fb45ada71","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/The-maximum-number-of-mutually-unbiased-bases-in-dimension-six-September-24-2026/build/sections/introduction.tex#L13"},"statement_kind":"theorem","text":"\\label{thm:main}\nUnder the arithmetic and compiler conditions in\nAppendix~\\ref{sec:rounding}, the fresh complete execution documented in\nSection~\\ref{execute:observed} certifies that there are no four pairwise mutually unbiased orthonormal bases in\n$\\C^6$. Consequently, $N(6)=3$."}
