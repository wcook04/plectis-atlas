tatement_sha256":"sha256:07190f660c9b0956363984b7caa9713ce2e4a721fafd9a596718b0aead330033","file":"preprints/Expected-amenable-subalgebras-preserving-core-commutants-September-23-2026/build/paper.tex","line":82,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"a8fd996304ed1af131b2ef9340a6ca852f24d342b77b2e1e50b81ab529ef1cc0","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Expected-amenable-subalgebras-preserving-core-commutants-September-23-2026/build/paper.tex"},"sha256":"sha256:07190f660c9b0956363984b7caa9713ce2e4a721fafd9a596718b0aead330033","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Expected-amenable-subalgebras-preserving-core-commutants-September-23-2026/build/paper.tex#L82"},"statement_kind":"theorem","text":"\\label{thm:main}\nLet $N\\subset M$ be a unital inclusion of von Neumann algebras with separable\npreduals, and suppose that there is a faithful normal conditional expectation\n$E_N:M\\to N$. There exist a unital amenable von Neumann subalgebra $P\\subset N$\nand a faithful normal conditional expectation $F:N\\to P$ such that\n\\[\n P'\\cap c(M)=N'\\cap c(M).\n\\]\nHere amenable means injective."}
