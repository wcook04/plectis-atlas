:"sha256:82d4d1782093f882ffd4f8b3a338114427e808bc1e74186c4ccd221786988d8a","file":"preprints/A-power-saving-for-planar-halving-lines-September-25-2026/build/sections/introduction.tex","line":9,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"894c2b0cb2c7439157ede6978b7e530db715f340c41d16f8b8c7968c0f2d7930","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/A-power-saving-for-planar-halving-lines-September-25-2026/build/sections/introduction.tex"},"sha256":"sha256:82d4d1782093f882ffd4f8b3a338114427e808bc1e74186c4ccd221786988d8a","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/A-power-saving-for-planar-halving-lines-September-25-2026/build/sections/introduction.tex#L9"},"statement_kind":"theorem","text":"\\label{thm:halving-power}\nThere exist absolute constants $\\varepsilon>0$, $C<\\infty$, and $n_0$\nsuch that, for every even $n\\ge n_0$ and every $n$-point set\n$P\\subset\\mathbb R^2$ with no three collinear,\n\\[\n h(P)\\le C n^{4/3-\\varepsilon}.\n\\]"}
