ent_sha256":"sha256:06d0fd1bfaf816cd47003ab05b9185d9df5cfe98717710012c243c534157c1ec","file":"preprints/the-additive-indecomposability-of-the-primes-September-24-2026/build/sections/01-introduction.tex","line":15,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"6b17e13c1997d01b1163e12f37c883008196ff9037d835fce64a65b3107205bd","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/the-additive-indecomposability-of-the-primes-September-24-2026/build/sections/01-introduction.tex"},"sha256":"sha256:06d0fd1bfaf816cd47003ab05b9185d9df5cfe98717710012c243c534157c1ec","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/the-additive-indecomposability-of-the-primes-September-24-2026/build/sections/01-introduction.tex#L15"},"statement_kind":"theorem","text":"\\label{cor:ostmann}\nIf $A,B\\subseteq\\N_0$ satisfy $|A|,|B|\\ge2$, then\n$(A+B)\\mathbin{\\triangle}\\mathcal P$ is infinite.\nEquivalently, every finite modification of $\\mathcal P$ is additively\nindecomposable into two sets with at least two elements each."}
