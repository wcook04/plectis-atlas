","source":{"current_hash_method":"tex-environment-body-comments-removed","current_statement_sha256":"sha256:80c5895f536f3c08dddaf4b100c9f1cee5ab148dca056deb4246482ce902f666","file":"preprints/Tree-Constructions-for-the-l1-Distortion-of-Binary-Edit-Distance-September-27-2026/build/sections/introduction.tex","line":36,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"85e5faa89bc3931f4e8df14aed0d2c96e3640483e3d6d9fc2430938771c1bba8","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Tree-Constructions-for-the-l1-Distortion-of-Binary-Edit-Distance-September-27-2026/build/sections/introduction.tex"},"sha256":"sha256:80c5895f536f3c08dddaf4b100c9f1cee5ab148dca056deb4246482ce902f666","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Tree-Constructions-for-the-l1-Distortion-of-Binary-Edit-Distance-September-27-2026/build/sections/introduction.tex#L36"},"statement_kind":"theorem","text":"\\label{thm:binary}\nThere are an absolute constant $c>0$ and an integer $d_0$ such that,\nfor every integer $d\\geq d_0$, there exist an integer $1\\leq n\\leq d$ and a\nfinite set $\\mathcal W\\subseteq\\{0,1\\}^n$ with $|\\mathcal W|\\geq2$\nsatisfying\n\\[\n c_1(\\mathcal W,\\ED)\n \\geq \\exp\\!\\left(c\\sqrt{\\log d\\,\\log\\log d}\\right).\n\\]"}
