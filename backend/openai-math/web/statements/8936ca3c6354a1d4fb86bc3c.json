a256":"sha256:62b5d38fe050cf3ffc59fe8d83883ea465ff59b40847ceee1c6f0456e3c8a7ac","file":"preprints/P-equals-W-in-composite-rank-for-fixed-determinant-September-24-2026/build/sections/01-introduction.tex","line":39,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"6320b53f0e76b9720cb236a26dab7a5263e335a7b999b1067ef1e526c27ca2cd","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/P-equals-W-in-composite-rank-for-fixed-determinant-September-24-2026/build/sections/01-introduction.tex"},"sha256":"sha256:62b5d38fe050cf3ffc59fe8d83883ea465ff59b40847ceee1c6f0456e3c8a7ac","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/P-equals-W-in-composite-rank-for-fixed-determinant-September-24-2026/build/sections/01-introduction.tex#L39"},"statement_kind":"theorem","text":"\\label{thm:main}\nFor every smooth projective complex curve $C$ of genus $g\\ge2$, every composite integer $n\\ge4$, every integer $d$ with $\\gcd(n,d)=1$, and every $L\\in\\Pic^d(C)$, one has\n\\[\nP_kH^m(X^B,\\Q)=W_{2k}H^m(X^B,\\Q)\n=W_{2k+1}H^m(X^B,\\Q)\n\\]\nfor all $m,k\\ge0$."}
