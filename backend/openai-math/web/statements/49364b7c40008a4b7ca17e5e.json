environment-body-comments-removed","current_statement_sha256":"sha256:d7bcbb03ef8fd81bd785c0603d2d85bf5ca58e79372614e5ff80447925c4baa7","file":"preprints/Hellinger-contraction-with-arbitrary-Boolean-output-bias-September-24-2026/build/sections/conclusion.tex","line":25,"producer_hash_method":"atlas-whitespace-normalized-text","producer_statement_sha256":"925aa30ba562b48954f2151b445c273d4341b34fba76f5634dc77b7148b8ef1e","provenance":{"kind":"computed","pin":"fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb","source":"preprints/Hellinger-contraction-with-arbitrary-Boolean-output-bias-September-24-2026/build/sections/conclusion.tex"},"sha256":"sha256:d7bcbb03ef8fd81bd785c0603d2d85bf5ca58e79372614e5ff80447925c4baa7","url":"https://github.com/openai/math/blob/fd4aeeb2ee4fc729c18d98444fed42fd0529eeeb/preprints/Hellinger-contraction-with-arbitrary-Boolean-output-bias-September-24-2026/build/sections/conclusion.tex#L25"},"statement_kind":"corollary","text":"\\label{cor:ck}\nLet $X$ be uniform on $\\{-1,1\\}^n$, let $f$ be Boolean, and let\n$Y_i=X_iZ_i$, where the $Z_i$ are independent of $X$ and each other,\nwith $\\Pr(Z_i=-1)=\\varepsilon\\in[0,1/2]$. Then\n\\[\n I(f(X);Y)\\le1-h_2(\\varepsilon).\n\\]\nSigned coordinates attain equality."}
